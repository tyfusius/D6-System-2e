<article class="od6chat-roll d6-system-2e is-success">
  <header><img src="{{actor.img}}" alt="" /><div><span
      >{{actor.name}}</span><strong>{{localize
          "D6E2.Environment.RecoveryTitle"
        }}</strong></div><i class="fa-solid fa-sun" inert></i></header>
  <section class="od6chat-combat-audit is-environment">
    <span>{{methodLabel}}</span>
    <strong>{{effect.hazardLabel}} · {{effect.severityLabel}}</strong>
    <small>{{localize "D6E2.Environment.RestoredCondition"}}
      {{conditionLabel}}
      ·
      {{localize "D6E2.RulesReference"}}
      p.
      {{effect.sourcePage}}</small>
  </section>
</article>