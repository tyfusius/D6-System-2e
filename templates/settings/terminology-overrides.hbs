<div class="od6-dialog-shell d6e2-terminology-editor">
  <header>
    <p>{{localize "D6E2.Settings.Terminology.Help"}}</p>
    <small>{{localize "D6E2.Settings.Terminology.InheritHelp"}}</small>
  </header>
  {{#each groups as |group|}}
    <section
      class="d6e2-terminology-group"
      aria-labelledby="d6e2-terminology-{{group.id}}"
    >
      <h3 id="d6e2-terminology-{{group.id}}">{{group.label}}</h3>
      <div class="d6e2-terminology-grid">
        {{#each group.fields as |field|}}
          <label>
            <span>{{field.label}}</span>
            <input
              type="text"
              name="{{field.path}}"
              value="{{field.value}}"
              placeholder="{{field.placeholder}}"
              autocomplete="off"
            />
          </label>
        {{/each}}
      </div>
    </section>
  {{/each}}
</div>