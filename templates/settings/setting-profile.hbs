<section class="d6e2-setting-profile-shell">
  <header class="d6e2-setting-profile-hero">
    <div>
      <p class="od6v2-eyebrow">{{localize
          "D6E2.Settings.SettingProfile.Eyebrow"
        }}</p>
      <h1>{{localize "D6E2.Settings.SettingProfile.Heading"}}</h1>
      <p>{{localize "D6E2.Settings.SettingProfile.Help"}}</p>
    </div>
    <span class="d6e2-setting-profile-hero-logo" aria-hidden="true">
      <span
        class="d6e2-profile-logo-mark"
        data-brand="{{profileLogoBrand}}"
        data-branding="{{profileLogoBranding}}"
        style="--d6e2-profile-logo-image: url('{{profileLogo}}')"
      ></span>
    </span>
  </header>

  <nav
    class="d6e2-settings-tabs d6e2-setting-profile-tabs"
    role="tablist"
    aria-label="{{localize 'D6E2.Settings.SettingProfile.TabsLabel'}}"
  >
    <button
      type="button"
      id="d6e2-profile-tab-identity"
      class="is-active"
      role="tab"
      aria-controls="d6e2-profile-panel-identity"
      aria-selected="true"
      tabindex="0"
      data-profile-tab="identity"
    >
      <span class="d6e2-setting-profile-tab-icon"><i
          class="fa-solid fa-signature"
          aria-hidden="true"
        ></i></span>
      <span class="d6e2-setting-profile-tab-copy">
        <strong>{{localize "D6E2.Settings.SettingProfile.Identity"}}</strong>
        <small>{{tabMeta.identity}}</small>
      </span>
    </button>
    <button
      type="button"
      id="d6e2-profile-tab-attributes"
      role="tab"
      aria-controls="d6e2-profile-panel-attributes"
      aria-selected="false"
      tabindex="-1"
      data-profile-tab="attributes"
    >
      <span class="d6e2-setting-profile-tab-icon"><i
          class="fa-solid fa-chart-simple"
          aria-hidden="true"
        ></i></span>
      <span class="d6e2-setting-profile-tab-copy">
        <strong>{{localize "D6E2.Settings.SettingProfile.Attributes"}}</strong>
        <small>{{tabMeta.attributes}}</small>
      </span>
    </button>
    <button
      type="button"
      id="d6e2-profile-tab-skills"
      role="tab"
      aria-controls="d6e2-profile-panel-skills"
      aria-selected="false"
      tabindex="-1"
      data-profile-tab="skills"
    >
      <span class="d6e2-setting-profile-tab-icon"><i
          class="fa-solid fa-book-open"
          aria-hidden="true"
        ></i></span>
      <span class="d6e2-setting-profile-tab-copy">
        <strong>{{localize
            "D6E2.Settings.SettingProfile.SkillLibrary"
          }}</strong>
        <small>{{tabMeta.skills}}</small>
      </span>
    </button>
    <button
      type="button"
      id="d6e2-profile-tab-wild-die"
      role="tab"
      aria-controls="d6e2-profile-panel-wild-die"
      aria-selected="false"
      tabindex="-1"
      data-profile-tab="wild-die"
    >
      <span class="d6e2-setting-profile-tab-icon"><i
          class="fa-solid fa-dice"
          aria-hidden="true"
        ></i></span>
      <span class="d6e2-setting-profile-tab-copy">
        <strong>{{localize "D6E2.Settings.SettingProfile.WildDie"}}</strong>
        <small>{{tabMeta.wildDie}}</small>
      </span>
    </button>
    <button
      type="button"
      id="d6e2-profile-tab-terminology"
      role="tab"
      aria-controls="d6e2-profile-panel-terminology"
      aria-selected="false"
      tabindex="-1"
      data-profile-tab="terminology"
    >
      <span class="d6e2-setting-profile-tab-icon"><i
          class="fa-solid fa-language"
          aria-hidden="true"
        ></i></span>
      <span class="d6e2-setting-profile-tab-copy">
        <strong>{{localize "D6E2.Settings.SettingProfile.Terminology"}}</strong>
        <small>{{tabMeta.terminology}}</small>
      </span>
    </button>
  </nav>

  {{#if assetDiagnostics.length}}
    <section
      class="d6e2-setting-profile-diagnostics"
      role="alert"
      aria-live="polite"
    >
      <header>
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <div>
          <strong>{{localize
              "D6E2.Settings.SettingProfile.AssetValidationHeading"
            }}</strong>
          <small>{{localize
              "D6E2.Settings.SettingProfile.AssetValidationHelp"
            }}</small>
        </div>
      </header>
      <ul>
        {{#each assetDiagnostics}}
          <li>{{message}}</li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  <div
    id="d6e2-profile-panel-identity"
    class="d6e2-setting-profile-scroll d6e2-setting-profile-panel is-active"
    role="tabpanel"
    aria-labelledby="d6e2-profile-tab-identity"
    data-profile-panel="identity"
  >
    <section class="d6e2-settings-section">
      <header class="d6e2-setting-profile-section-heading">
        <div>
          <h2>{{localize "D6E2.Settings.SettingProfile.Identity"}}</h2>
          <p>{{localize "D6E2.Settings.SettingProfile.IdentityHelp"}}</p>
        </div>
      </header>
      <div class="d6e2-setting-profile-grid">
        <label>
          <span>{{localize "D6E2.Settings.SettingProfile.Name"}}</span>
          <input
            type="text"
            name="profile.label"
            value="{{profile.label}}"
            required
          />
        </label>
        <label>
          <span>{{localize "D6E2.Settings.SettingProfile.Description"}}</span>
          <input
            type="text"
            name="profile.description"
            value="{{profile.description}}"
          />
        </label>
        <label class="is-wide">
          <span>{{localize "D6E2.Settings.SettingProfile.Logo"}}</span>
          <span class="d6e2-setting-profile-file">
            <input type="text" name="profile.logo" value="{{profile.logo}}" />
            <button
              type="button"
              data-action="pickAsset"
              data-input-name="profile.logo"
              data-asset-type="image"
              aria-label="{{localize 'D6E2.Settings.SettingProfile.Browse'}}"
            >
              <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
            </button>
          </span>
        </label>
        <label class="is-wide d6e2-setting-profile-choice">
          <input
            type="checkbox"
            name="profile.logoAsWatermark"
            {{checked profile.logoAsWatermark}}
          />
          <span>
            <strong>{{localize
                "D6E2.Settings.SettingProfile.LogoAsWatermark"
              }}</strong>
            <small>{{localize
                "D6E2.Settings.SettingProfile.LogoAsWatermarkHelp"
              }}</small>
          </span>
        </label>
      </div>
      <fieldset class="d6e2-setting-profile-palette">
        <legend>{{localize
            "D6E2.Settings.SettingProfile.PaletteHeading"
          }}</legend>
        <header>
          <p>{{localize "D6E2.Settings.SettingProfile.PaletteHelp"}}</p>
          <span>{{localize
              "D6E2.Settings.SettingProfile.PaletteWorldDefault"
            }}</span>
        </header>
        <div
          class="{{paletteSummaryClass}}"
          role="alert"
          aria-live="polite"
          data-setting-palette-summary
        >
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
          <a href="#{{paletteError.target}}">{{paletteError.message}}</a>
        </div>
        <div class="d6e2-profile-palette-layout">
          <div class="d6e2-setting-profile-palette-groups">
            {{#each paletteGroups as |group|}}
              <section class="d6e2-color-group">
                <h4>{{group.label}}</h4>
                <p>{{group.help}}</p>
                <div>
                  {{#each group.fields as |field|}}
                    <div
                      class="d6e2-color-field"
                      data-color-field="{{field.id}}"
                    >
                      <span class="d6e2-color-field-copy">
                        <strong
                          id="d6e2-setting-profile-palette-{{field.id}}-label"
                        >{{field.label}}</strong>
                        <small
                          id="d6e2-setting-profile-palette-{{field.id}}-help"
                        >{{field.help}}</small>
                      </span>
                      <span
                        class="d6e2-color-field-controls"
                        role="group"
                        aria-labelledby="d6e2-setting-profile-palette-{{field.id}}-label"
                      >
                        <input
                          type="color"
                          value="{{field.pickerValue}}"
                          data-palette-field="{{field.id}}"
                          data-palette-source="picker"
                          aria-label="{{localize
                            'D6E2.Settings.SettingProfile.PaletteChoose'
                          }} {{field.label}}"
                          aria-describedby="d6e2-setting-profile-palette-{{field.id}}-help d6e2-setting-profile-palette-{{field.id}}-error"
                        />
                        <input
                          type="text"
                          id="d6e2-setting-profile-palette-{{field.id}}"
                          name="profile.palette.{{field.id}}"
                          value="{{field.value}}"
                          inputmode="text"
                          maxlength="7"
                          spellcheck="false"
                          autocomplete="off"
                          data-palette-field="{{field.id}}"
                          data-palette-source="hex"
                          aria-label="{{field.label}} {{localize
                            'D6E2.Settings.SettingProfile.PaletteHexInput'
                          }}"
                          aria-invalid="{{field.error}}"
                          aria-describedby="d6e2-setting-profile-palette-{{field.id}}-help d6e2-setting-profile-palette-{{field.id}}-error"
                        />
                      </span>
                      <small
                        id="d6e2-setting-profile-palette-{{field.id}}-error"
                        class="d6e2-setting-profile-palette-error"
                        aria-live="polite"
                      >{{field.errorMessage}}</small>
                    </div>
                  {{/each}}
                </div>
              </section>
            {{/each}}
            <section class="d6e2-setting-profile-typography">
              <header>
                <div><h4>{{localize
                      "D6E2.Settings.SettingProfile.Typography.Heading"
                    }}</h4><p>{{localize
                      "D6E2.Settings.SettingProfile.Typography.Help"
                    }}</p></div>
                <button type="button" data-action="addLocalFont"><i
                    class="fa-solid fa-font"
                    aria-hidden="true"
                  ></i>{{localize
                    "D6E2.Settings.SettingProfile.Typography.Manage"
                  }}</button>
              </header>
              <div class="d6e2-profile-typography-layout">
                {{#each typographyRoles as |role|}}
                  <label data-typography-role="{{role.id}}">
                    <span><strong>{{role.label}}</strong><small
                        id="d6e2-typography-{{role.id}}-help"
                      >{{role.help}}</small></span>
                    <select
                      name="profile.typography.{{role.id}}"
                      data-typography-role="{{role.id}}"
                      aria-describedby="d6e2-typography-{{role.id}}-help d6e2-typography-{{role.id}}-status"
                    >{{#if role.unavailableOption}}<option
                          value="{{role.unavailableOption.id}}"
                          selected
                        >{{role.unavailableOption.label}}</option>{{/if}}{{#each
                        role.groups
                        as |group|
                      }}<optgroup label="{{group.label}}">{{#each
                            group.options
                            as |option|
                          }}{{#if option.selected}}<option
                                value="{{option.id}}"
                                selected
                              >{{option.label}}</option>{{else}}<option
                                value="{{option.id}}"
                              >{{option.label}}</option>{{/if}}{{/each}}</optgroup>{{/each}}</select>
                    <small
                      id="d6e2-typography-{{role.id}}-status"
                    >{{role.status}}</small>
                  </label>
                {{/each}}
              </div>
              <p class="d6e2-typography-portability">{{localize
                  "D6E2.Settings.SettingProfile.Typography.PortabilityHelp"
                }}</p>
            </section>
          </div>
          <aside
            class="d6e2-profile-palette-preview"
            style="{{palettePreviewStyle}}; {{typographyPreviewStyle}}"
            data-setting-palette-preview
            data-setting-typography-preview
            aria-label="{{localize
              'D6E2.Settings.SettingProfile.PalettePreview'
            }}"
          >
            <span class="d6e2-profile-palette-preview-mark" aria-hidden="true">
              <span
                class="d6e2-profile-logo-mark"
                data-brand="{{profileLogoBrand}}"
                data-branding="{{profileLogoBranding}}"
                style="--d6e2-profile-logo-image: url('{{profileLogo}}')"
              ></span>
            </span>
            <small class="is-context">{{localize
                "D6E2.Settings.SettingProfile.PalettePreviewTitle"
              }}</small>
            <h4 class="d6e2-typography-preview-display">{{profile.label}}</h4>
            <p class="d6e2-typography-preview-body">{{localize
                "D6E2.Settings.SettingProfile.PalettePreviewBody"
              }}</p>
            <small class="d6e2-typography-preview-body">{{localize
                "D6E2.Settings.SettingProfile.PalettePreviewCopy"
              }}</small>
            <span class="d6e2-typography-preview-body">3D+2 · Difficulty 15</span>
            <span class="is-selected"><i
                class="fa-solid fa-check"
                aria-hidden="true"
              ></i>
              {{localize
                "D6E2.Settings.SettingProfile.PalettePreviewSelected"
              }}</span>
            <span class="is-focus">{{localize
                "D6E2.Settings.SettingProfile.PalettePreviewFocus"
              }}</span>
            <strong
              class="{{palettePassedClass}}"
              data-palette-validation-status="passed"
              aria-live="polite"
            ><i class="fa-solid fa-circle-check" aria-hidden="true"></i>
              {{localize
                "D6E2.Settings.SettingProfile.PaletteContrastPassed"
              }}</strong>
            <strong
              class="{{paletteAttentionClass}}"
              data-palette-validation-status="attention"
              aria-live="polite"
            ><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
              {{localize
                "D6E2.Settings.SettingProfile.PaletteContrastAttention"
              }}</strong>
            <small
              class="d6e2-typography-preview-body"
              data-setting-typography-status
              aria-live="polite"
            >{{localize
                "D6E2.Settings.SettingProfile.Typography.PreviewReady"
              }}</small>
          </aside>
        </div>
      </fieldset>
      <aside class="d6e2-setting-profile-technical">
        <div class="d6e2-setting-profile-technical-heading">
          <i class="fa-solid fa-code" aria-hidden="true"></i>
          <span>
            <strong>{{localize
                "D6E2.Settings.SettingProfile.TechnicalIdentity"
              }}</strong>
            <small>{{localize
                "D6E2.Settings.SettingProfile.TechnicalIdentityHelp"
              }}</small>
          </span>
        </div>
        <label>
          <span>{{localize "D6E2.Settings.SettingProfile.Id"}}</span>
          <input
            type="text"
            name="profile.id"
            value="{{profile.id}}"
            required
            pattern="[a-z][a-z0-9-]*"
          />
        </label>
        <small class="d6e2-setting-profile-directory-help">
          <span>{{localize "D6E2.Settings.SettingProfile.Directory"}}</span>
          <output
            data-setting-profile-directory
            title="{{settingDirectory}}"
          >{{settingDirectory}}</output>
        </small>
      </aside>
    </section>
  </div>

  <div
    id="d6e2-profile-panel-attributes"
    class="d6e2-setting-profile-scroll d6e2-setting-profile-panel"
    role="tabpanel"
    aria-labelledby="d6e2-profile-tab-attributes"
    data-profile-panel="attributes"
    hidden
  >
    <section class="d6e2-settings-section">
      <header class="d6e2-setting-profile-section-heading">
        <div>
          <h2>{{localize "D6E2.Settings.SettingProfile.Attributes"}}</h2>
          <p>{{localize "D6E2.Settings.SettingProfile.AttributesHelp"}}</p>
        </div>
      </header>
      <div class="d6e2-setting-profile-attributes">
        {{#each attributes as |attribute|}}
          <label data-active="{{attribute.activeFromRules}}">
            <code>{{attribute.id}}</code>
            <input
              type="text"
              name="attribute.{{attribute.index}}.label"
              value="{{attribute.label}}"
            />
            {{#if attribute.activeFromRules}}
              <small
                class="d6e2-setting-profile-rule-state is-active"
                aria-label="{{localize 'D6E2.Settings.Summary.Active'}}"
                title="{{localize 'D6E2.Settings.Summary.Active'}}"
              ><i
                  class="fa-solid fa-circle-check"
                  aria-hidden="true"
                ></i></small>
            {{else}}
              <small
                class="d6e2-setting-profile-rule-state"
                aria-label="{{localize 'D6E2.Settings.Summary.Inactive'}}"
                title="{{localize 'D6E2.Settings.Summary.Inactive'}}"
              ><i class="fa-regular fa-circle" aria-hidden="true"></i></small>
            {{/if}}
          </label>
        {{/each}}
      </div>
    </section>
  </div>

  <div
    id="d6e2-profile-panel-skills"
    class="d6e2-setting-profile-scroll d6e2-setting-profile-panel"
    role="tabpanel"
    aria-labelledby="d6e2-profile-tab-skills"
    data-profile-panel="skills"
    hidden
  >
    <section
      class="d6e2-settings-section d6e2-setting-profile-skills"
      data-skill-dropzone
    >
      <header class="d6e2-setting-profile-section-heading">
        <div>
          <h2>{{localize "D6E2.Settings.SettingProfile.SkillLibrary"}}</h2>
          <p>{{localize "D6E2.Settings.SettingProfile.SkillLibraryHelp"}}</p>
        </div>
        <button type="button" data-action="addSkill">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          {{localize "D6E2.Settings.SettingProfile.AddSkill"}}
        </button>
      </header>
      <p class="d6e2-setting-profile-drop-hint">
        <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
        {{localize "D6E2.Settings.SettingProfile.DropSkill"}}
      </p>
      <div class="d6e2-setting-profile-skill-list">
        {{#each skills as |skill|}}
          <article>
            <header class="d6e2-setting-profile-skill-card-heading">
              <span>
                <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
                {{localize
                  "D6E2.Settings.SettingProfile.SkillCard"
                  number=skill.displayIndex
                }}
              </span>
            </header>
            <img src="{{skill.img}}" alt="" />
            <label class="skill-name">
              <span>{{localize "D6E2.Settings.SettingProfile.SkillName"}}</span>
              <input
                type="text"
                name="skill.{{skill.index}}.name"
                value="{{skill.name}}"
                required
              />
            </label>
            <label class="skill-key">
              <span>{{localize "D6E2.Settings.SettingProfile.SkillKey"}}</span>
              <input
                type="text"
                name="skill.{{skill.index}}.key"
                value="{{skill.key}}"
                required
              />
            </label>
            <label class="skill-attribute">
              <span>{{localize
                  "D6E2.Settings.SettingProfile.SkillAttribute"
                }}</span>
              <select name="skill.{{skill.index}}.attributeId">
                {{#each skill.attributeChoices as |attribute|}}
                  {{#if attribute.selected}}
                    <option
                      value="{{attribute.id}}"
                      selected
                    >{{attribute.label}}</option>
                  {{else}}
                    <option
                      value="{{attribute.id}}"
                    >{{attribute.label}}</option>
                  {{/if}}
                {{/each}}
              </select>
            </label>
            <label class="skill-training">
              <span>{{localize "D6E2.Settings.SettingProfile.Training"}}</span>
              <select name="skill.{{skill.index}}.training">
                {{#if skill.standard}}<option
                    value="standard"
                    selected
                  >{{localize
                      "D6E2.Settings.SettingProfile.Standard"
                    }}</option>{{else}}<option value="standard">{{localize
                      "D6E2.Settings.SettingProfile.Standard"
                    }}</option>{{/if}}
                {{#if skill.advanced}}<option
                    value="advanced"
                    selected
                  >{{localize
                      "D6E2.Settings.SettingProfile.Advanced"
                    }}</option>{{else}}<option value="advanced">{{localize
                      "D6E2.Settings.SettingProfile.Advanced"
                    }}</option>{{/if}}
                {{#if skill.psionic}}<option value="psionic" selected>{{localize
                      "D6E2.Settings.SettingProfile.Psionic"
                    }}</option>{{else}}<option value="psionic">{{localize
                      "D6E2.Settings.SettingProfile.Psionic"
                    }}</option>{{/if}}
              </select>
            </label>
            <label class="skill-description">
              <span>{{localize
                  "D6E2.Settings.SettingProfile.SkillDescription"
                }}</span>
              <input
                type="text"
                name="skill.{{skill.index}}.description"
                value="{{skill.description}}"
              />
            </label>
            <label class="skill-icon">
              <span>{{localize "D6E2.Settings.SettingProfile.SkillIcon"}}</span>
              <input
                type="text"
                name="skill.{{skill.index}}.img"
                value="{{skill.img}}"
              />
            </label>
            <button
              type="button"
              class="is-danger"
              data-action="removeSkill"
              data-skill-index="{{skill.index}}"
              aria-label="{{localize
                'D6E2.Settings.SettingProfile.RemoveSkill'
              }}"
            >
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
          </article>
        {{else}}
          <p class="d6e2-setting-profile-empty">{{localize
              "D6E2.Settings.SettingProfile.NoSkills"
            }}</p>
        {{/each}}
      </div>
    </section>
  </div>

  <div
    id="d6e2-profile-panel-wild-die"
    class="d6e2-setting-profile-scroll d6e2-setting-profile-panel"
    role="tabpanel"
    aria-labelledby="d6e2-profile-tab-wild-die"
    data-profile-panel="wild-die"
    hidden
  >
    <section class="d6e2-settings-section">
      <header class="d6e2-setting-profile-section-heading">
        <div>
          <h2>{{localize "D6E2.Settings.SettingProfile.WildDie"}}</h2>
          <p>{{localize "D6E2.Settings.SettingProfile.WildDieHelp"}}</p>
        </div>
      </header>
      <div class="d6e2-setting-profile-wild-grid">
        {{#each wildFaces as |face|}}
          <fieldset class="d6e2-setting-profile-wild-face">
            <legend><span>{{face.dieValue}}</span>{{face.label}}</legend>
            <label>
              <span>{{localize "D6E2.Settings.SettingProfile.FaceType"}}</span>
              <select name="wildDie.{{face.id}}.kind">
                {{#if face.text}}<option value="text" selected>{{localize
                      "D6E2.Settings.SettingProfile.Text"
                    }}</option>{{else}}<option value="text">{{localize
                      "D6E2.Settings.SettingProfile.Text"
                    }}</option>{{/if}}
                {{#if face.image}}<option value="image" selected>{{localize
                      "D6E2.Settings.SettingProfile.Image"
                    }}</option>{{else}}<option value="image">{{localize
                      "D6E2.Settings.SettingProfile.Image"
                    }}</option>{{/if}}
              </select>
            </label>
            <label>
              <span>{{localize "D6E2.Settings.SettingProfile.FaceValue"}}</span>
              <input
                type="text"
                name="wildDie.{{face.id}}.value"
                value="{{face.value}}"
              />
            </label>
            <label>
              <span>{{localize "D6E2.Settings.SettingProfile.Sound"}}</span>
              <span class="d6e2-setting-profile-file">
                <input
                  type="text"
                  name="wildDie.{{face.id}}Sound"
                  value="{{face.sound}}"
                />
                <button
                  type="button"
                  data-action="pickAsset"
                  data-input-name="wildDie.{{face.id}}Sound"
                  data-asset-type="audio"
                  aria-label="{{localize
                    'D6E2.Settings.SettingProfile.Browse'
                  }}"
                ><i
                    class="fa-solid fa-folder-open"
                    aria-hidden="true"
                  ></i></button>
              </span>
            </label>
          </fieldset>
        {{/each}}
      </div>
    </section>
  </div>

  <div
    id="d6e2-profile-panel-terminology"
    class="d6e2-setting-profile-scroll d6e2-setting-profile-panel"
    role="tabpanel"
    aria-labelledby="d6e2-profile-tab-terminology"
    data-profile-panel="terminology"
    hidden
  >
    <section class="d6e2-settings-section">
      <header class="d6e2-setting-profile-section-heading">
        <div>
          <h2>{{localize "D6E2.Settings.SettingProfile.Terminology"}}</h2>
          <p>{{localize "D6E2.Settings.SettingProfile.TerminologyHelp"}}</p>
        </div>
      </header>
      <section class="d6e2-setting-health-labels">
        <h3>{{localize "D6E2.Settings.SettingProfile.HealthLabels"}}</h3>
        <p>{{localize "D6E2.Settings.SettingProfile.HealthLabelsHelp"}}</p>
        {{#each healthModels as |model|}}
          <fieldset
            data-health-model-id="{{model.id}}"
            class="{{model.cssClass}}"
          >
            <legend><span>{{model.label}}</span>
              <code>{{model.id}}</code>{{#if model.active}}
                ·
                {{localize
                  "D6E2.Settings.SettingProfile.ActiveHealthModel"
                }}{{/if}}</legend>
            {{#if model.unavailable}}
              <p class="d6e2-setting-requirement"><i
                  class="fa-solid fa-triangle-exclamation"
                  aria-hidden="true"
                ></i>{{localize
                  "D6E2.Settings.SettingProfile.UnavailableHealthModel"
                }}</p>
            {{/if}}
            <label><span>{{localize
                  "D6E2.Settings.SettingProfile.TrackLabel"
                }}</span>
              <input
                name="health.{{model.id}}.track"
                value="{{model.trackValue}}"
                placeholder="{{model.trackInherited}}"
              />
            </label>
            <div class="d6e2-setting-health-state-labels">
              {{#each model.states as |state|}}
                <label><span>{{state.inherited}}
                    <code>{{state.id}}</code></span>
                  <input
                    data-health-state-id="{{state.id}}"
                    name="health.{{model.id}}.state.{{state.id}}"
                    value="{{state.value}}"
                    placeholder="{{state.inherited}}"
                  />
                </label>
              {{/each}}
            </div>
          </fieldset>
        {{/each}}
      </section>
      {{#each terminologyGroups as |group|}}
        <section
          class="d6e2-terminology-group"
          data-terminology-group="{{group.id}}"
        >
          <h3>{{group.label}}</h3>
          <div class="d6e2-terminology-grid">
            {{#each group.fields as |field|}}
              <label data-terminology-path="{{field.path}}">
                <span>{{field.label}}</span>
                <input
                  type="text"
                  name="terminology.{{field.path}}"
                  value="{{field.value}}"
                  placeholder="{{field.inherited}}"
                />
              </label>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </section>
  </div>

  <footer>
    <button
      type="button"
      class="d6e2-settings-restore"
      data-action="restoreProfile"
    >
      <i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i>
      {{localize "D6E2.Settings.SettingProfile.Reset"}}
    </button>
    <button type="submit" class="od6roll-submit">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      {{localize "D6E2.Save"}}
    </button>
  </footer>
</section>