<section class="d6e2-settings-shell">
  <header class="d6e2-settings-hero">
    <p class="od6v2-eyebrow">{{localize "D6E2.Settings.RulesConfiguration"}}</p>
    <h1>{{title}}</h1>
  </header>

  <nav
    class="d6e2-settings-tabs"
    role="tablist"
    aria-label="{{localize 'D6E2.Settings.Tabs.Label'}}"
  >
    {{#each settingsTabs as |tab|}}
      <button
        type="button"
        id="d6e2-settings-tab-{{tab.id}}"
        class="{{tab.className}}"
        role="tab"
        aria-controls="d6e2-settings-panel-{{tab.id}}"
        aria-selected="{{tab.active}}"
        tabindex="{{tab.tabIndex}}"
        data-settings-tab="{{tab.id}}"
      >
        <i class="{{tab.icon}}" aria-hidden="true"></i>
        <span>{{tab.label}}</span>
      </button>
    {{/each}}
  </nav>

  <div
    id="d6e2-settings-panel-profile"
    class="d6e2-settings-panel is-active"
    role="tabpanel"
    aria-labelledby="d6e2-settings-tab-profile"
    data-settings-panel="profile"
  >
    <section class="d6e2-settings-section">
      <header>
        <h2>{{localize "D6E2.Settings.RulesProfile.Identity"}}</h2>
        <p>{{localize "D6E2.Settings.RulesProfile.IdentityHelp"}}</p>
      </header>
      <div class="d6e2-settings-fields d6e2-unified-rules-profile-fields">
        <label class="d6e2-settings-row">
          <span><strong>{{localize
                "D6E2.Settings.RulesProfile.Name"
              }}</strong></span>
          <input name="profile.label" value="{{rulesProfile.label}}" required />
        </label>
        <div class="d6e2-settings-row">
          <span><strong>{{localize
                "D6E2.Settings.RulesProfile.Id"
              }}</strong><small>{{localize
                "D6E2.Settings.RulesProfile.IdentityHelp"
              }}</small></span>
          <code>{{rulesProfile.id}}</code>
        </div>
        <label class="d6e2-settings-row is-textarea">
          <span><strong>{{localize
                "D6E2.Settings.RulesProfile.Description"
              }}</strong></span>
          <textarea
            name="profile.description"
            rows="4"
          >{{rulesProfile.description}}</textarea>
        </label>
      </div>
    </section>
  </div>

  <div
    id="d6e2-settings-panel-mechanics"
    class="d6e2-settings-panel"
    role="tabpanel"
    aria-labelledby="d6e2-settings-tab-mechanics"
    data-settings-panel="mechanics"
    hidden
  >
    <section class="d6e2-settings-section">
      <header>
        <h2>{{localize "D6E2.Settings.RulesProfile.Mechanics"}}</h2>
        <p>{{localize "D6E2.Settings.RulesProfile.MechanicsHelp"}}</p>
      </header>
      <div class="d6e2-settings-fields">
        {{#each rulesProfileMechanics as |mechanic|}}
          <label class="d6e2-settings-row d6e2-unified-rules-mechanic">
            <span><strong>{{mechanic.label}}</strong><small
              >{{mechanic.help}}</small></span>
            <span class="d6e2-unified-rules-mechanic-control">
              <select name="strategy.{{mechanic.slot}}">
                {{#each mechanic.options as |option|}}
                  {{#if option.selected}}<option
                      value="{{option.value}}"
                      selected
                    >{{option.label}}</option>{{else}}<option
                      value="{{option.value}}"
                    >{{option.label}}</option>{{/if}}
                {{/each}}
              </select>
              {{#if mechanic.health}}
                <button type="button" data-action="manageHealthModels">
                  <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
                  {{localize "D6E2.Settings.HealthModel.Manage"}}
                </button>
              {{/if}}
            </span>
          </label>
        {{/each}}
      </div>
    </section>
  </div>

  <div
    id="d6e2-settings-panel-difficulty"
    class="d6e2-settings-panel"
    role="tabpanel"
    aria-labelledby="d6e2-settings-tab-difficulty"
    data-settings-panel="difficulty"
    hidden
  >
    <section class="d6e2-settings-section">
      <header>
        <h2>{{localize "D6E2.Settings.RulesProfile.DifficultyScale"}}</h2>
        <p>{{localize "D6E2.Settings.RulesProfile.DifficultyScaleHelp"}}</p>
      </header>
      <ol class="d6e2-rules-profile-difficulty d6e2-unified-rules-difficulty">
        {{#each rulesProfileDifficulty as |entry|}}
          <li data-difficulty-id="{{entry.id}}">
            <code>{{entry.id}}</code>
            <label><span>{{localize
                  "D6E2.Settings.RulesProfile.DifficultyLabel"
                }}</span><input
                name="difficulty.{{entry.id}}.label"
                value="{{entry.label}}"
                required
              /></label>
            <label><span>{{localize
                  "D6E2.Settings.RulesProfile.DifficultyValue"
                }}</span><input
                name="difficulty.{{entry.id}}.value"
                type="number"
                inputmode="numeric"
                step="1"
                value="{{entry.value}}"
                required
              /></label>
          </li>
        {{/each}}
      </ol>
    </section>
  </div>

  <div
    id="d6e2-settings-panel-general"
    class="d6e2-settings-panel"
    role="tabpanel"
    aria-labelledby="d6e2-settings-tab-general"
    data-settings-panel="general"
  >

    {{#if settingsSummary.length}}
      <section
        class="d6e2-settings-section d6e2-settings-summary d6e2-settings-general-primary"
        aria-labelledby="d6e2-settings-summary-heading"
      >
        <header>
          <p class="od6v2-eyebrow">
            {{localize "D6E2.Settings.Summary.Eyebrow"}}
          </p>
          <h2 id="d6e2-settings-summary-heading">
            {{localize "D6E2.Settings.Summary.Heading"}}
          </h2>
          <p>{{localize "D6E2.Settings.Summary.Help"}}</p>
        </header>
        <div class="d6e2-settings-summary-grid">
          {{#each settingsSummary as |setting|}}
            <button
              type="button"
              class="{{setting.className}}"
              data-setting-summary-key="{{setting.key}}"
              aria-pressed="{{setting.active}}"
            >
              <i class="fa-solid fa-circle" aria-hidden="true"></i>
              <strong>{{setting.label}}</strong>
              <span>{{setting.stateLabel}}</span>
            </button>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if actionDeclarationAssistance}}
      <section
        class="d6e2-settings-section d6e2-settings-automation"
        aria-labelledby="d6e2-action-assistance-heading"
      >
        <header>
          <p class="od6v2-eyebrow">
            {{localize "D6E2.Settings.ActionAssistance.Eyebrow"}}
          </p>
          <h2 id="d6e2-action-assistance-heading">
            {{localize "D6E2.Settings.ActionAssistance.Heading"}}
          </h2>
          <p>{{localize "D6E2.Settings.ActionAssistance.Help"}}</p>
        </header>
        <div class="d6e2-settings-fields">
          <label
            class="d6e2-settings-row"
            for="d6e2-setting-{{actionDeclarationAssistance.key}}"
          >
            <span>
              <strong>{{actionDeclarationAssistance.label}}</strong>
              <small>{{actionDeclarationAssistance.hint}}</small>
            </span>
            <select
              id="d6e2-setting-{{actionDeclarationAssistance.key}}"
              name="{{actionDeclarationAssistance.key}}"
            >
              {{#each actionDeclarationAssistance.choices as |choice|}}
                {{#if choice.selected}}
                  <option
                    value="{{choice.value}}"
                    selected
                  >{{choice.label}}</option>
                {{else}}
                  <option value="{{choice.value}}">{{choice.label}}</option>
                {{/if}}
              {{/each}}
            </select>
          </label>
        </div>
      </section>
    {{/if}}

    {{#if contentSelection}}
      <section
        class="d6e2-settings-section d6e2-campaign-packages"
        aria-labelledby="d6e2-content-packages-heading"
      >
        <header>
          <p class="od6v2-eyebrow">{{localize
              "D6E2.Settings.ContentPackages.Eyebrow"
            }}</p>
          <h2 id="d6e2-content-packages-heading">{{localize
              "D6E2.Settings.ContentPackages.Heading"
            }}</h2>
          <p>{{localize "D6E2.Settings.ContentPackages.Help"}}</p>
        </header>
        <div class="d6e2-settings-fields">
          <div class="d6e2-settings-row">
            <span>
              <strong>{{localize
                  "D6E2.Settings.ContentPackages.PrimaryProfile"
                }}</strong>
              <small>{{localize
                  "D6E2.Settings.ContentPackages.PrimaryProfileHint"
                }}</small>
            </span>
            <output>{{contentSelection.primaryProfileLabel}}
              ·
              {{contentSelection.resolvedProfileLabel}}</output>
          </div>
          <div class="d6e2-settings-row">
            <span>
              <strong>{{localize
                  "D6E2.Settings.ContentPackages.ImportedMechanics"
                }}</strong>
              <small>{{localize
                  "D6E2.Settings.ContentPackages.ImportedMechanicsHint"
                }}</small>
            </span>
            <output>
              {{#if contentSelection.hasImportedMechanics}}
                {{#each
                  contentSelection.importedMechanicIds
                  as |id|
                }}{{id}}{{#unless @last}}, {{/unless}}{{/each}}
              {{else}}
                {{localize "D6E2.Settings.ContentPackages.NoneImported"}}
              {{/if}}
            </output>
          </div>
        </div>
        {{#if contentSelection.hasActivePackages}}
          <ul class="d6e2-package-list">
            {{#each contentSelection.activePackages as |package|}}
              <li><strong>{{package.label}}</strong><span
                >{{package.family}}</span></li>
            {{/each}}
          </ul>
          <p class="d6e2-package-status">{{localize
              "D6E2.Settings.ContentPackages.Ready"
            }}</p>
        {{else}}
          <div class="d6e2-package-diagnostics" role="status">
            <strong>{{localize
                "D6E2.Settings.ContentPackages.EmptyHeading"
              }}</strong>
            <p>{{localize "D6E2.Settings.ContentPackages.Empty"}}</p>
          </div>
        {{/if}}
      </section>
    {{/if}}

    {{#if isFirstEditionWorkspace}}
      <section
        class="d6e2-settings-section d6e2-campaign-packages"
        aria-labelledby="d6e2-campaign-packages-heading"
      >
        <header>
          <p class="od6v2-eyebrow">{{localize
              "D6E2.Settings.Packages.Eyebrow"
            }}</p>
          <h2 id="d6e2-campaign-packages-heading">{{localize
              "D6E2.Settings.Packages.Heading"
            }}</h2>
          <p>{{localize "D6E2.Settings.Packages.Help"}}</p>
        </header>
        <div class="d6e2-settings-fields">
          <label
            class="d6e2-settings-row"
            for="d6e2-setting-{{firstEditionPackages.genreKey}}"
          >
            <span>
              <strong>{{localize "D6E2.Settings.Packages.Genre"}}</strong>
              <small>{{localize "D6E2.Settings.Packages.GenreHint"}}</small>
            </span>
            <select
              id="d6e2-setting-{{firstEditionPackages.genreKey}}"
              name="{{firstEditionPackages.genreKey}}"
            >
              {{#each firstEditionPackages.genreChoices as |choice|}}
                {{#if choice.selected}}<option
                    value="{{choice.value}}"
                    selected
                  >{{choice.label}}</option>{{else}}<option
                    value="{{choice.value}}"
                  >{{choice.label}}</option>{{/if}}
              {{/each}}
            </select>
          </label>
          <label
            class="d6e2-settings-row"
            for="d6e2-setting-{{firstEditionPackages.companionKey}}"
          >
            <span>
              <strong>{{localize "D6E2.Settings.Packages.Companion"}}</strong>
              <small>{{localize "D6E2.Settings.Packages.CompanionHint"}}</small>
            </span>
            <select
              id="d6e2-setting-{{firstEditionPackages.companionKey}}"
              name="{{firstEditionPackages.companionKey}}"
            >
              {{#each firstEditionPackages.companionChoices as |choice|}}
                {{#if choice.selected}}<option
                    value="{{choice.value}}"
                    selected
                  >{{choice.label}}</option>{{else}}<option
                    value="{{choice.value}}"
                  >{{choice.label}}</option>{{/if}}
              {{/each}}
            </select>
          </label>
        </div>
        {{#if firstEditionPackages.diagnostics.length}}
          <div class="d6e2-package-diagnostics" role="status">
            <strong>{{localize "D6E2.Settings.Packages.Attention"}}</strong>
            <ul>{{#each firstEditionPackages.diagnostics as |diagnostic|}}<li
                >{{diagnostic.message}}</li>{{/each}}</ul>
          </div>
        {{else}}
          <p class="d6e2-package-status">
            {{#if firstEditionPackages.installedCount}}
              {{localize "D6E2.Settings.Packages.Ready"}}
            {{else}}
              {{localize "D6E2.Settings.Packages.Empty"}}
            {{/if}}
          </p>
        {{/if}}
      </section>
    {{/if}}

  </div>

  {{#if isFirstEditionWorkspace}}
    <div
      id="d6e2-settings-panel-rules"
      class="d6e2-settings-panel"
      role="tabpanel"
      aria-labelledby="d6e2-settings-tab-rules"
      data-settings-panel="rules"
      hidden
    >

      <section class="d6e2-settings-section">
        <header>
          <h2>{{localize "D6E2.Settings.EditionOptionsHeading"}}</h2>
          <p>{{localize "D6E2.Settings.EditionOptionsHelp"}}</p>
        </header>
        <div class="d6e2-settings-fields">
          {{#each editionOptions as |setting|}}
            <label class="d6e2-settings-row" for="d6e2-setting-{{setting.key}}">
              <span>
                <strong>{{setting.label}}</strong>
                <small>{{setting.hint}}</small>
              </span>
              {{#if setting.choices.length}}
                <select
                  id="d6e2-setting-{{setting.key}}"
                  name="{{setting.key}}"
                  {{disabled (not setting.available)}}
                  aria-describedby="d6e2-requirement-{{setting.key}}"
                >
                  {{#each setting.choices as |choice|}}
                    {{#if choice.selected}}
                      <option value="{{choice.value}}" selected>
                        {{choice.label}}
                      </option>
                    {{else}}
                      <option value="{{choice.value}}">{{choice.label}}</option>
                    {{/if}}
                  {{/each}}
                </select>
              {{else if (eq setting.inputType "checkbox")}}
                <input
                  id="d6e2-setting-{{setting.key}}"
                  type="checkbox"
                  name="{{setting.key}}"
                  data-dtype="Boolean"
                  {{disabled (not setting.available)}}
                  aria-describedby="d6e2-requirement-{{setting.key}}"
                  {{checked setting.checked}}
                />
              {{else if (eq setting.inputType "number")}}
                <input
                  id="d6e2-setting-{{setting.key}}"
                  type="number"
                  name="{{setting.key}}"
                  value="{{setting.value}}"
                  min="{{setting.min}}"
                  step="{{setting.step}}"
                  data-dtype="Number"
                  {{disabled (not setting.available)}}
                  aria-describedby="d6e2-requirement-{{setting.key}}"
                />
              {{else}}
                <input
                  id="d6e2-setting-{{setting.key}}"
                  type="{{setting.inputType}}"
                  name="{{setting.key}}"
                  value="{{setting.value}}"
                  {{disabled (not setting.available)}}
                  aria-describedby="d6e2-requirement-{{setting.key}}"
                />
              {{/if}}
            </label>
          {{/each}}
        </div>
      </section>
    </div>
  {{/if}}

  {{#if secondEditionGroups.length}}
    <div
      id="d6e2-settings-panel-modules"
      class="d6e2-settings-panel"
      role="tabpanel"
      aria-labelledby="d6e2-settings-tab-modules"
      data-settings-panel="modules"
      hidden
    >
      <section
        class="d6e2-settings-section d6e2-module-workspace"
        aria-labelledby="d6e2-module-workspace-heading"
      >
        <header>
          <p class="od6v2-eyebrow">
            {{localize "D6E2.Settings.SecondEdition.ModuleWorksheet.Eyebrow"}}
          </p>
          <h2 id="d6e2-module-workspace-heading">
            {{localize "D6E2.Settings.SecondEdition.ModuleWorksheet.Heading"}}
          </h2>
          <p>
            {{localize "D6E2.Settings.SecondEdition.ModuleWorksheet.Help"}}
          </p>
        </header>
        <div class="d6e2-module-groups">
          {{#each secondEditionGroups as |group|}}
            <article
              id="d6e2-module-{{group.id}}"
              class="d6e2-module-group {{group.className}}"
              data-module-id="{{group.id}}"
            >
              <header>
                <span class="d6e2-module-icon" aria-hidden="true">
                  <i class="{{group.icon}}"></i>
                </span>
                <div>
                  <p>
                    <span>{{group.kindLabel}}</span>
                    <b>{{group.pageReference}}</b>
                  </p>
                  <h3>{{group.label}}</h3>
                  <small>{{group.hint}}</small>
                </div>
              </header>
              <div class="d6e2-settings-fields">
                {{#each group.settings as |setting|}}
                  <label
                    class="d6e2-settings-row"
                    for="d6e2-setting-{{setting.key}}"
                  >
                    <span>
                      <strong>{{setting.label}}</strong>
                      <small>{{setting.hint}}</small>
                      {{#if setting.unavailableReason}}
                        <small
                          class="d6e2-setting-requirement"
                          id="d6e2-requirement-{{setting.key}}"
                        ><i
                            class="fa-solid fa-link"
                            aria-hidden="true"
                          ></i>{{setting.unavailableReason}}</small>
                      {{/if}}
                    </span>
                    {{#if setting.choices.length}}
                      <select
                        id="d6e2-setting-{{setting.key}}"
                        name="{{setting.key}}"
                        {{disabled (not setting.available)}}
                        aria-describedby="d6e2-requirement-{{setting.key}}"
                      >
                        {{#each setting.choices as |choice|}}
                          {{#if choice.selected}}
                            <option value="{{choice.value}}" selected>
                              {{choice.label}}
                            </option>
                          {{else}}
                            <option value="{{choice.value}}">
                              {{choice.label}}
                            </option>
                          {{/if}}
                        {{/each}}
                      </select>
                    {{else if (eq setting.inputType "checkbox")}}
                      <input
                        id="d6e2-setting-{{setting.key}}"
                        type="checkbox"
                        name="{{setting.key}}"
                        data-dtype="Boolean"
                        {{disabled (not setting.available)}}
                        aria-describedby="d6e2-requirement-{{setting.key}}"
                        {{checked setting.checked}}
                      />
                    {{else if (eq setting.inputType "number")}}
                      <input
                        id="d6e2-setting-{{setting.key}}"
                        type="number"
                        name="{{setting.key}}"
                        value="{{setting.value}}"
                        min="{{setting.min}}"
                        step="{{setting.step}}"
                        data-dtype="Number"
                        {{disabled (not setting.available)}}
                        aria-describedby="d6e2-requirement-{{setting.key}}"
                      />
                    {{else}}
                      <input
                        id="d6e2-setting-{{setting.key}}"
                        type="{{setting.inputType}}"
                        name="{{setting.key}}"
                        value="{{setting.value}}"
                        {{disabled (not setting.available)}}
                        aria-describedby="d6e2-requirement-{{setting.key}}"
                      />
                    {{/if}}
                  </label>
                {{/each}}
              </div>
            </article>
          {{/each}}
        </div>
        {{#if canRefreshHeroicSession}}
          <button
            type="button"
            class="od6roll-submit"
            data-action="refreshHeroicSession"
          >
            <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
            {{localize "D6E2.HeroPointSession.Action"}}
          </button>
        {{/if}}
      </section>
    </div>
  {{/if}}

  <div
    id="d6e2-settings-panel-reference"
    class="d6e2-settings-panel"
    role="tabpanel"
    aria-labelledby="d6e2-settings-tab-reference"
    data-settings-panel="reference"
    hidden
  >

    {{#if catalogGenres.length}}
      <section
        class="d6e2-settings-section d6e2-complete-module-catalog"
        aria-labelledby="d6e2-complete-module-catalog-heading"
      >
        <header>
          <p class="od6v2-eyebrow">
            {{localize "D6E2.Settings.SecondEdition.ModuleCatalog.Eyebrow"}}
          </p>
          <h2 id="d6e2-complete-module-catalog-heading">
            {{localize "D6E2.Settings.SecondEdition.ModuleCatalog.Heading"}}
          </h2>
          <p>
            {{localize "D6E2.Settings.SecondEdition.ModuleCatalog.Help"}}
          </p>
        </header>
        <div
          class="d6e2-module-catalog-legends"
          aria-label="{{localize
            'D6E2.Settings.SecondEdition.ModuleCatalog.Legend'
          }}"
        >
          <span class="is-configurable">
            {{localize
              "D6E2.Settings.SecondEdition.ModuleCatalog.State.configurable"
            }}
          </span>
          <span class="is-available">
            {{localize
              "D6E2.Settings.SecondEdition.ModuleCatalog.State.available"
            }}
          </span>
          <span class="is-partial">
            {{localize
              "D6E2.Settings.SecondEdition.ModuleCatalog.State.partial"
            }}
          </span>
          <span class="is-planned">
            {{localize
              "D6E2.Settings.SecondEdition.ModuleCatalog.State.planned"
            }}
          </span>
        </div>
        <div class="d6e2-module-catalog-genres">
          {{#each catalogGenres as |genre|}}
            <details class="d6e2-module-catalog-genre">
              <summary>
                <strong>{{genre.label}}</strong>
                <span>{{genre.entries.length}}</span>
              </summary>
              <div class="d6e2-module-catalog-grid">
                {{#each genre.entries as |entry|}}
                  <article
                    class="d6e2-module-catalog-entry is-{{entry.support}}"
                    data-module-catalog-id="{{entry.id}}"
                  >
                    <header>
                      <div>
                        <h3>{{entry.label}}</h3>
                        <small>{{entry.pageReference}}</small>
                      </div>
                      <b>{{entry.supportLabel}}</b>
                    </header>
                    <p>{{entry.hint}}</p>
                    {{#if entry.dependencyLabel}}
                      <small class="d6e2-module-relation">
                        <i class="fa-solid fa-link" aria-hidden="true"></i>
                        {{entry.dependencyLabel}}
                      </small>
                    {{/if}}
                    {{#if entry.familyLabel}}
                      <small class="d6e2-module-relation is-exclusive">
                        <i
                          class="fa-solid fa-code-compare"
                          aria-hidden="true"
                        ></i>
                        {{entry.familyLabel}}
                      </small>
                    {{/if}}
                    {{#if entry.settingGroupId}}
                      <button
                        type="button"
                        class="d6e2-module-configure-link"
                        data-action="scrollToModuleSettings"
                        data-setting-group-id="{{entry.settingGroupId}}"
                      >
                        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                        {{localize
                          "D6E2.Settings.SecondEdition.ModuleCatalog.Configure"
                        }}
                      </button>
                    {{/if}}
                  </article>
                {{/each}}
              </div>
            </details>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if campaignProfile}}
      <section
        class="d6e2-settings-section d6e2-campaign-profile"
        aria-labelledby="d6e2-campaign-profile-heading"
      >
        <header>
          <p class="od6v2-eyebrow">
            {{localize "D6E2.Settings.CampaignProfile.Eyebrow"}}
          </p>
          <h2 id="d6e2-campaign-profile-heading">
            {{campaignProfile.label}}
            <small>v{{campaignProfile.profileVersion}}</small>
          </h2>
          <p>{{localize "D6E2.Settings.CampaignProfile.Help"}}</p>
        </header>
        <div class="d6e2-campaign-budgets">
          <div>
            <span>{{localize "D6E2.Settings.CampaignProfile.Attributes"}}</span>
            <strong>{{campaignProfile.activeAttributeCount}}</strong>
            <small>
              {{localize "D6E2.Settings.CampaignProfile.CreationBudget"}}:
              {{campaignProfile.attributeBudgetLabel}}
            </small>
          </div>
          <div>
            <span>{{localize "D6E2.Settings.CampaignProfile.Skills"}}</span>
            <strong>{{campaignProfile.additionalSkillModuleCount}}</strong>
            <small>
              {{localize "D6E2.Settings.CampaignProfile.CreationBudget"}}:
              {{campaignProfile.skillBudgetLabel}}
            </small>
          </div>
        </div>
        <ul class="d6e2-campaign-modules">
          {{#each campaignProfile.moduleLabels as |label|}}
            <li>
              <i class="fa-solid fa-cube" aria-hidden="true"></i>
              {{label}}
            </li>
          {{/each}}
        </ul>
      </section>
    {{/if}}

    <section
      class="d6e2-settings-section d6e2-capability-profile"
      aria-labelledby="d6e2-capability-profile-heading"
    >
      <header>
        <p class="od6v2-eyebrow">
          {{localize "D6E2.Settings.Capabilities.Eyebrow"}}
        </p>
        <h2 id="d6e2-capability-profile-heading">
          {{localize "D6E2.Settings.Capabilities.Heading"}}
          <small>v{{capabilityProfile.profileVersion}}</small>
        </h2>
        <p>{{localize "D6E2.Settings.Capabilities.Help"}}</p>
      </header>
      <div class="d6e2-capability-grid">
        {{#each capabilityProfile.decisions as |decision|}}
          <article class="is-{{decision.state}}">
            <div>
              <strong>{{decision.label}}</strong>
              <small>{{decision.ownerLabel}}</small>
            </div>
            <span>{{decision.strategyLabel}}</span>
            <b>{{decision.stateLabel}}</b>
          </article>
        {{/each}}
      </div>
    </section>
  </div>

  {{#if hasHomebrewRules}}
    <div
      id="d6e2-settings-panel-homebrew"
      class="d6e2-settings-panel"
      role="tabpanel"
      aria-labelledby="d6e2-settings-tab-homebrew"
      data-settings-panel="homebrew"
      hidden
    >
      <section
        class="d6e2-settings-section d6e2-settings-homebrew"
        aria-labelledby="d6e2-settings-homebrew-heading"
      >
        <header>
          <p class="od6v2-eyebrow">
            {{localize "D6E2.Settings.TyfusiusHomebrew.Eyebrow"}}
          </p>
          <h2 id="d6e2-settings-homebrew-heading">
            {{localize "D6E2.Settings.TyfusiusHomebrew.Heading"}}
          </h2>
          <p>{{localize "D6E2.Settings.TyfusiusHomebrew.Help"}}</p>
        </header>
        <div class="d6e2-settings-homebrew-rules">
          <article class="d6e2-homebrew-rule">
            <label
              class="d6e2-settings-row"
              for="d6e2-profile-tyfusius-d8-explosive-deviation"
            >
              <span>
                <strong>{{profileD8ExplosiveDeviation.label}}</strong>
                <small>{{profileD8ExplosiveDeviation.hint}}</small>
              </span>
              <input
                id="d6e2-profile-tyfusius-d8-explosive-deviation"
                type="checkbox"
                name="profile.homebrew.tyfusiusD8ExplosiveDeviation"
                {{checked profileD8ExplosiveDeviation.checked}}
              />
            </label>
          </article>
          <article class="d6e2-homebrew-rule d6e2-wild-triumph-rule">
            <label
              class="d6e2-settings-row"
              for="d6e2-setting-{{wildTriumph.enabled.key}}"
            >
              <span>
                <strong>{{wildTriumph.enabled.label}}</strong>
                <small>{{wildTriumph.enabled.hint}}</small>
              </span>
              <input
                id="d6e2-setting-{{wildTriumph.enabled.key}}"
                type="checkbox"
                name="{{wildTriumph.enabled.key}}"
                data-dtype="Boolean"
                {{checked wildTriumph.enabled.checked}}
              />
            </label>
            <div class="d6e2-wild-triumph-controls">
              <label for="d6e2-setting-{{wildTriumph.threshold.key}}">
                <span>
                  <strong>{{wildTriumph.threshold.label}}</strong>
                  <small>{{wildTriumph.threshold.hint}}</small>
                </span>
                <input
                  id="d6e2-setting-{{wildTriumph.threshold.key}}"
                  type="number"
                  name="{{wildTriumph.threshold.key}}"
                  value="{{wildTriumph.threshold.value}}"
                  min="{{wildTriumph.threshold.min}}"
                  max="{{wildTriumph.threshold.max}}"
                  step="{{wildTriumph.threshold.step}}"
                />
              </label>
              <label for="d6e2-setting-{{wildTriumph.automaticSuccess.key}}">
                <span>
                  <strong>{{wildTriumph.automaticSuccess.label}}</strong>
                  <small>{{wildTriumph.automaticSuccess.hint}}</small>
                </span>
                <input
                  id="d6e2-setting-{{wildTriumph.automaticSuccess.key}}"
                  type="checkbox"
                  name="{{wildTriumph.automaticSuccess.key}}"
                  data-dtype="Boolean"
                  {{checked wildTriumph.automaticSuccess.checked}}
                />
              </label>
              <label for="d6e2-setting-{{wildTriumph.metaCurrencyAward.key}}">
                <span>
                  <strong>{{wildTriumph.metaCurrencyAward.label}}</strong>
                  <small>{{wildTriumph.metaCurrencyAward.hint}}</small>
                </span>
                <input
                  id="d6e2-setting-{{wildTriumph.metaCurrencyAward.key}}"
                  type="number"
                  name="{{wildTriumph.metaCurrencyAward.key}}"
                  value="{{wildTriumph.metaCurrencyAward.value}}"
                  min="{{wildTriumph.metaCurrencyAward.min}}"
                  step="{{wildTriumph.metaCurrencyAward.step}}"
                />
              </label>
              <label for="d6e2-setting-{{wildTriumph.characterPointAward.key}}">
                <span>
                  <strong>{{wildTriumph.characterPointAward.label}}</strong>
                  <small>{{wildTriumph.characterPointAward.hint}}</small>
                </span>
                <input
                  id="d6e2-setting-{{wildTriumph.characterPointAward.key}}"
                  type="number"
                  name="{{wildTriumph.characterPointAward.key}}"
                  value="{{wildTriumph.characterPointAward.value}}"
                  min="{{wildTriumph.characterPointAward.min}}"
                  step="{{wildTriumph.characterPointAward.step}}"
                />
              </label>
            </div>
            <div class="d6e2-homebrew-explanation">
              <h3>{{localize
                  "D6E2.Settings.TyfusiusHomebrew.WildTriumph.HowItWorks"
                }}</h3>
              <p>{{localize
                  "D6E2.Settings.TyfusiusHomebrew.WildTriumph.Explanation"
                }}</p>
              <p>{{localize
                  "D6E2.Settings.TyfusiusHomebrew.WildTriumph.Opposed"
                }}</p>
            </div>
          </article>
          {{#each homebrewFirstEditionSettings as |setting|}}
            <article class="d6e2-homebrew-rule">
              <label
                class="d6e2-settings-row"
                for="d6e2-setting-{{setting.key}}"
              >
                <span>
                  <strong>{{setting.label}}</strong>
                  <small>{{setting.hint}}</small>
                </span>
                <input
                  id="d6e2-setting-{{setting.key}}"
                  type="checkbox"
                  name="{{setting.key}}"
                  data-dtype="Boolean"
                  {{checked setting.checked}}
                />
              </label>
              <div class="d6e2-homebrew-explanation">
                {{#if setting.homebrewSegmentedActions}}
                  <h3>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.Segments.HowItWorks"
                    }}</h3>
                  <p>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.Segments.Explanation"
                    }}</p>
                  <h3>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.Segments.ExampleHeading"
                    }}</h3>
                  <p>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.Segments.Example"
                    }}</p>
                {{else}}
                  <h3>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.Grenades.HowItWorks"
                    }}</h3>
                  <p>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.Grenades.Explanation"
                    }}</p>
                  <h3>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.Grenades.ExampleHeading"
                    }}</h3>
                  <p>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.Grenades.Example"
                    }}</p>
                {{/if}}
              </div>
            </article>
          {{/each}}
          {{#each homebrewSecondEditionSettings as |setting|}}
            <article class="d6e2-homebrew-rule">
              <label
                class="d6e2-settings-row"
                for="d6e2-setting-{{setting.key}}"
              >
                <span>
                  <strong>{{setting.label}}</strong>
                  <small>{{setting.hint}}</small>
                </span>
                <input
                  id="d6e2-setting-{{setting.key}}"
                  type="checkbox"
                  name="{{setting.key}}"
                  data-dtype="Boolean"
                  {{checked setting.checked}}
                />
              </label>
              <div class="d6e2-homebrew-explanation">
                {{#if setting.homebrewCombinedActions}}
                  <h3>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.CombinedActions.HowItWorks"
                    }}</h3>
                  <p>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.CombinedActions.Explanation"
                    }}</p>
                  <h3>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.CombinedActions.ExampleHeading"
                    }}</h3>
                  <p>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.CombinedActions.Example"
                    }}</p>
                {{else}}
                  <h3>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.SecondEditionGrenades.HowItWorks"
                    }}</h3>
                  <p>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.SecondEditionGrenades.Explanation"
                    }}</p>
                  <h3>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.SecondEditionGrenades.ExampleHeading"
                    }}</h3>
                  <p>{{localize
                      "D6E2.Settings.TyfusiusHomebrew.SecondEditionGrenades.Example"
                    }}</p>
                {{/if}}
              </div>
            </article>
          {{/each}}
          <article
            class="d6e2-homebrew-rule d6e2-matching-rewards"
            data-matching-rewards
            data-reward-scope="{{rulesProfileRollResolution.rewards.scope}}"
          >
            <label class="d6e2-settings-row">
              <span>
                <strong>{{localize
                    "D6E2.Settings.RulesProfile.Rewards.DetectionHeading"
                  }}</strong>
                <small>{{localize
                    "D6E2.Settings.RulesProfile.Rewards.DetectionHelp"
                  }}</small>
              </span>
              <input
                type="checkbox"
                name="homebrew.matchingRewards.enabled"
                {{checked rulesProfileRollResolution.rewards.enabled}}
                {{disabled (not rulesProfileRollResolution.rewards.available)}}
              />
            </label>
            <div class="d6e2-settings-row d6e2-matching-review-row">
              <span>
                <strong>{{localize
                    "D6E2.Settings.RulesProfile.Rewards.RecognizedResults"
                  }}</strong>
                <small>{{localize
                    "D6E2.Settings.RulesProfile.Rewards.RecognizedResultsHelp"
                  }}</small>
              </span>
              <button type="button" data-action="reviewCombinations">{{localize
                  "D6E2.Settings.RulesProfile.Rewards.ReviewRecognized"
                }}</button>
            </div>
            {{#unless rulesProfileRollResolution.rewards.available}}
              <p class="d6e2-setting-requirement" role="status">{{localize
                  "D6E2.Settings.RulesProfile.Rewards.EvaluatorUnavailable"
                }}</p>
            {{/unless}}
            <div
              data-reward-configured
              class="d6e2-reward-configured
                {{rulesProfileRollResolution.rewards.configuredClass}}"
            >
              <p id="d6e2-matching-rewards-error" class="hint">{{localize
                  "D6E2.Settings.RulesProfile.Rewards.DynamicTerms"
                }}</p>
              <div class="d6e2-settings-homebrew-rules d6e2-reward-list">
                {{#each rulesProfileRollResolution.rewards.named as |reward|}}
                  <div
                    class="d6e2-homebrew-rule d6e2-reward-row"
                    data-matching-reward-row
                    data-pattern-id="{{reward.id}}"
                    data-pattern-label="{{reward.label}}"
                    data-source-label="{{reward.sourceLabel}}"
                    data-meta-label="{{@root.rulesProfileRollResolution.rewards.metaCurrencyLabel}}"
                    data-character-points-label="{{@root.rulesProfileRollResolution.rewards.characterPointsLabel}}"
                  >
                    <div class="d6e2-reward-identity"><strong
                      >{{reward.label}}</strong><small
                      >{{reward.sourceLabel}}</small></div>
                    <label class="d6e2-reward-enabled"><input
                        id="{{reward.inputId}}-enabled"
                        type="checkbox"
                        data-reward-enabled
                        {{checked reward.enabled}}
                      /><span>{{localize
                          "D6E2.Settings.RulesProfile.Rewards.AwardResult"
                        }}</span></label>
                    <label><span
                      >{{@root.rulesProfileRollResolution.rewards.metaCurrencyLabel}}
                        {{localize
                          "D6E2.Settings.RulesProfile.Rewards.Awarded"
                        }}</span><input
                        id="{{reward.inputId}}-meta"
                        type="number"
                        min="0"
                        max="{{@root.rulesProfileRollResolution.rewards.maximum}}"
                        step="1"
                        value="{{reward.metaCurrency}}"
                        aria-describedby="{{reward.inputId}}-error"
                        data-reward-meta
                      /></label>
                    <label><span
                      >{{@root.rulesProfileRollResolution.rewards.characterPointsLabel}}
                        {{localize
                          "D6E2.Settings.RulesProfile.Rewards.Awarded"
                        }}</span><input
                        id="{{reward.inputId}}-cp"
                        type="number"
                        min="0"
                        max="{{@root.rulesProfileRollResolution.rewards.maximum}}"
                        step="1"
                        value="{{reward.characterPoints}}"
                        aria-describedby="{{reward.inputId}}-error"
                        data-reward-cp
                      /></label>
                    <p
                      class="d6e2-reward-sentence"
                      data-reward-sentence
                    >{{reward.sentence}}</p>
                    <small
                      id="{{reward.inputId}}-error"
                      class="d6e2-reward-error"
                    >{{localize
                        "D6E2.Settings.RulesProfile.Rewards.RowError"
                        max=@root.rulesProfileRollResolution.rewards.maximum
                      }}</small>
                  </div>
                {{/each}}
              </div>
              {{#if rulesProfileRollResolution.rewards.fallback.length}}
                <details class="d6e2-reward-fallback">
                  <summary>{{localize
                      "D6E2.Settings.RulesProfile.Rewards.AdvancedFallback"
                    }}</summary>
                  <p class="hint">{{localize
                      "D6E2.Settings.RulesProfile.Rewards.FallbackWarning"
                    }}</p>
                  {{#each
                    rulesProfileRollResolution.rewards.fallback
                    as |reward|
                  }}
                    <div
                      class="d6e2-homebrew-rule d6e2-reward-row"
                      data-matching-reward-row
                      data-pattern-id="{{reward.id}}"
                      data-pattern-label="{{reward.label}}"
                      data-source-label="{{reward.sourceLabel}}"
                      data-meta-label="{{@root.rulesProfileRollResolution.rewards.metaCurrencyLabel}}"
                      data-character-points-label="{{@root.rulesProfileRollResolution.rewards.characterPointsLabel}}"
                    >
                      <div class="d6e2-reward-identity"><strong
                        >{{reward.label}}</strong><small
                        >{{reward.sourceLabel}}</small></div>
                      <label class="d6e2-reward-enabled"><input
                          id="{{reward.inputId}}-enabled"
                          type="checkbox"
                          data-reward-enabled
                          {{checked reward.enabled}}
                        /><span>{{localize
                            "D6E2.Settings.RulesProfile.Rewards.AwardResult"
                          }}</span></label>
                      <label><span
                        >{{@root.rulesProfileRollResolution.rewards.metaCurrencyLabel}}
                          {{localize
                            "D6E2.Settings.RulesProfile.Rewards.Awarded"
                          }}</span><input
                          id="{{reward.inputId}}-meta"
                          type="number"
                          min="0"
                          max="{{@root.rulesProfileRollResolution.rewards.maximum}}"
                          step="1"
                          value="{{reward.metaCurrency}}"
                          aria-describedby="{{reward.inputId}}-error"
                          data-reward-meta
                        /></label>
                      <label><span
                        >{{@root.rulesProfileRollResolution.rewards.characterPointsLabel}}
                          {{localize
                            "D6E2.Settings.RulesProfile.Rewards.Awarded"
                          }}</span><input
                          id="{{reward.inputId}}-cp"
                          type="number"
                          min="0"
                          max="{{@root.rulesProfileRollResolution.rewards.maximum}}"
                          step="1"
                          value="{{reward.characterPoints}}"
                          aria-describedby="{{reward.inputId}}-error"
                          data-reward-cp
                        /></label>
                      <p
                        class="d6e2-reward-sentence"
                        data-reward-sentence
                      >{{reward.sentence}}</p>
                      <small
                        id="{{reward.inputId}}-error"
                        class="d6e2-reward-error"
                      >{{localize
                          "D6E2.Settings.RulesProfile.Rewards.RowError"
                          max=@root.rulesProfileRollResolution.rewards.maximum
                        }}</small>
                    </div>
                  {{/each}}
                </details>
              {{/if}}
            </div>
          </article>
        </div>
      </section>
    </div>
  {{/if}}

  <footer class="d6e2-settings-footer">
    <button
      type="button"
      class="d6e2-settings-restore"
      data-action="restoreRecommendedDefaults"
    >
      <i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i>
      {{localize "D6E2.Settings.RecommendedDefaults.Action"}}
    </button>
    <button type="submit">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      {{localize "D6E2.Save"}}
    </button>
  </footer>
</section>