<div class="od6item-sheet">
  <section class="od6item-hero">
    <button
      class="od6item-image od6-artwork-frame"
      type="button"
      data-action="editImage"
      data-edit="img"
      title="{{localize 'D6E2.Item.EditImage'}}"
      aria-label="{{localize 'D6E2.Item.EditImage'}}"
      {{disabled (not imageEditable)}}
    >
      <img
        class="od6-artwork-echo"
        src="{{item.img}}"
        alt=""
        aria-hidden="true"
      />
      <img class="od6-artwork-primary" src="{{item.img}}" alt="{{typeLabel}}" />
      <span class="od6-artwork-reticle" aria-hidden="true"></span>
      <span class="od6-artwork-edit">
        <i class="fa-solid fa-camera" inert></i>
        {{localize "D6E2.Edit"}}
      </span>
    </button>
    <div class="od6item-identity">
      <p class="od6v2-eyebrow">{{localize "D6E2.Item.Sheet"}}</p>
      {{#if hasDedicatedNameField}}
        <strong class="od6item-name is-static">{{item.name}}</strong>
      {{else}}
        <input
          class="od6item-name"
          type="text"
          name="name"
          value="{{item.name}}"
          placeholder="{{typeLabel}}"
          {{disabled (not directEdit)}}
        />
      {{/if}}
      <div class="od6item-meta">
        <span>{{typeLabel}}</span>
        {{#if isSkill}}<span>{{scoreLabel}}</span>{{/if}}
        {{#if isSpecialization}}<span>{{scoreLabel}}</span>{{/if}}
        {{#if isWeapon}}<span>{{damageLabel}}</span>{{/if}}
        {{#if isArmor}}
          <span>{{physicalResistanceLabel}} / {{energyResistanceLabel}}</span>
        {{/if}}
      </div>
    </div>
    {{#if isRollable}}
      <button
        class="od6item-roll"
        type="button"
        data-action="roll"
        aria-label="{{localize 'D6E2.Roll.Action'}} {{item.name}}"
      >
        <i class="fa-solid fa-dice-d6" aria-hidden="true"></i>
        <span>{{scoreLabel}}</span>
        <small>{{localize "D6E2.Roll.Action"}}</small>
      </button>
    {{else}}
      <div class="od6item-roll is-static" aria-label="{{typeLabel}}">
        {{#if isWeapon}}
          <i class="fa-solid fa-burst" aria-hidden="true"></i>
          <span>{{damageLabel}}</span>
          <small>{{localize "D6E2.Item.Damage"}}</small>
        {{else if isArmor}}
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          <small>{{localize "D6E2.Item.Protection"}}</small>
        {{else}}
          <i class="fa-solid fa-cube" aria-hidden="true"></i>
          <small>{{typeLabel}}</small>
        {{/if}}
      </div>
    {{/if}}
  </section>

  <nav
    class="od6v2-tabs od6item-tabs"
    aria-label="{{localize 'D6E2.Item.Workspaces'}}"
  >
    <button
      type="button"
      class="{{itemTabs.details.cssClass}}"
      data-action="setItemTab"
      data-item-tab="details"
      role="tab"
      aria-selected="{{itemTabs.details.active}}"
      tabindex="{{itemTabs.details.tabIndex}}"
    >
      <i class="fa-solid fa-sliders" aria-hidden="true"></i>
      {{localize "D6E2.Item.Details"}}
    </button>
    <button
      type="button"
      class="{{itemTabs.description.cssClass}}"
      data-action="setItemTab"
      data-item-tab="description"
      role="tab"
      aria-selected="{{itemTabs.description.active}}"
      tabindex="{{itemTabs.description.tabIndex}}"
    >
      <i class="fa-solid fa-align-left" aria-hidden="true"></i>
      {{localize "D6E2.Item.Description"}}
    </button>
    <button
      type="button"
      class="{{itemTabs.effects.cssClass}}"
      data-action="setItemTab"
      data-item-tab="effects"
      role="tab"
      aria-selected="{{itemTabs.effects.active}}"
      tabindex="{{itemTabs.effects.tabIndex}}"
    >
      <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
      {{localize "D6E2.Item.Effects"}}
    </button>
  </nav>

  <section
    class="od6item-panel {{itemTabs.details.cssClass}}"
    data-item-tab-panel="details"
    aria-label="{{typeLabel}}"
  >
    <div class="od6item-section-heading">
      <p class="od6v2-eyebrow">{{localize "D6E2.CoreCapabilityMatrix"}}</p>
      <h2>{{typeLabel}}</h2>
    </div>

    <section class="od6item-section">
      <h3>{{localize "D6E2.Item.Identity"}}</h3>
      <div class="od6item-field-grid">
        {{#if hasDedicatedNameField}}
          <label class="od6item-field-wide">
            <span>{{itemNameLabel}}</span>
            <input
              type="text"
              name="name"
              value="{{item.name}}"
              maxlength="120"
              required
              placeholder="{{itemNameLabel}}"
              {{disabled (not directEdit)}}
            />
            {{#if isSpecialization}}
              <small>{{localize "D6E2.Item.SpecializationNameHelp"}}</small>
            {{else}}
              <small>{{localize "D6E2.Item.AdvancedSkillNameHelp"}}</small>
            {{/if}}
          </label>
        {{/if}}
        <label>
          <span>Stable key</span>
          <input
            type="text"
            name="system.key"
            value="{{item.system.key}}"
            pattern="[a-z][a-z0-9-]*"
            {{disabled (not directEdit)}}
          />
        </label>
        {{#if isSkill}}
          {{#unless
            (or
              (eq item.system.training "advanced")
              (eq item.system.training "psionic")
            )
          }}
            <label>
              <span>{{localize "D6E2.Item.GoverningAttribute"}}</span>
              <select name="system.attributeId" {{disabled (not directEdit)}}>
                {{selectOptions attributeOptions selected=selectedAttribute}}
              </select>
            </label>
          {{/unless}}
          <label>
            <span>{{localize "D6E2.Item.Training"}}</span>
            <select name="system.training" {{disabled (not directEdit)}}>
              {{selectOptions trainingOptions selected=item.system.training}}
            </select>
          </label>
          <label>
            <span>{{localize "D6E2.PipScore"}}</span>
            <input
              type="number"
              name="system.score"
              value="{{score}}"
              min="0"
              step="1"
              {{disabled (not scoreDirectEdit)}}
            />
          </label>
          {{#if (eq item.system.training "advanced")}}
            <fieldset class="od6item-field-wide od6-advanced-choice-fieldset">
              <legend>{{localize "D6E2.Item.ConnectedSkills"}}</legend>
              <input
                type="hidden"
                name="prerequisiteSkillKeysPresent"
                value="true"
              />
              <p>{{localize "D6E2.Item.ConnectedSkillsMinimum"}}</p>
              <div class="od6-advanced-choice-list">
                {{#each prerequisiteSkillChoices}}
                  <label class="od6-advanced-choice">
                    <input
                      type="checkbox"
                      name="prerequisiteSkillKeys"
                      value="{{key}}"
                      {{checked selected}}
                      {{disabled (not @root.directEdit)}}
                    />
                    <span>{{label}}</span>
                  </label>
                {{/each}}
              </div>
              <small>{{localize "D6E2.Item.AdvancedSkillHelp"}}</small>
            </fieldset>
          {{/if}}
          {{#unless isMachineWeapon}}
            <label>
              <span>{{localize
                  "D6E2.Combat.ActiveResponsive.AutofireRating"
                }}</span>
              <input
                type="number"
                name="system.autofireRating"
                value="{{item.system.autofireRating}}"
                min="0"
                step="1"
                {{disabled (not editable)}}
              />
            </label>
          {{/unless}}
          <label>
            <span>{{localize "D6E2.Source.Book"}}</span>
            <input
              type="text"
              name="system.source.book"
              value="{{item.system.source.book}}"
              {{disabled (not directEdit)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Source.Page"}}</span>
            <input
              type="number"
              name="system.source.page"
              value="{{item.system.source.page}}"
              min="0"
              step="1"
              {{disabled (not directEdit)}}
            />
          </label>
        {{/if}}
        {{#if isSpecialization}}
          <label>
            <span>{{localize "D6E2.Item.ParentSkill"}}</span>
            <select
              name="{{parentSkillFieldName}}"
              required
              {{disabled (not directEdit)}}
            >
              {{selectOptions
                parentSkillOptions
                selected=selectedParentSkill
                blank=(localize "D6E2.Item.ParentSkillRequired")
              }}
            </select>
          </label>
          <label>
            <span>{{localize "D6E2.PipScore"}}</span>
            <input
              type="number"
              name="system.score"
              value="{{score}}"
              min="0"
              step="1"
              {{disabled (not scoreDirectEdit)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Source.Book"}}</span>
            <input
              type="text"
              name="system.source.book"
              value="{{item.system.source.book}}"
              {{disabled (not directEdit)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Source.Page"}}</span>
            <input
              type="number"
              name="system.source.page"
              value="{{item.system.source.page}}"
              min="0"
              step="1"
              {{disabled (not directEdit)}}
            />
          </label>
        {{/if}}
      </div>
    </section>

    {{#if isCharacterTemplate}}
      <section class="od6item-section d6e2-character-template-editor">
        <div class="od6item-section-heading d6e2-template-editor-heading">
          <div>
            <p class="od6v2-eyebrow">{{localize
                "D6E2.Template.AuthoringEyebrow"
              }}</p>
            <h3>{{localize "D6E2.Template.AuthoringTitle"}}</h3>
          </div>
          {{#if directEdit}}
            <button
              type="button"
              data-action="useActiveCharacterTemplateProfile"
            >
              <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
              {{localize "D6E2.Template.UseActiveProfile"}}
            </button>
          {{/if}}
        </div>
        <p class="od6item-guidance">{{localize
            "D6E2.Template.AuthoringHelp"
          }}</p>

        <div class="od6item-field-grid d6e2-template-metadata">
          <label>
            <span>{{localize "D6E2.Drop.RulesFamilyLabel"}}</span>
            <select name="system.rulesFamily" {{disabled (not directEdit)}}>
              {{selectOptions
                characterTemplateRulesFamilyOptions
                selected=item.system.rulesFamily
              }}
            </select>
          </label>
          <label>
            <span>{{localize "D6E2.Source.Book"}}</span>
            <input
              type="text"
              name="system.source.book"
              value="{{item.system.source.book}}"
              {{disabled (not directEdit)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Source.Page"}}</span>
            <input
              type="number"
              name="system.source.page"
              value="{{item.system.source.page}}"
              min="1"
              step="1"
              {{disabled (not directEdit)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Template.UnassignedAttributes"}}</span>
            <input
              type="number"
              name="system.unassignedAttributeScore"
              value="{{item.system.unassignedAttributeScore}}"
              min="0"
              step="3"
              {{disabled (not directEdit)}}
            />
          </label>
        </div>

        {{#if isFirstEditionCharacterTemplate}}
          <div class="od6item-field-grid d6e2-template-first-edition">
            <label class="od6item-field-wide">
              <span>{{localize "D6E2.Biography"}}</span>
              <textarea
                name="system.firstEdition.biography"
                rows="4"
                {{disabled (not directEdit)}}
              >{{item.system.firstEdition.biography}}</textarea>
            </label>
            <label>
              <span>{{localize "D6E2.Template.Move"}}</span>
              <input
                type="number"
                name="system.firstEdition.move"
                value="{{item.system.firstEdition.move}}"
                min="0"
                {{disabled (not directEdit)}}
              />
            </label>
            <label>
              <span>{{localize "D6E2.Template.FatePoints"}}</span>
              <input
                type="number"
                name="system.firstEdition.fatePoints"
                value="{{item.system.firstEdition.fatePoints}}"
                min="0"
                {{disabled (not directEdit)}}
              />
            </label>
            <label>
              <span>{{localize "D6E2.Template.CharacterPoints"}}</span>
              <input
                type="number"
                name="system.firstEdition.characterPoints"
                value="{{item.system.firstEdition.characterPoints}}"
                min="0"
                {{disabled (not directEdit)}}
              />
            </label>
          </div>
        {{/if}}

        <div class="od6item-section-heading d6e2-template-subheading">
          <div>
            <h3>{{localize "D6E2.Template.Attributes"}}</h3>
            <small>{{localize "D6E2.Template.AttributesHelp"}}</small>
          </div>
          {{#if directEdit}}
            <button type="button" data-action="addCharacterTemplateAttribute">
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
              {{localize "D6E2.Item.Add"}}
            </button>
          {{/if}}
        </div>
        <div class="d6e2-template-attribute-editor">
          {{#each characterTemplateAttributes as |attribute|}}
            <div
              class="d6e2-template-attribute-row"
              data-template-attribute-index="{{attribute.index}}"
            >
              <label>
                <span>{{localize "D6E2.Template.Attribute"}}</span>
                <select
                  name="system.attributeScores.{{attribute.index}}.attributeId"
                  {{disabled (not @root.directEdit)}}
                >
                  {{selectOptions
                    @root.characterTemplateAttributeOptions
                    selected=attribute.attributeId
                  }}
                </select>
              </label>
              <label>
                <span>{{localize "D6E2.Template.Dice"}}</span>
                <input
                  type="number"
                  value="{{attribute.dice}}"
                  min="0"
                  max="20"
                  data-template-dice
                  {{disabled (not @root.directEdit)}}
                />
              </label>
              <label>
                <span>{{localize "D6E2.Template.Pips"}}</span>
                <input
                  type="number"
                  value="{{attribute.pips}}"
                  min="0"
                  max="2"
                  data-template-pips
                  {{disabled (not @root.directEdit)}}
                />
              </label>
              <strong
                class="d6e2-template-score"
              >{{attribute.scoreLabel}}</strong>
              {{#if @root.directEdit}}
                <button
                  class="od6v2-icon-button is-danger"
                  type="button"
                  data-action="removeCharacterTemplateAttribute"
                  aria-label="{{localize 'D6E2.Delete'}}"
                >
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>
          {{else}}
            <p class="d6e2-template-empty">{{localize
                "D6E2.Template.NoAttributes"
              }}</p>
          {{/each}}
        </div>

        <div class="od6item-section-heading d6e2-template-subheading">
          <div>
            <h3>{{localize "D6E2.Template.IncludedContent"}}</h3>
            <small>{{localize "D6E2.Template.IncludedContentHelp"}}</small>
          </div>
          <span
            class="d6e2-template-count"
          >{{characterTemplateItemCount}}</span>
        </div>
        {{#if directEdit}}
          <details class="d6e2-template-skill-library">
            <summary>
              <i class="fa-solid fa-list-check" aria-hidden="true"></i>
              {{localize "D6E2.Template.AddFromSettingProfile"}}
              <span>{{characterTemplateSettingSkills.length}}</span>
            </summary>
            <p>{{localize "D6E2.Template.AddFromSettingProfileHelp"}}</p>
            <div>
              {{#each characterTemplateSettingSkills as |skill|}}
                <button
                  type="button"
                  data-action="addCharacterTemplateSettingSkill"
                  data-skill-key="{{skill.key}}"
                  title="{{skill.description}}"
                >
                  <img src="{{skill.img}}" alt="" />
                  <span><strong>{{skill.name}}</strong><small
                    >{{skill.attributeLabel}}</small></span>
                  <i class="fa-solid fa-plus" aria-hidden="true"></i>
                </button>
              {{else}}
                <small>{{localize
                    "D6E2.Template.AllSettingSkillsIncluded"
                  }}</small>
              {{/each}}
            </div>
          </details>
        {{/if}}
        <div class="d6e2-template-dropzone">
          <i class="fa-solid fa-box-open" aria-hidden="true"></i>
          <strong>{{localize "D6E2.Template.DropItems"}}</strong>
          <small>{{localize "D6E2.Template.DropItemsHelp"}}</small>
        </div>
        <div class="d6e2-template-item-list">
          {{#each characterTemplateItems as |templateItem|}}
            <article
              class="d6e2-template-item-row"
              data-template-item-index="{{templateItem.index}}"
            >
              <img src="{{templateItem.img}}" alt="" />
              <div>
                <strong>{{templateItem.name}}</strong>
                <small>{{templateItem.typeLabel}}</small>
              </div>
              {{#if @root.directEdit}}
                <button
                  class="od6v2-icon-button is-danger"
                  type="button"
                  data-action="removeCharacterTemplateItem"
                  aria-label="{{localize 'D6E2.Delete'}}"
                >
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </article>
          {{else}}
            <p class="d6e2-template-empty">{{localize
                "D6E2.Template.NoIncludedContent"
              }}</p>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if isTemplateContainer}}
      <section class="od6item-section d6e2-template-container">
        <div class="od6item-section-heading">
          <p class="od6v2-eyebrow">{{localize "D6E2.Drop.TemplateContent"}}</p>
          <h3>
            {{#if isSpeciesTemplate}}
              {{localize "D6E2.Drop.SpeciesTemplate"}}
            {{else}}
              {{localize "D6E2.Drop.ItemGroup"}}
            {{/if}}
          </h3>
        </div>
        <p class="od6item-guidance">
          {{localize "D6E2.Drop.TemplateContentHelp"}}
        </p>
        <div class="od6item-field-grid">
          <label>
            <span>{{localize "D6E2.Drop.RulesFamilyLabel"}}</span>
            <select name="system.rulesFamily" {{disabled (not directEdit)}}>
              {{selectOptions
                rulesFamilyOptions
                selected=item.system.rulesFamily
              }}
            </select>
          </label>
        </div>

        {{#if isSpeciesTemplate}}
          <div class="od6item-section-heading">
            <h3>{{localize "D6E2.Drop.AttributeBounds"}}</h3>
            {{#if directEdit}}
              <button type="button" data-action="addSpeciesBound">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                {{localize "D6E2.Item.Add"}}
              </button>
            {{/if}}
          </div>
          {{#each item.system.attributeBounds as |bound|}}
            <div class="od6item-field-grid" data-bound-index="{{@index}}">
              <label>
                <span>{{localize "D6E2.Item.GoverningAttribute"}}</span>
                <select
                  name="system.attributeBounds.{{@index}}.attributeId"
                  {{disabled (not @root.directEdit)}}
                >
                  {{selectOptions
                    @root.attributeOptions
                    selected=bound.attributeId
                  }}
                </select>
              </label>
              <label>
                <span>{{localize "D6E2.Drop.Minimum"}}</span>
                <input
                  type="number"
                  min="0"
                  max="60"
                  name="system.attributeBounds.{{@index}}.minimum"
                  value="{{bound.minimum}}"
                  {{disabled (not @root.directEdit)}}
                />
              </label>
              <label>
                <span>{{localize "D6E2.Drop.Maximum"}}</span>
                <input
                  type="number"
                  min="0"
                  max="60"
                  name="system.attributeBounds.{{@index}}.maximum"
                  value="{{bound.maximum}}"
                  {{disabled (not @root.directEdit)}}
                />
              </label>
              {{#if @root.directEdit}}
                <button
                  class="od6v2-icon-button is-danger"
                  type="button"
                  data-action="removeSpeciesBound"
                  aria-label="{{localize 'D6E2.Delete'}}"
                >
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>
          {{/each}}
        {{/if}}

        <div class="od6item-section-heading">
          <h3>{{localize "D6E2.Drop.Members"}}</h3>
          {{#if directEdit}}
            <button type="button" data-action="addTemplateMember">
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
              {{localize "D6E2.Item.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each item.system.members as |member|}}
          <div class="od6item-field-grid" data-member-index="{{@index}}">
            <label>
              <span>{{localize "D6E2.Drop.MemberLabel"}}</span>
              <input
                type="text"
                name="system.members.{{@index}}.label"
                value="{{member.label}}"
                {{disabled (not @root.directEdit)}}
              />
            </label>
            <label class="od6item-field-wide">
              <span>{{localize "D6E2.Drop.MemberUuid"}}</span>
              <input
                type="text"
                name="system.members.{{@index}}.uuid"
                value="{{member.uuid}}"
                placeholder="Compendium.package.pack.Item.id"
                {{disabled (not @root.directEdit)}}
              />
            </label>
            <label class="od6v2-toggle">
              <input
                type="checkbox"
                name="system.members.{{@index}}.required"
                {{checked member.required}}
                {{disabled (not @root.directEdit)}}
              />
              <span>{{localize "D6E2.Drop.Required"}}</span>
            </label>
            {{#if @root.directEdit}}
              <button
                class="od6v2-icon-button is-danger"
                type="button"
                data-action="removeTemplateMember"
                aria-label="{{localize 'D6E2.Delete'}}"
              >
                <i class="fa-solid fa-trash" aria-hidden="true"></i>
              </button>
            {{/if}}
          </div>
        {{/each}}
      </section>
    {{/if}}

    {{#if isManifestation}}
      <section class="od6item-section d6e2-magic-design">
        {{#if magic.firstEdition}}
          <div class="od6item-section-heading">
            <p class="od6v2-eyebrow">{{localize
                "D6E2.Magic.FirstEdition.Eyebrow"
              }}</p>
            <h3>{{localize "D6E2.Magic.FirstEdition.Title"}}</h3>
          </div>
          <p class="od6item-guidance">{{localize
              "D6E2.Magic.FirstEdition.Help"
            }}</p>
          <div class="od6item-field-grid">
            <label><span>{{localize
                  "D6E2.Magic.FirstEdition.Tradition.Label"
                }}</span>
              <select
                name="system.firstEdition.tradition"
                {{disabled (not directEdit)}}
              >{{selectOptions
                  magic.traditionOptions
                  selected=item.system.firstEdition.tradition
                }}</select>
            </label>
            <label><span>{{localize
                  "D6E2.Magic.FirstEdition.Skill.Label"
                }}</span>
              <select
                name="system.firstEdition.skillKey"
                {{disabled (not directEdit)}}
              >{{selectOptions
                  magic.skillOptions
                  selected=item.system.firstEdition.skillKey
                }}</select>
            </label>
            <label><span>{{localize "D6E2.Roll.Difficulty"}}</span>
              <input
                type="number"
                name="system.firstEdition.difficulty"
                value="{{item.system.firstEdition.difficulty}}"
                min="2"
                step="1"
                {{disabled (not directEdit)}}
              />
            </label>
            <label><span>{{localize "D6E2.Source.Page"}}</span>
              <input
                type="number"
                name="system.firstEdition.sourcePage"
                value="{{item.system.firstEdition.sourcePage}}"
                min="0"
                step="1"
                {{disabled (not directEdit)}}
              />
            </label>
          </div>
          <p class="d6e2-source-reference"><i
              class="fa-solid fa-book-open"
              aria-hidden="true"
            ></i>
            {{localize "D6E2.RulesReference"}}:
            {{magic.rulesReference}}</p>
        {{else}}
          <div class="od6item-section-heading">
