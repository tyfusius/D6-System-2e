<div class="od6item-sheet">
  <section class="od6item-hero">
    <button
      class="od6item-image od6-artwork-frame"
      type="button"
      data-action="editImage"
      data-edit="img"
      title="{{localize 'D6E2.Item.EditImage'}}"
      aria-label="{{localize 'D6E2.Item.EditImage'}}"
      {{disabled (not imageEditable)}}
    >
      <img
        class="od6-artwork-echo"
        src="{{item.img}}"
        alt=""
        aria-hidden="true"
      />
      <img class="od6-artwork-primary" src="{{item.img}}" alt="{{typeLabel}}" />
      <span class="od6-artwork-reticle" aria-hidden="true"></span>
      <span class="od6-artwork-edit">
        <i class="fa-solid fa-camera" inert></i>
        {{localize "D6E2.Edit"}}
      </span>
    </button>
    <div class="od6item-identity">
      <p class="od6v2-eyebrow">{{localize "D6E2.Item.Sheet"}}</p>
      {{#if hasDedicatedNameField}}
        <strong class="od6item-name is-static">{{item.name}}</strong>
      {{else}}
        <input
          class="od6item-name"
          type="text"
          name="name"
          value="{{item.name}}"
          placeholder="{{typeLabel}}"
          {{disabled (not directEdit)}}
        />
      {{/if}}
      <div class="od6item-meta">
        <span>{{typeLabel}}</span>
        {{#if isSkill}}<span>{{scoreLabel}}</span>{{/if}}
        {{#if isSpecialization}}<span>{{scoreLabel}}</span>{{/if}}
        {{#if isWeapon}}<span>{{damageLabel}}</span>{{/if}}
        {{#if isArmor}}
          <span>{{physicalResistanceLabel}} / {{energyResistanceLabel}}</span>
        {{/if}}
      </div>
    </div>
    {{#if isRollable}}
      <button
        class="od6item-roll"
        type="button"
        data-action="roll"
        aria-label="{{localize 'D6E2.Roll.Action'}} {{item.name}}"
      >
        <i class="fa-solid fa-dice-d6" aria-hidden="true"></i>
        <span>{{scoreLabel}}</span>
        <small>{{localize "D6E2.Roll.Action"}}</small>
      </button>
    {{else}}
      <div class="od6item-roll is-static" aria-label="{{typeLabel}}">
        {{#if isWeapon}}
          <i class="fa-solid fa-burst" aria-hidden="true"></i>
          <span>{{damageLabel}}</span>
          <small>{{localize "D6E2.Item.Damage"}}</small>
        {{else if isArmor}}
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          <small>{{localize "D6E2.Item.Protection"}}</small>
        {{else}}
          <i class="fa-solid fa-cube" aria-hidden="true"></i>
          <small>{{typeLabel}}</small>
        {{/if}}
      </div>
    {{/if}}
  </section>

  <nav
    class="od6v2-tabs od6item-tabs"
    aria-label="{{localize 'D6E2.Item.Workspaces'}}"
  >
    <button
      type="button"
      class="{{itemTabs.details.cssClass}}"
      data-action="setItemTab"
      data-item-tab="details"
      role="tab"
      aria-selected="{{itemTabs.details.active}}"
      tabindex="{{itemTabs.details.tabIndex}}"
    >
      <i class="fa-solid fa-sliders" aria-hidden="true"></i>
      {{localize "D6E2.Item.Details"}}
    </button>
    <button
      type="button"
      class="{{itemTabs.description.cssClass}}"
      data-action="setItemTab"
      data-item-tab="description"
      role="tab"
      aria-selected="{{itemTabs.description.active}}"
      tabindex="{{itemTabs.description.tabIndex}}"
    >
      <i class="fa-solid fa-align-left" aria-hidden="true"></i>
      {{localize "D6E2.Item.Description"}}
    </button>
    <button
      type="button"
      class="{{itemTabs.effects.cssClass}}"
      data-action="setItemTab"
      data-item-tab="effects"
      role="tab"
      aria-selected="{{itemTabs.effects.active}}"
      tabindex="{{itemTabs.effects.tabIndex}}"
    >
      <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
      {{localize "D6E2.Item.Effects"}}
    </button>
  </nav>

  <section
    class="od6item-panel {{itemTabs.details.cssClass}}"
    data-item-tab-panel="details"
    aria-label="{{typeLabel}}"
  >
    <div class="od6item-section-heading">
      <p class="od6v2-eyebrow">{{localize "D6E2.CoreCapabilityMatrix"}}</p>
      <h2>{{typeLabel}}</h2>
    </div>

    <section class="od6item-section">
      <h3>{{localize "D6E2.Item.Identity"}}</h3>
      <div class="od6item-field-grid">
        {{#if hasDedicatedNameField}}
          <label class="od6item-field-wide">
            <span>{{itemNameLabel}}</span>
            <input
              type="text"
              name="name"
              value="{{item.name}}"
              maxlength="120"
              required
              placeholder="{{itemNameLabel}}"
              {{disabled (not directEdit)}}
            />
            {{#if isSpecialization}}
              <small>{{localize "D6E2.Item.SpecializationNameHelp"}}</small>
            {{else}}
              <small>{{localize "D6E2.Item.AdvancedSkillNameHelp"}}</small>
            {{/if}}
          </label>
        {{/if}}
        <label>
          <span>Stable key</span>
          <input
            type="text"
            name="system.key"
            value="{{item.system.key}}"
            pattern="[a-z][a-z0-9-]*"
            {{disabled (not directEdit)}}
          />
        </label>
        {{#if isSkill}}
          {{#unless (eq item.system.training "advanced")}}
            <label>
              <span>{{localize "D6E2.Item.GoverningAttribute"}}</span>
              <select name="system.attributeId" {{disabled (not directEdit)}}>
                {{selectOptions attributeOptions selected=selectedAttribute}}
              </select>
            </label>
          {{/unless}}
          <label>
            <span>{{localize "D6E2.Item.Training"}}</span>
            <select name="system.training" {{disabled (not directEdit)}}>
              {{selectOptions trainingOptions selected=item.system.training}}
            </select>
          </label>
          <label>
            <span>{{localize "D6E2.PipScore"}}</span>
            <input
              type="number"
              name="system.score"
              value="{{score}}"
              min="0"
              step="1"
              {{disabled (not scoreDirectEdit)}}
            />
          </label>
          {{#if (eq item.system.training "advanced")}}
            <fieldset class="od6item-field-wide od6-advanced-choice-fieldset">
              <legend>{{localize "D6E2.Item.ConnectedSkills"}}</legend>
              <input
                type="hidden"
                name="prerequisiteSkillKeysPresent"
                value="true"
              />
              <p>{{localize "D6E2.Item.ConnectedSkillsMinimum"}}</p>
              <div class="od6-advanced-choice-list">
                {{#each prerequisiteSkillChoices}}
                  <label class="od6-advanced-choice">
                    <input
                      type="checkbox"
                      name="prerequisiteSkillKeys"
                      value="{{key}}"
                      {{checked selected}}
                      {{disabled (not @root.directEdit)}}
                    />
                    <span>{{label}}</span>
                  </label>
                {{/each}}
              </div>
              <small>{{localize "D6E2.Item.AdvancedSkillHelp"}}</small>
            </fieldset>
          {{/if}}
          <label>
            <span>{{localize "D6E2.Source.Book"}}</span>
            <input
              type="text"
              name="system.source.book"
              value="{{item.system.source.book}}"
              {{disabled (not directEdit)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Source.Page"}}</span>
            <input
              type="number"
              name="system.source.page"
              value="{{item.system.source.page}}"
              min="0"
              step="1"
              {{disabled (not directEdit)}}
            />
          </label>
        {{/if}}
        {{#if isSpecialization}}
          <label>
            <span>{{localize "D6E2.Item.ParentSkill"}}</span>
            <select name="system.parentSkillId" {{disabled (not directEdit)}}>
              {{selectOptions
                parentSkillOptions
                selected=item.system.parentSkillId
              }}
            </select>
          </label>
          <label>
            <span>{{localize "D6E2.PipScore"}}</span>
            <input
              type="number"
              name="system.score"
              value="{{score}}"
              min="0"
              step="1"
              {{disabled (not scoreDirectEdit)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Source.Book"}}</span>
            <input
              type="text"
              name="system.source.book"
              value="{{item.system.source.book}}"
              {{disabled (not directEdit)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Source.Page"}}</span>
            <input
              type="number"
              name="system.source.page"
              value="{{item.system.source.page}}"
              min="0"
              step="1"
              {{disabled (not directEdit)}}
            />
          </label>
        {{/if}}
      </div>
    </section>

    {{#if isEquipment}}
      <section class="od6item-section">
        <h3>{{localize "D6E2.Item.Equipment"}}</h3>
        <div class="d6e2-equipment-era-summary {{equipmentEraSummaryClass}}">
          <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
          <div>
            <strong>{{localize "D6E2.Equipment.Era.Campaign"}}:
              {{campaignEquipmentEraLabel}}</strong>
            {{#if equipmentEraMismatch}}
              <small>{{localize "D6E2.Equipment.Era.Mismatch"}}</small>
            {{else}}
              <small>{{localize "D6E2.Equipment.Era.Guidance"}}</small>
            {{/if}}
          </div>
        </div>
        <div class="od6item-field-grid">
          <label>
            <span>{{localize "D6E2.Equipment.Era.Item"}}</span>
            <select
              name="system.equipmentProvenance.era"
              {{disabled (not provenanceEditable)}}
            >
              {{selectOptions equipmentEraOptions selected=itemEquipmentEra}}
            </select>
          </label>
          <label class="od6item-check">
            <input
              type="checkbox"
              name="system.equipped"
              {{checked item.system.equipped}}
              {{disabled (not editable)}}
            />
            <span>{{localize "D6E2.Item.Equipped"}}</span>
          </label>
          <label>
            <span>{{localize "D6E2.Item.Context"}}</span>
            <select name="system.context" {{disabled (not editable)}}>
              {{selectOptions contextOptions selected=item.system.context}}
            </select>
          </label>
          <label>
            <span>{{localize "D6E2.Item.Quantity"}}</span>
            <input
              type="number"
              name="system.quantity"
              value="{{item.system.quantity}}"
              min="0"
              step="1"
              {{disabled (not editable)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Item.Mass"}}</span>
            <input
              type="number"
              name="system.mass"
              value="{{item.system.mass}}"
              min="0"
              step="any"
              {{disabled (not editable)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Item.Value"}}</span>
            <input
              type="number"
              name="system.value"
              value="{{item.system.value}}"
              min="0"
              step="any"
              {{disabled (not editable)}}
            />
          </label>
        </div>
        {{#if item.system.equipmentProvenance.catalogId}}
          <p class="d6e2-source-reference">
            <i class="fa-solid fa-box-archive" aria-hidden="true"></i>
            {{localize "D6E2.Equipment.Catalog.Provenance"}}:
            {{item.system.equipmentProvenance.ownerId}}
            /
            {{item.system.equipmentProvenance.catalogId}}@{{item.system.equipmentProvenance.catalogVersion}}
            /
            {{item.system.equipmentProvenance.entryId}}
            {{#if item.system.equipmentProvenance.sourceBook}}
              ·
              {{item.system.equipmentProvenance.sourceBook}}{{#if
                item.system.equipmentProvenance.sourcePage
              }},
                {{localize "D6E2.Source.PageShort"}}
                {{item.system.equipmentProvenance.sourcePage}}{{/if}}
            {{/if}}
          </p>
        {{else}}
          <p class="od6item-guidance">{{localize
              "D6E2.Equipment.Catalog.Manual"
            }}</p>
        {{/if}}
      </section>
    {{/if}}

    {{#if isWeapon}}
      <section class="od6item-section">
        <h3>{{localize "D6E2.Item.WeaponProfile"}}</h3>
        <div class="od6item-field-grid">
          {{#if isMachineWeapon}}
            <label>
              <span>{{localize "D6E2.Machine.AttackBonus"}}</span>
              <input
                type="number"
                name="system.attackBonus"
                value="{{item.system.attackBonus}}"
                min="0"
                step="1"
                {{disabled (not editable)}}
              />
            </label>
          {{else}}
            <label>
              <span>{{localize "D6E2.Item.AttackSkillKey"}}</span>
              <input
                type="text"
                name="system.attackSkillKey"
                value="{{item.system.attackSkillKey}}"
                {{disabled (not editable)}}
              />
            </label>
          {{/if}}
          <label>
            <span>{{localize "D6E2.Item.DamagePips"}}</span>
            <input
              type="number"
              name="system.damage"
              value="{{item.system.damage}}"
              min="0"
              step="1"
              {{disabled (not editable)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Item.DamageType"}}</span>
            <input
              type="text"
              name="system.damageType"
              value="{{item.system.damageType}}"
              list="d6e2-damage-types"
              {{disabled (not editable)}}
            />
            <datalist id="d6e2-damage-types">
              <option value="Physical"></option>
              <option value="Energy"></option>
              <option value="Stun"></option>
            </datalist>
          </label>
          <label>
            <span>{{localize "D6E2.Item.Scale"}}</span>
            <input
              type="number"
              name="system.scale"
              value="{{item.system.scale}}"
              step="1"
              {{disabled (not editable)}}
            />
          </label>
        </div>
        <div class="od6item-range-grid">
          <label><span>{{localize "D6E2.Item.RangeShort"}}</span>
            <input
              type="number"
              name="system.range.short"
              value="{{item.system.range.short}}"
              min="0"
              {{disabled (not editable)}}
            /></label>
          <label><span>{{localize "D6E2.Item.RangeMedium"}}</span>
            <input
              type="number"
              name="system.range.medium"
              value="{{item.system.range.medium}}"
              min="0"
              {{disabled (not editable)}}
            /></label>
          <label><span>{{localize "D6E2.Item.RangeLong"}}</span>
            <input
              type="number"
              name="system.range.long"
              value="{{item.system.range.long}}"
              min="0"
              {{disabled (not editable)}}
            /></label>
        </div>
      </section>
    {{/if}}

    {{#if isArmor}}
      <section class="od6item-section">
        <h3>{{localize "D6E2.Item.Protection"}}</h3>
        <div class="od6item-field-grid">
          <label>
            <span>{{localize "D6E2.Item.PhysicalResistancePips"}}</span>
            <input
              type="number"
              name="system.physicalResistance"
              value="{{item.system.physicalResistance}}"
              min="0"
              step="1"
              {{disabled (not editable)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Item.EnergyResistancePips"}}</span>
            <input
              type="number"
              name="system.energyResistance"
              value="{{item.system.energyResistance}}"
              min="0"
              step="1"
              {{disabled (not editable)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Item.Coverage"}}</span>
            <input
              type="text"
              name="system.coverage"
              value="{{item.system.coverage}}"
              {{disabled (not editable)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Item.StackingTag"}}</span>
            <select name="system.stackingTag" {{disabled (not editable)}}>
              {{selectOptions
                armorStackingOptions
                selected=item.system.stackingTag
              }}
            </select>
            <small>{{localize "D6E2.Item.StackingTagHelp"}}</small>
          </label>
        </div>
      </section>
    {{/if}}

    {{#if isTrait}}
      <section class="od6item-section">
        <h3>{{localize "D6E2.Item.TraitProfile"}}</h3>
        <div class="od6item-field-grid">
          <label>
            <span>{{localize "D6E2.Item.Rank"}}</span>
            <input
              type="number"
              name="system.rank"
              value="{{item.system.rank}}"
              min="0"
              step="1"
              {{disabled (not editable)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Item.Cost"}}</span>
            <input
              type="number"
              name="system.cost"
              value="{{item.system.cost}}"
              min="0"
              step="any"
              {{disabled (not editable)}}
            />
          </label>
          <label>
            <span>{{localize "D6E2.Item.Frequency"}}</span>
            <select name="system.frequency" {{disabled (not editable)}}>
              {{selectOptions frequencyOptions selected=item.system.frequency}}
            </select>
          </label>
          <label>
            <span>{{localize "D6E2.Item.Activation"}}</span>
            <input
              type="text"
              name="system.activation"
              value="{{item.system.activation}}"
              {{disabled (not editable)}}
            />
          </label>
        </div>
      </section>
    {{/if}}

    {{#if isSecondEditionFeature}}
      <section class="od6item-section">
        <h3>{{localize "D6E2.Item.SecondEditionFeatureProfile"}}</h3>
        <p class="od6item-guidance">
          {{localize "D6E2.Item.FeatureAutomationPending"}}
        </p>
        <div class="od6item-field-grid">
          {{#if isRankedFeature}}
            <label>
              <span>{{localize "D6E2.Item.Rank"}}</span>
              <input
                type="number"
                name="system.rank"
                value="{{item.system.rank}}"
                min="1"
                step="1"
                {{disabled (not directEdit)}}
              />
            </label>
            <label>
              <span>{{localize "D6E2.Item.Focus"}}</span>
              <input
                type="text"
                name="system.focus"
                value="{{item.system.focus}}"
                {{disabled (not editable)}}
              />
            </label>
          {{/if}}
          {{#if isTalent}}
            <label>
              <span>{{localize "D6E2.Item.CreationSkillDiceCost"}}</span>
              <input
                type="number"
                name="system.cost"
                value="{{item.system.cost}}"
                min="0"
                step="1"
                {{disabled (not directEdit)}}
              />
            </label>
            <label class="od6item-check">
              <input
                type="checkbox"
                name="system.repeatable"
                {{checked item.system.repeatable}}
                {{disabled (not directEdit)}}
              />
              <span>{{localize "D6E2.Item.Repeatable"}}</span>
            </label>
          {{/if}}
          {{#if isNarrativeFeature}}
            <label>
              <span>{{localize "D6E2.Item.NarrativeTrigger"}}</span>
              <input
                type="text"
                name="system.trigger"
                value="{{item.system.trigger}}"
                {{disabled (not editable)}}
              />
            </label>
          {{/if}}
        </div>
      </section>
    {{/if}}

  </section>

  <section
    class="od6item-panel {{itemTabs.description.cssClass}}"
    data-item-tab-panel="description"
    aria-label="{{localize 'D6E2.Item.Description'}}"
  >
    <section class="od6item-section">
      <h3>{{localize "D6E2.Item.Description"}}</h3>
      {{#if hasSourceReference}}
        {{#if item.system.source.book}}
          <p class="d6e2-source-reference">
            <i class="fa-solid fa-book" aria-hidden="true"></i>
            {{localize "D6E2.Source.Reference"}}:
            {{item.system.source.book}}{{#if item.system.source.page}},
              {{localize "D6E2.Source.PageShort"}}
              {{item.system.source.page}}{{/if}}
          </p>
        {{/if}}
      {{/if}}
      <label class="od6item-description">
        <span>{{localize "D6E2.Item.Description"}}</span>
        <textarea
          name="system.description"
          rows="8"
          {{disabled (not descriptionEditable)}}
        >{{item.system.description}}</textarea>
      </label>
    </section>

    {{#if descriptionEditable}}
      <footer class="d6e2-sheet__footer">
        <button type="button" data-action="saveDescription">
          <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
          {{localize "D6E2.Save"}}
        </button>
      </footer>
    {{/if}}
  </section>

  <section
    class="od6item-panel {{itemTabs.effects.cssClass}}"
    data-item-tab-panel="effects"
    aria-label="{{localize 'D6E2.Item.Effects'}}"
  >
    <div class="od6item-section-heading">
      <div>
        <p class="od6v2-eyebrow">{{localize "D6E2.Item.Automation"}}</p>
        <h2>{{localize "D6E2.Item.Effects"}}</h2>
      </div>
      {{#if mayManageEffects}}
        <button type="button" data-action="createEffect">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          {{localize "D6E2.Item.AddEffect"}}
        </button>
      {{/if}}
    </div>
    <p class="od6item-guidance">{{localize "D6E2.Item.EffectsHelp"}}</p>
    <div class="od6item-effect-list">
      {{#each effects}}
        <div class="od6item-effect-row {{cssClass}}" data-effect-id="{{id}}">
          {{#if @root.mayManageEffects}}
            <button
              type="button"
              data-action="editEffect"
              aria-label="{{localize 'D6E2.Edit'}} {{name}}"
            >
              <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
              <span>{{name}}</span>
            </button>
          {{else}}
            <div class="od6item-effect-summary">
              <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
              <span>{{name}}</span>
            </div>
          {{/if}}
          {{#if @root.mayManageEffects}}
            <button
              class="is-danger"
              type="button"
              data-action="deleteEffect"
              aria-label="{{localize 'D6E2.Delete'}} {{name}}"
            >
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
          {{/if}}
        </div>
      {{else}}
        <p class="od6v2-empty">{{localize "D6E2.Item.NoEffects"}}</p>
      {{/each}}
    </div>
  </section>
</div>