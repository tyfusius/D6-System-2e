    class="od6item-panel {{itemTabs.description.cssClass}}"
    data-item-tab-panel="description"
    aria-label="{{localize 'D6E2.Item.Description'}}"
  >
    <section class="od6item-section">
      <h3>{{localize "D6E2.Item.Description"}}</h3>
      {{#if hasSourceReference}}
        {{#if item.system.source.book}}
          <p class="d6e2-source-reference">
            <i class="fa-solid fa-book" aria-hidden="true"></i>
            {{localize "D6E2.Source.Reference"}}:
            {{item.system.source.book}}{{#if item.system.source.page}},
              {{localize "D6E2.Source.PageShort"}}
              {{item.system.source.page}}{{/if}}
          </p>
        {{/if}}
      {{/if}}
      <label class="od6item-description">
        <span>{{localize "D6E2.Item.Description"}}</span>
        <textarea
          name="system.description"
          rows="8"
          {{disabled (not descriptionEditable)}}
        >{{item.system.description}}</textarea>
      </label>
    </section>

    {{#if descriptionEditable}}
      <footer class="d6e2-sheet__footer">
        <button type="button" data-action="saveDescription">
          <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
          {{localize "D6E2.Save"}}
        </button>
      </footer>
    {{/if}}
  </section>

  <section
    class="od6item-panel {{itemTabs.effects.cssClass}}"
    data-item-tab-panel="effects"
    aria-label="{{localize 'D6E2.Item.Effects'}}"
  >
    <div class="od6item-section-heading">
      <div>
        <p class="od6v2-eyebrow">{{localize "D6E2.Item.Automation"}}</p>
        <h2>{{localize "D6E2.Item.Effects"}}</h2>
      </div>
      {{#if mayManageEffects}}
        <button type="button" data-action="createEffect">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          {{localize "D6E2.Item.AddEffect"}}
        </button>
      {{/if}}
    </div>
    <p class="od6item-guidance">{{localize "D6E2.Item.EffectsHelp"}}</p>
    <div class="od6item-effect-list">
      {{#each effects}}
        <div class="od6item-effect-row {{cssClass}}" data-effect-id="{{id}}">
          {{#if @root.mayManageEffects}}
            <button
              type="button"
              data-action="editEffect"
              aria-label="{{localize 'D6E2.Edit'}} {{name}}"
            >
              <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
              <span>{{name}}</span>
            </button>
          {{else}}
            <div class="od6item-effect-summary">
              <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
              <span>{{name}}</span>
            </div>
          {{/if}}
          {{#if @root.mayManageEffects}}
            <button
              class="is-danger"
              type="button"
              data-action="deleteEffect"
              aria-label="{{localize 'D6E2.Delete'}} {{name}}"
            >
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
          {{/if}}
        </div>
      {{else}}
        <p class="od6v2-empty">{{localize "D6E2.Item.NoEffects"}}</p>
      {{/each}}
    </div>
  </section>
</div>