<div class="od6tasks-shell {{#if compact}}is-compact{{/if}}">
  <header class="od6tasks-strip">
    <span>
      <i class="fa-solid fa-list-check" inert></i>
      <strong>{{localize "D6E2.Tasks.Short"}}</strong>
      <b aria-label="{{localize 'D6E2.Tasks.Count'}}">{{count}}</b>
    </span>
    <button type="button" data-action="toggleCompact"
      title="{{#if compact}}{{localize 'D6E2.Tasks.Expand'}}{{else}}{{localize 'D6E2.Tasks.Collapse'}}{{/if}}"
      aria-label="{{#if compact}}{{localize 'D6E2.Tasks.Expand'}}{{else}}{{localize 'D6E2.Tasks.Collapse'}}{{/if}}">
      <i class="fa-solid {{#if compact}}fa-angles-right{{else}}fa-angles-left{{/if}}" inert></i>
    </button>
  </header>
  {{#unless compact}}
  <div class="od6tasks-list" aria-live="polite">
    {{#each tasks as |task|}}
    <article data-task-id="{{task.id}}" class="{{#if task.failed}}has-failed{{/if}}" {{#if task.working}}aria-busy="true"{{/if}}>
      {{#if task.actorImg}}<img src="{{task.actorImg}}" alt="">{{else}}<i class="fa-solid fa-bell" inert></i>{{/if}}
      <span>
        <small>{{task.kindLabel}}</small>
        <strong>{{task.label}}</strong>
        {{#if task.actorName}}<em>{{task.actorName}}{{#if task.controllerName}} · {{task.controllerName}}{{/if}}</em>{{/if}}
        <i class="fa-solid {{#if task.controllerOnline}}fa-signal{{else}}fa-plug-circle-xmark{{/if}}" inert></i>
        {{#if task.controllerOnline}}{{localize "D6E2.Tasks.Online"}}{{else}}{{localize "D6E2.Tasks.Offline"}}{{/if}}
        {{#if task.expiresIn}} · {{task.expiresIn}}s{{/if}}
        {{#if task.statusLabel}}
        <span class="od6tasks-status {{#if task.failed}}is-failed{{/if}}" role="{{#if task.failed}}alert{{else}}status{{/if}}">
          <i class="fa-solid {{#if task.failed}}fa-triangle-exclamation{{else}}fa-hourglass-half{{/if}}" inert></i>
          {{task.statusLabel}}
        </span>
        {{/if}}
      </span>
      <div>
        {{#if task.reopenable}}
        <button type="button" data-action="reopenTask" {{#if task.working}}disabled{{/if}}
          {{#if task.reopening}}aria-busy="true"{{/if}}
          title="{{localize 'D6E2.Tasks.Reopen'}}" aria-label="{{localize 'D6E2.Tasks.Reopen'}}">
          <i class="fa-solid {{#if task.reopening}}fa-spinner fa-spin{{else}}fa-arrow-up-right-from-square{{/if}}" inert></i>
        </button>
        {{/if}}
        {{#if task.takeover}}
        <button type="button" data-action="takeOverTask" {{#unless task.canTakeOver}}disabled{{else}}{{#if task.working}}disabled{{/if}}{{/unless}}
          {{#if task.takingOver}}aria-busy="true"{{/if}}
          title="{{localize 'D6E2.Tasks.TakeOver'}}" aria-label="{{localize 'D6E2.Tasks.TakeOver'}}">
          <i class="fa-solid {{#if task.takingOver}}fa-spinner fa-spin{{else}}fa-user-shield{{/if}}" inert></i>
        </button>
        {{/if}}
        {{#if task.cancellable}}
        <button type="button" data-action="cancelTask" class="is-danger" {{#if task.working}}disabled{{/if}}
          {{#if task.cancelling}}aria-busy="true"{{/if}}
          title="{{localize 'D6E2.Tasks.Cancel'}}" aria-label="{{localize 'D6E2.Tasks.Cancel'}}">
          <i class="fa-solid {{#if task.cancelling}}fa-spinner fa-spin{{else}}fa-xmark{{/if}}" inert></i>
        </button>
        {{/if}}
      </div>
    </article>
    {{else}}
    <p><i class="fa-solid fa-circle-check" inert></i><strong>{{localize "D6E2.Tasks.Empty"}}</strong><span>{{localize "D6E2.Tasks.EmptyHelp"}}</span></p>
    {{/each}}
  </div>
  {{/unless}}
</div>
