<div class="od6-dialog-shell d6e2-storage-configure-form">
  <label class="d6e2-storage-configure-name">
    <span>{{localize "D6E2.Storage.SpaceName"}}</span>
    <input type="text" name="label" required value="{{label}}" />
  </label>
  {{#if locationHelp}}<p class="od6-storage-help">{{locationHelp}}</p>{{/if}}
  {{{sizingHtml}}}
  <p
    data-storage-configuration-status
    role="status"
    aria-live="polite"
    hidden
  ></p>
  <input type="hidden" name="configuration" value="grid" />
</div>