<section class="od6-storage-sizing" data-d6-storage-dimensions>
  <label class="od6-storage-preset-field">
    <span>{{localize "D6E2.Storage.SpacePreset"}}</span>
    <select
      name="{{fields.spacePresetId}}"
      data-storage-grid-field
      {{disabled (or (not canEdit) (not metricPreview.gridEnabled))}}
    >
      {{#each spacePresets}}{{#if selected}}<option
            value="{{value}}"
            selected
          >{{label}}</option>{{else}}<option
            value="{{value}}"
          >{{label}}</option>{{/if}}{{/each}}
    </select>
    <small>{{localize "D6E2.Storage.SpacePresetHelp"}}</small>
  </label>
  <div
    data-d6-storage-metric-preview
    aria-live="polite"
    aria-atomic="true"
  >{{{metricPreviewHtml}}}</div>
  <details class="od6-storage-settings od6-storage-custom-dimensions">
    <summary>{{localize "D6E2.Storage.CustomDimensions"}}</summary>
    <div class="od6-storage-dimension-fields">
      <label class="is-wide"><span>{{localize
            "D6E2.Storage.ScalePreset"
          }}</span>
        <select
          name="{{fields.scalePresetId}}"
          data-storage-grid-field
          {{disabled (or (not canEdit) (not metricPreview.gridEnabled))}}
        >
          <option value="">{{localize "D6E2.Storage.CustomScale"}}</option>
          {{selectOptions scalePresetOptions selected=scalePresetId}}
        </select>
      </label>
      <label><span>{{localize "D6E2.Storage.Columns"}}</span><input
          type="number"
          name="{{fields.columns}}"
          value="{{columns}}"
          min="1"
          step="1"
          required
          data-storage-grid-field
          {{disabled (or (not canEdit) (not metricPreview.gridEnabled))}}
        /></label>
      <label><span>{{localize "D6E2.Storage.Rows"}}</span><input
          type="number"
          name="{{fields.rows}}"
          value="{{rows}}"
          min="1"
          step="1"
          required
          data-storage-grid-field
          {{disabled (or (not canEdit) (not metricPreview.gridEnabled))}}
        /></label>
      <label><span>{{localize "D6E2.Storage.CellWidthMm"}}</span><input
          type="number"
          name="{{fields.cellWidthMm}}"
          value="{{cellWidthMm}}"
          min="1"
          step="1"
          placeholder="{{localize 'D6E2.Storage.FromScale'}}"
          data-storage-grid-field
          {{disabled (or (not canEdit) (not metricPreview.gridEnabled))}}
        /></label>
      <label><span>{{localize "D6E2.Storage.CellDepthMm"}}</span><input
          type="number"
          name="{{fields.cellDepthMm}}"
          value="{{cellDepthMm}}"
          min="1"
          step="1"
          placeholder="{{localize 'D6E2.Storage.FromScale'}}"
          data-storage-grid-field
          {{disabled (or (not canEdit) (not metricPreview.gridEnabled))}}
        /></label>
      <label class="is-wide od6-storage-height-field"><span>{{localize
            "D6E2.Storage.InteriorHeightMm"
          }}</span><input
          type="number"
          name="{{fields.interiorHeightMm}}"
          value="{{interiorHeightMm}}"
          min="1"
          step="1"
          placeholder="{{localize 'D6E2.Storage.HeightNotChecked'}}"
          {{disabled (not canEdit)}}
        /></label>
    </div>
    <p class="od6-storage-help">{{localize
        "D6E2.Storage.HeightClearanceHelp"
      }}</p>
  </details>
  <input
    type="hidden"
    name="{{fields.customScaleId}}"
    value="{{customScaleId}}"
  />
  <input type="hidden" name="{{fields.scaleLabel}}" value="{{scaleLabel}}" />
  {{#unless canEdit}}<p
      class="od6-storage-help od6-storage-read-only"
    >{{localize "D6E2.Storage.SizeReadOnly"}}</p>{{/unless}}
</section>