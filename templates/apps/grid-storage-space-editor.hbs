<section
  class="od6-storage-editor"
  data-d6-storage-space-editor
  data-container-instance-id="{{containerInstanceId}}"
  data-root-uuid="{{rootUuid}}"
  data-space-id="{{spaceId}}"
><header class="od6-storage-section-heading"><h3>{{localize
        "D6E2.Storage.ConfigureSpace"
      }}</h3></header><div class="od6-storage-fields"><label
      class="is-wide"
    ><span>{{localize "D6E2.Storage.SpaceName"}}</span><input
        type="text"
        name="{{fields.label}}"
        value="{{label}}"
        {{disabled (not canEdit)}}
      /></label><label><span>{{localize "D6E2.Storage.SpaceMode"}}</span><select
        name="{{fields.configuration}}"
        {{disabled (not canEdit)}}
      >{{#if (eq configuration "grid")}}<option value="grid" selected>{{localize
              "D6E2.Storage.Grid"
            }}</option>{{else}}<option value="grid">{{localize
              "D6E2.Storage.Grid"
            }}</option>{{/if}}{{#if (eq configuration "capacity-only")}}<option
            value="capacity-only"
            selected
          >{{localize "D6E2.Storage.CapacityOnly"}}</option>{{else}}<option
            value="capacity-only"
          >{{localize
              "D6E2.Storage.CapacityOnly"
            }}</option>{{/if}}</select></label><label><span>{{localize
          "D6E2.Storage.ScalePreset"
        }}</span><select
        name="{{fields.scalePresetId}}"
        {{disabled (not canEdit)}}
      ><option value="">{{localize
            "D6E2.Storage.ChoosePreset"
          }}</option>{{selectOptions
          scalePresetOptions
          selected=scalePresetId
        }}</select></label><label><span>{{localize
          "D6E2.Storage.Columns"
        }}</span><input
        type="number"
        name="{{fields.columns}}"
        value="{{columns}}"
        min="1"
        step="1"
        placeholder="{{localize 'D6E2.Storage.Unknown'}}"
        {{disabled (not canEdit)}}
      /></label><label><span>{{localize "D6E2.Storage.Rows"}}</span><input
        type="number"
        name="{{fields.rows}}"
        value="{{rows}}"
        min="1"
        step="1"
        placeholder="{{localize 'D6E2.Storage.Unknown'}}"
        {{disabled (not canEdit)}}
      /></label><label><span>{{localize "D6E2.Storage.Access"}}</span><select
        name="{{fields.access}}"
        {{disabled (not canEdit)}}
      >{{#if (eq access "open")}}<option value="open" selected>{{localize
              "D6E2.Storage.AccessOpen"
            }}</option>{{else}}<option value="open">{{localize
              "D6E2.Storage.AccessOpen"
            }}</option>{{/if}}{{#if (eq access "closed")}}<option
            value="closed"
            selected
          >{{localize "D6E2.Storage.AccessClosed"}}</option>{{else}}<option
            value="closed"
          >{{localize "D6E2.Storage.AccessClosed"}}</option>{{/if}}{{#if
          (eq access "locked")
        }}<option value="locked" selected>{{localize
              "D6E2.Storage.AccessLocked"
            }}</option>{{else}}<option value="locked">{{localize
              "D6E2.Storage.AccessLocked"
            }}</option>{{/if}}</select></label></div><details
    class="od6-storage-settings"
  ><summary>{{localize "D6E2.Storage.AdvancedMeasurements"}}</summary><p
      class="od6-storage-help"
    >{{localize "D6E2.Storage.OptionalLimitsHelp"}}</p><div
      class="od6-storage-fields"
    ><label><span>{{localize "D6E2.Storage.CellWidthMm"}}</span><input
          type="number"
          name="{{fields.cellWidthMm}}"
          value="{{cellWidthMm}}"
          min="1"
          step="1"
          placeholder="{{localize 'D6E2.Storage.Unknown'}}"
          {{disabled (not canEdit)}}
        /></label><label><span>{{localize
            "D6E2.Storage.CellDepthMm"
          }}</span><input
          type="number"
          name="{{fields.cellDepthMm}}"
          value="{{cellDepthMm}}"
          min="1"
          step="1"
          placeholder="{{localize 'D6E2.Storage.Unknown'}}"
          {{disabled (not canEdit)}}
        /></label><label><span>{{localize
            "D6E2.Storage.WeightLimit"
          }}</span><input
          type="number"
          name="{{fields.maxAggregateWeightGrams}}"
          value="{{maxAggregateWeightGrams}}"
          min="0"
          step="1"
          placeholder="{{localize 'D6E2.Storage.NotLimited'}}"
          {{disabled (not canEdit)}}
        /></label><label><span>{{localize
            "D6E2.Storage.VolumeLimit"
          }}</span><input
          type="number"
          name="{{fields.maxOccupiedVolumeMillilitres}}"
          value="{{maxOccupiedVolumeMillilitres}}"
          min="0"
          step="1"
          placeholder="{{localize 'D6E2.Storage.NotLimited'}}"
          {{disabled (not canEdit)}}
        /></label><label><span>{{localize
            "D6E2.Storage.CountLimit"
          }}</span><input
          type="number"
          name="{{fields.maxDirectChildren}}"
          value="{{maxDirectChildren}}"
          min="0"
          step="1"
          placeholder="{{localize 'D6E2.Storage.NotLimited'}}"
          {{disabled (not canEdit)}}
        /></label></div></details><footer class="od6-storage-actions"><button
      type="button"
      data-action="{{action}}"
      data-root-uuid="{{rootUuid}}"
      data-space-id="{{spaceId}}"
      {{disabled (not canEdit)}}
    >{{localize "D6E2.Storage.SaveConfiguration"}}</button></footer>
  {{#if canRemoveRoot}}
    <details class="od6-storage-settings od6-storage-root-removal">
      <summary>{{removeLabel}}</summary>
      <p class="od6-storage-help">{{removeHelp}}</p>
      <button
        type="button"
        data-action="{{removeAction}}"
        data-root-uuid="{{rootUuid}}"
        data-space-id="{{spaceId}}"
      ><i class="fas fa-trash-can" aria-hidden="true"></i>
        {{removeLabel}}</button>
    </details>
  {{/if}}
</section>