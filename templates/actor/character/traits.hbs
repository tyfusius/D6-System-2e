<section
  class="tab od6v2-panel {{tab.cssClass}}"
  data-group="primary"
  data-tab="traits"
>
  <div class="od6v2-toolbar d6e2-inventory-toolbar">
    <div>
      <p class="od6v2-eyebrow">{{localize "D6E2.Item.TraitsEyebrow"}}</p>
      <h2>{{localize "D6E2.Tab.Traits"}}</h2>
      <p class="d6e2-tab-introduction">{{localize "D6E2.Item.TraitsHelp"}}</p>
    </div>
    {{#if canResetFeatureSession}}
      <button type="button" data-action="resetFeatureSession">
        <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        {{localize "D6E2.Feature.ResetSession"}}
      </button>
    {{/if}}
  </div>

  <div class="od6v2-item-group-grid is-traits">
    {{#each traitGroups as |group|}}
      <section class="od6v2-section od6v2-item-group">
        <header class="od6v2-item-group-heading">
          <h3>{{group.label}}</h3>
          {{#if @root.editable}}
            {{#if group.canCreate}}
              <button
                class="od6v2-icon-button"
                type="button"
                data-action="createItem"
                data-item-type="{{group.type}}"
                aria-label="{{localize 'D6E2.Item.Add'}} {{group.label}}"
              >
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
              </button>
            {{/if}}
          {{/if}}
        </header>
        <div class="od6v2-inventory-list">
          {{#each group.items as |item|}}
            <div
              class="od6v2-inventory-row"
              data-item-id="{{item.id}}"
              draggable="{{@root.editable}}"
            >
              <img src="{{item.img}}" alt="" />
              <button
                class="od6v2-inventory-name"
                type="button"
                data-action="editItem"
                aria-label="{{localize 'D6E2.Edit'}} {{item.name}}"
              >
                <strong>{{item.name}}</strong>
                <small>{{group.label}}</small>
              </button>
              {{#if item.featureUsesMaximum}}
                <span class="od6v2-pill">
                  {{item.featureUses}}
                  /
                  {{item.featureUsesMaximum}}
                </span>
              {{/if}}
              {{#if item.canInvokeFeature}}
                <button
                  class="od6v2-icon-button"
                  type="button"
                  data-action="invokeFeature"
                  aria-label="{{localize 'D6E2.Feature.Invoke'}} {{item.name}}"
                >
                  <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                </button>
              {{/if}}
              <button
                class="od6v2-icon-button"
                type="button"
                data-action="editItem"
                aria-label="{{localize 'D6E2.Edit'}} {{item.name}}"
              >
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
              </button>
              {{#if @root.freeEdit}}
                <button
                  class="od6v2-icon-button is-danger"
                  type="button"
                  data-action="deleteItem"
                  aria-label="{{localize 'D6E2.Delete'}} {{item.name}}"
                >
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>
          {{else}}
            <p class="od6v2-empty">{{localize "D6E2.Item.None"}}</p>
          {{/each}}
        </div>
      </section>
    {{/each}}
  </div>
</section>