<section
  class="tab od6v2-panel {{tab.cssClass}}"
  data-group="primary"
  data-tab="traits"
>
  <div class="od6v2-toolbar d6e2-inventory-toolbar">
    <div>
      <p class="od6v2-eyebrow">{{localize "D6E2.Item.TraitsEyebrow"}}</p>
      <h2>{{localize "D6E2.Tab.Traits"}}</h2>
      <p class="d6e2-tab-introduction">{{localize "D6E2.Item.TraitsHelp"}}</p>
    </div>
    {{#if freeD6Features}}
      {{#if editable}}
        <button type="button" data-action="openFreeD6FeatureBrowser">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          {{localize "D6E2.FreeD6.Features.Add"}}
        </button>
      {{/if}}
    {{/if}}
    {{#if canResetFeatureSession}}
      <button type="button" data-action="resetFeatureSession">
        <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        {{localize "D6E2.Feature.ResetSession"}}
      </button>
    {{/if}}
  </div>

  <div class="od6v2-item-group-grid is-traits">
    {{#each traitGroups as |group|}}
      <section class="od6v2-section od6v2-item-group">
        <header class="od6v2-item-group-heading">
          <h3>{{group.label}}</h3>
          {{#if @root.editable}}
            {{#if group.canCreate}}
              <button
                class="od6v2-icon-button"
                type="button"
                data-action="createItem"
                data-item-type="{{group.type}}"
                aria-label="{{localize 'D6E2.Item.Add'}} {{group.label}}"
              >
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
              </button>
            {{/if}}
          {{/if}}
        </header>
        <div class="od6v2-inventory-list">
          {{#each group.items as |item|}}
            <div
              class="od6v2-inventory-row"
              data-item-id="{{item.id}}"
              draggable="{{@root.editable}}"
            >
              <img src="{{item.img}}" alt="" />
              {{#if item.distinctionAutomation}}
                <button
                  class="od6v2-inventory-name"
                  type="button"
                  data-action="editItem"
                  aria-label="{{localize 'D6E2.Edit'}} {{item.name}}"
                  aria-describedby="{{item.distinctionAutomation.statusId}}"
                >
                  <strong>{{item.name}}</strong>
                  <small>{{group.label}}</small>
                  {{#if item.freeD6Feature}}
                    <small>
                      {{localize "D6E2.FreeD6.Features.PointValue"}}:
                      {{item.freeD6Feature.pointValue}}
                      {{#unless item.freeD6Feature.providerAvailable}}
                        ·
                        {{localize "D6E2.FreeD6.Features.ProviderUnavailable"}}
                      {{/unless}}
                    </small>
                  {{/if}}
                  <small
                    class="d6e2-distinction-automation-status"
                    id="{{item.distinctionAutomation.statusId}}"
                  >
                    {{localize "D6E2.Distinction.Automation"}}:
                    {{localize
                      "D6E2.Distinction.AutomaticCount"
                      count=item.distinctionAutomation.automatic
                    }}
                    ·
                    {{localize
                      "D6E2.Distinction.DeclarationCount"
                      count=item.distinctionAutomation.declaration
                    }}
                    ·
                    {{localize
                      "D6E2.Distinction.NarrativeCount"
                      count=item.distinctionAutomation.narrativeOnly
                    }}
                    ·
                    {{localize
                      "D6E2.Distinction.StoredCount"
                      count=item.distinctionAutomation.storedOnly
                    }}
                  </small>
                </button>
              {{else}}
                <button
                  class="od6v2-inventory-name"
                  type="button"
                  data-action="editItem"
                  aria-label="{{localize 'D6E2.Edit'}} {{item.name}}"
                >
                  <strong>{{item.name}}</strong>
                  <small>{{group.label}}</small>
                  {{#if item.freeD6Feature}}
                    <small>
                      {{localize "D6E2.FreeD6.Features.PointValue"}}:
                      {{item.freeD6Feature.pointValue}}
                      {{#unless item.freeD6Feature.providerAvailable}}
                        ·
                        {{localize "D6E2.FreeD6.Features.ProviderUnavailable"}}
                      {{/unless}}
                    </small>
                  {{/if}}
                </button>
              {{/if}}
              {{#if item.featureUsesMaximum}}
                <span class="od6v2-pill">
                  {{item.featureUses}}
                  /
                  {{item.featureUsesMaximum}}
                </span>
              {{/if}}
              {{#if item.canInvokeFeature}}
                <button
                  class="od6v2-icon-button"
                  type="button"
                  data-action="invokeFeature"
                  aria-label="{{localize 'D6E2.Feature.Invoke'}} {{item.name}}"
                >
                  <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                </button>
              {{/if}}
              {{#if (eq item.freeD6Feature.role "flaw")}}
                <button
                  type="button"
                  data-action="payOffFreeD6Flaw"
                  {{disabled (not item.freeD6Feature.providerAvailable)}}
                  aria-label="{{localize
                    'D6E2.FreeD6.Features.PayOff'
                  }} {{item.name}}"
                >
                  <i
                    class="fa-solid fa-hand-holding-dollar"
                    aria-hidden="true"
                  ></i>
                  <span class="sr-only">{{localize
                      "D6E2.FreeD6.Features.PayOff"
                    }}</span>
                </button>
              {{/if}}
              <button
                class="od6v2-icon-button"
                type="button"
                data-action="editItem"
                aria-label="{{localize 'D6E2.Edit'}} {{item.name}}"
              >
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
              </button>
              {{#if @root.freeEdit}}
                <button
                  class="od6v2-icon-button is-danger"
                  type="button"
                  data-action="deleteItem"
                  aria-label="{{localize 'D6E2.Delete'}} {{item.name}}"
                >
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>
          {{else}}
            <p class="od6v2-empty">{{localize "D6E2.Item.None"}}</p>
          {{/each}}
        </div>
      </section>
    {{/each}}
  </div>
</section>