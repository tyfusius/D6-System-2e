<section
  class="tab od6v2-panel {{tab.cssClass}}"
  data-group="primary"
  data-tab="attributes"
>
  <div class="od6v2-toolbar">
    <div>
      <p class="od6v2-eyebrow">{{localize "D6E2.CoreCapabilityMatrix"}}</p>
      <h2>{{localize "D6E2.Tab.AttributesSkills"}}</h2>
    </div>
    {{#if canSynchronizeSkills}}
      <div class="od6v2-toolbar-actions">
        <button type="button" data-action="synchronizeSkills">
          <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
          {{localize "D6E2.SkillCatalog.Synchronize"}}
        </button>
      </div>
    {{/if}}
    {{#if creation.active}}
      {{#if creation.moduleEnabled}}
        <div class="od6v2-toolbar-actions">
          <button type="button" data-action="createCreationAdvancedSkill">
            <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
            {{localize "D6E2.Creation.AddAdvancedSkill"}}
          </button>
        </div>
      {{/if}}
    {{/if}}
  </div>

  {{#if creation.active}}
    <aside
      class="od6v2-creation-panel"
      aria-label="{{localize 'D6E2.Creation.Title'}}"
    >
      <div class="od6v2-creation-heading">
        <div>
          <p class="od6v2-eyebrow">{{localize "D6E2.Creation.Title"}}</p>
          <strong>{{localize "D6E2.Creation.Budgets"}}</strong>
          <small>
            {{campaignProfileLabel}}
            · v{{campaignProfile.profileVersion}}
            ·
            {{#if @root.pipsEnabled}}
              {{localize "D6E2.Creation.PipsModule"}}
            {{else}}
              {{localize "D6E2.Creation.WholeDice"}}
            {{/if}}
            ·
            {{localize "D6E2.Creation.Source"}}
          </small>
        </div>
        <button
          type="button"
          data-action="finalizeCharacterCreation"
          {{disabled (not creation.canFinalize)}}
        >
          <i class="fa-solid fa-check" aria-hidden="true"></i>
          {{localize "D6E2.Creation.Finalize"}}
        </button>
      </div>
      <div class="od6v2-creation-budgets">
        <div>
          <span>{{localize "D6E2.Creation.Attributes"}}</span>
          <strong>{{creation.attributes.usedLabel}}
            /
            {{creation.attributes.budgetLabel}}</strong>
          <small>{{creation.attributes.remainingLabel}}
            {{localize "D6E2.Creation.Remaining"}}</small>
        </div>
        <div>
          <span>{{localize "D6E2.Creation.Skills"}}</span>
          <strong>{{creation.skills.usedLabel}}
            /
            {{creation.skills.budgetLabel}}</strong>
          <small>{{creation.skills.remainingLabel}}
            {{localize "D6E2.Creation.Remaining"}}</small>
        </div>
        {{#if creation.moduleEnabled}}
          <div>
            <span>{{localize "D6E2.Creation.Specializations"}}</span>
            <strong>{{creation.specializations.count}}
              /
              {{creation.specializations.maximumCount}}</strong>
            <small>{{localize "D6E2.Creation.SpecializationCost"}}</small>
          </div>
        {{/if}}
        {{#if creation.pips.enabled}}
          <div>
            <span>{{localize "D6E2.Creation.PipSplits"}}</span>
            <strong>
              {{localize "D6E2.Creation.Attributes"}}
              {{creation.pips.attributeModifierPips}}
              /
              {{creation.pips.maximumModifierPips}}
              ·
              {{localize "D6E2.Creation.Skills"}}
              {{creation.pips.skillModifierPips}}
              /
              {{creation.pips.maximumModifierPips}}
            </strong>
            <small>{{localize "D6E2.Creation.PipSplitLimit"}}</small>
          </div>
        {{/if}}
      </div>
      {{#if creation.issues.length}}
        <p class="od6v2-creation-warning">
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
          {{localize "D6E2.Creation.InvalidHelp"}}
        </p>
      {{/if}}
      {{#if creation.advancedSkillIssues.length}}
        <p class="od6v2-creation-warning">
          <i class="fa-solid fa-lock" aria-hidden="true"></i>
          {{localize "D6E2.Creation.AdvancedInvalidHelp"}}
        </p>
      {{/if}}
    </aside>
  {{/if}}

  {{#if advanceMode}}
    <aside class="od6v2-advance-banner">
      <i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i>
      <div>
        <strong>{{localize "D6E2.SheetMode.Advance"}}</strong>
        <span>
          {{advancementHelp}}
          {{#if advancementEnabled}}
            ·
            {{availableAdvancementResource}}
            {{advancementResourceLabel}}
          {{/if}}
        </span>
      </div>
    </aside>
  {{/if}}

  <div class="od6v2-attribute-grid">
    {{#each attributeColumns as |column|}}
      <div class="od6v2-attribute-column">
        {{#each column as |attribute|}}
          <article
            class="od6v2-attribute-card"
            data-attribute-id="{{attribute.id}}"
            data-label="{{attribute.label}}"
          >
            <div class="od6v2-attribute-heading">
              {{#if attribute.rollable}}
                <button
                  class="od6v2-roll"
                  type="button"
                  data-action="rollAttribute"
                  aria-label="{{localize
                    'D6E2.Roll.Action'
                  }} {{attribute.label}} {{attribute.scoreLabel}}"
                >
                  <span>{{attribute.label}}</span>
                  <strong>{{attribute.scoreLabel}}</strong>
                  <i class="fa-solid fa-dice-d6" aria-hidden="true"></i>
                </button>
              {{else}}
                <div
                  class="od6v2-roll is-unrated"
                  title="{{localize 'D6E2.Roll.Unrated'}}"
                >
                  <span>{{attribute.label}}</span>
                  <strong>{{attribute.scoreLabel}}</strong>
                  <i class="fa-solid fa-lock" aria-hidden="true"></i>
                </div>
              {{/if}}
              {{#if @root.freeEdit}}
                <div class="od6v2-score-edit" aria-label="{{attribute.label}}">
                  <label>
                    <span>{{localize "D6E2.PipScore"}}</span>
                    <input
                      name="system.attributes.{{attribute.id}}.score"
                      type="number"
                      value="{{attribute.score}}"
                      min="3"
                      max="15"
                      step="1"
                    />
                  </label>
                </div>
              {{/if}}
              {{#if @root.creation.active}}
                <div class="od6v2-creation-stepper">
                  <button
                    type="button"
                    data-action="adjustCreationAttribute"
                    data-direction="decrease"
                    aria-label="{{localize
                      'D6E2.Creation.Decrease'
                    }} {{attribute.label}}"
                  ><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                  <button
                    type="button"
                    data-action="adjustCreationAttribute"
                    data-direction="increase"
                    aria-label="{{localize
                      'D6E2.Creation.Increase'
                    }} {{attribute.label}}"
                  ><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                </div>
              {{/if}}
              {{#if @root.advanceMode}}
                {{#if attribute.canAdvance}}
                  <button
                    class="od6v2-advance-button"
                    type="button"
                    data-action="advanceAttribute"
                    aria-label="{{localize
                      'D6E2.Advancement.Advance'
                    }} {{attribute.label}} · {{attribute.advanceCost}} {{@root.advancementResourceLabel}}"
                  >
                    <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                    <small>{{attribute.advanceCost}}</small>
                  </button>
                {{else}}
                  <button
                    class="od6v2-advance-button"
                    type="button"
                    disabled
                    aria-label="{{@root.advancementHelp}}"
                    data-tooltip="{{@root.advancementHelp}}"
                  >
                    <i class="fa-solid fa-lock" aria-hidden="true"></i>
                  </button>
                {{/if}}
              {{/if}}
              {{#if @root.freeEdit}}
                <button
                  class="od6v2-icon-button"
                  type="button"
                  data-action="createItem"
                  data-item-type="skill"
                  aria-label="{{localize
                    'D6E2.AddSkill'
                  }} · {{attribute.label}}"
                >
                  <i class="fa-solid fa-plus" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>

            <div class="od6v2-skill-list">
              {{#each attribute.skills as |skill|}}
                <div
                  class="od6v2-item-row is-{{skill.training}}"
                  data-item-id="{{skill.id}}"
                >
                  {{#if skill.rollable}}
                    <button
                      class="od6v2-item-roll"
                      type="button"
                      data-action="rollSkill"
                      aria-label="{{localize
                        'D6E2.Roll.Action'
                      }} {{skill.name}} {{skill.scoreLabel}}"
                    >
                      <span>
                        {{skill.name}}
                        {{#if skill.parentSkillName}}
                          <small>{{skill.parentSkillName}}</small>
                        {{/if}}
                      </span>
                      <strong>{{skill.scoreLabel}}</strong>
                    </button>
                  {{else}}
                    <div
                      class="od6v2-item-roll is-unrated"
                      title="{{localize 'D6E2.Roll.Unrated'}}"
                    >
                      <span>{{skill.name}}</span>
                      <strong>{{skill.scoreLabel}}</strong>
                    </div>
                  {{/if}}
                  {{#if @root.freeEdit}}
                    <div class="od6v2-score-edit is-skill">
                      <label>
                        <span>{{localize "D6E2.PipScore"}}</span>
                        <input
                          data-item-field="system.score"
                          type="number"
                          value="{{skill.score}}"
                          min="0"
                          step="1"
                        />
                      </label>
                    </div>
                  {{else}}
                    <small
                      title="{{localize 'D6E2.SkillBonus'}}"
                    >{{skill.bonusLabel}}</small>
                  {{/if}}
                  {{#if @root.creation.active}}
                    {{#unless (eq skill.training "specialization")}}
                      <div class="od6v2-creation-stepper is-skill">
                        <button
                          type="button"
                          data-action="adjustCreationSkill"
                          data-direction="decrease"
                          aria-label="{{localize
                            'D6E2.Creation.Decrease'
                          }} {{skill.name}}"
                        ><i
                            class="fa-solid fa-minus"
                            aria-hidden="true"
                          ></i></button>
                        <button
                          type="button"
                          data-action="adjustCreationSkill"
                          data-direction="increase"
                          aria-label="{{localize
                            'D6E2.Creation.Increase'
                          }} {{skill.name}}"
                        ><i
                            class="fa-solid fa-plus"
                            aria-hidden="true"
                          ></i></button>
                      </div>
                      {{#if (eq skill.training "standard")}}
                        {{#if @root.creation.moduleEnabled}}
                          <button
                            class="od6v2-icon-button"
                            type="button"
                            data-action="createCreationSpecialization"
                            aria-label="{{localize
                              'D6E2.Creation.AddSpecialization'
                            }} {{skill.name}}"
                          >
                            <i
                              class="fa-solid fa-crosshairs"
                              aria-hidden="true"
                            ></i>
                          </button>
                        {{/if}}
                      {{/if}}
                    {{/unless}}
                    {{#if skill.canEditCreation}}
                      <button
                        class="od6v2-icon-button"
                        type="button"
                        data-action="editItem"
                        aria-label="{{localize 'D6E2.Edit'}} {{skill.name}}"
                      >
                        <i
                          class="fa-solid fa-pen-to-square"
                          aria-hidden="true"
                        ></i>
                      </button>
                    {{/if}}
                  {{/if}}
                  {{#if @root.advanceMode}}
                    {{#if skill.canAdvance}}
                      <button
                        class="od6v2-advance-button is-skill"
                        type="button"
                        data-action="advanceItem"
                        aria-label="{{localize
                          'D6E2.Advancement.Advance'
                        }} {{skill.name}} · {{skill.advanceCost}} {{@root.advancementResourceLabel}}"
                      >
                        <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                        <small>{{skill.advanceCost}}</small>
                      </button>
                    {{else}}
                      <button
                        class="od6v2-advance-button is-skill"
                        type="button"
                        disabled
                        aria-label="{{@root.advancementHelp}}"
                        data-tooltip="{{@root.advancementHelp}}"
                      >
                        <i class="fa-solid fa-lock" aria-hidden="true"></i>
                      </button>
                    {{/if}}
                  {{/if}}
                  {{#if @root.freeEdit}}
                    <button
                      class="od6v2-icon-button"
                      type="button"
                      data-action="editItem"
                      aria-label="{{localize 'D6E2.Edit'}} {{skill.name}}"
                    >
                      <i
                        class="fa-solid fa-pen-to-square"
                        aria-hidden="true"
                      ></i>
                    </button>
                  {{/if}}
                </div>
              {{else}}
                <p class="od6v2-empty">{{localize "D6E2.NoLinkedSkills"}}</p>
              {{/each}}
            </div>
          </article>
        {{/each}}
      </div>
    {{/each}}
  </div>
</section>