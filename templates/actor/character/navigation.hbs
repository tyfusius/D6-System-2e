<section
  class="d6e2-sheet-navigation"
  aria-label="{{localize 'D6E2.SheetSections'}}"
>
  <nav
    class="d6e2-parent-navigation"
    aria-label="{{localize 'D6E2.SheetSections'}}"
  >
    {{#each tabFamilies}}
      <button
        type="button"
        class="d6e2-parent-tab {{cssClass}}"
        data-action="selectTabFamily"
        data-tab-family="{{id}}"
        aria-pressed="{{active}}"
      >
        <i class="{{icon}}" aria-hidden="true"></i>
        <span>{{localize label}}</span>
      </button>
    {{/each}}
  </nav>

  {{#if activeTabFamily.showChildNavigation}}
    <nav
      class="tabs d6e2-child-navigation"
      data-group="primary"
      aria-label="{{localize activeTabFamily.label}}"
    >
      {{#each activeTabFamily.tabs}}
        <a
          class="{{cssClass}}"
          data-action="tab"
          data-group="primary"
          data-tab="{{id}}"
        >
          <i class="{{icon}}" aria-hidden="true"></i>
          <span>{{localize label}}</span>
        </a>
      {{/each}}
    </nav>
  {{/if}}
</section>