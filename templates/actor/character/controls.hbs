<section
  class="od6v2-sheet-utilities"
  aria-label="{{localize 'D6E2.SheetControls'}}"
>
  <div class="od6v2-sheet-utility-start">
    <label class="od6v2-mode">
      <span><i class="fa-solid fa-sliders" aria-hidden="true"></i>
        {{localize "D6E2.SheetModeLabel"}}</span>
      <select name="system.sheetMode.value" {{disabled (not editable)}}>
        {{#each sheetModes as |mode|}}
          {{#if mode.selected}}
            <option value="{{mode.value}}" selected>{{mode.label}}</option>
          {{else}}
            <option value="{{mode.value}}">{{mode.label}}</option>
          {{/if}}
        {{/each}}
      </select>
    </label>
    {{#if skillTree.active}}
      <button
        class="d6e2-skill-tree-action"
        type="button"
        data-action="openSkillTree"
        {{disabled (not skillTree.available)}}
        data-tooltip="{{skillTree.help}}"
      >
        <i class="fa-solid fa-code-branch" aria-hidden="true"></i>
        <span>{{localize "D6E2.SkillTree.Open"}}</span>
      </button>
    {{/if}}
  </div>
  <div class="d6e2-setting-brand {{settingLogoClass}}">
    <span
      class="d6e2-setting-brand-logo"
      role="img"
      aria-label="{{settingLabel}}"
      title="{{settingLabel}}"
      style="background-image: url('{{settingLogo}}')"
    ></span>
  </div>
  <p class="od6v2-theme-control d6e2-mode-description">
    {{#if freeEdit}}
      <i class="fa-solid fa-unlock-keyhole" aria-hidden="true"></i>
      {{localize "D6E2.SheetMode.FreeEditHelp"}}
    {{else if advanceMode}}
      <i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i>
      {{localize "D6E2.SheetMode.AdvanceHelp"}}
    {{else}}
      <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
      {{localize "D6E2.SheetMode.NormalHelp"}}
    {{/if}}
  </p>
</section>