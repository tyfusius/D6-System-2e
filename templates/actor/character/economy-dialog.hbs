<div class="od6-dialog-shell d6e2-economy-dialog-content">
  {{#if (eq mode "spend")}}
    <p>{{localize "D6E2.Economy.SpendHelp"}}</p>
  {{else}}
    <p>{{localize "D6E2.Economy.TransferHelp"}}</p>
  {{/if}}

  <div class="d6e2-economy-balance">
    <span>{{currencyLabel}}</span>
    <strong>{{balance}}</strong>
  </div>

  {{#if item}}
    <div class="d6e2-economy-item-summary">
      <i class="fa-solid fa-suitcase" aria-hidden="true"></i>
      <span>{{item.name}}</span>
      <strong>×{{item.quantity}}</strong>
    </div>
  {{/if}}

  {{#if showRecipient}}
    <label>
      <span>{{localize "D6E2.Economy.Recipient"}}</span>
      <select name="recipient" required>
        {{#each recipients as |recipient|}}
          <option value="{{recipient.encoded}}">
            {{recipient.label}}
            ·
            {{recipient.typeLabel}}
          </option>
        {{/each}}
      </select>
    </label>
  {{/if}}

  <label>
    <span>
      {{#if item}}
        {{localize "D6E2.Economy.Quantity"}}
      {{else}}
        {{localize "D6E2.Economy.Amount"}}
      {{/if}}
    </span>
    <input
      name="amount"
      type="number"
      value="1"
      min="1"
      max="{{maximum}}"
      step="1"
      required
    />
  </label>

  {{#if (eq mode "spend")}}
    <label>
      <span>{{localize "D6E2.Economy.Note"}}</span>
      <input
        name="note"
        type="text"
        maxlength="160"
        placeholder="{{localize 'D6E2.Economy.NotePlaceholder'}}"
      />
    </label>
  {{/if}}

  <p class="d6e2-economy-audit-note">
    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
    {{localize "D6E2.Economy.GmAuditHelp"}}
  </p>
</div>