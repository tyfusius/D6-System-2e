<section
  class="tab od6v2-panel {{tab.cssClass}}"
  data-group="primary"
  data-tab="combat"
>
  <div class="od6v2-toolbar">
    <div>
      <p class="od6v2-eyebrow">{{localize "D6E2.Combat.TacticalSystems"}}</p>
      <h2>{{localize "D6E2.Tab.Combat"}}</h2>
    </div>
    {{#if editable}}
      <div class="od6v2-toolbar-actions">
        <button type="button" data-action="createItem" data-item-type="weapon">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          {{localize "D6E2.Item.Weapon"}}
        </button>
        <button type="button" data-action="createItem" data-item-type="armor">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          {{localize "D6E2.Item.Armor"}}
        </button>
      </div>
    {{/if}}
  </div>

  {{#if combat.actionSegmentsActive}}
    {{#if combat.roundState}}
      <section class="d6e2-round-actions {{combat.roundStateClass}}">
        <div class="d6e2-round-actions-header">
          <div>
            <p class="od6v2-eyebrow">
              {{localize "D6E2.Combat.Round"}}
              {{combat.roundState.round}}
            </p>
            <h3>{{localize "D6E2.Combat.ActionSegments"}}</h3>
          </div>
          <div class="d6e2-round-penalty">
            <span>{{localize "D6E2.Combat.RoundPenalty"}}</span>
            <strong>{{combat.roundState.penaltyLabel}}</strong>
          </div>
        </div>
        {{#if combat.roundActions.length}}
          <ol class="d6e2-round-action-list">
            {{#each combat.roundActions as |action|}}
              <li class="{{action.cssClass}}">
                <span class="d6e2-action-segment">{{action.number}}</span>
                <i class="fa-solid {{action.icon}}" aria-hidden="true"></i>
                <strong>{{action.label}}</strong>
                <small>{{action.kind}}</small>
              </li>
            {{/each}}
          </ol>
          {{#if combat.roundState.currentAction}}
            <p class="d6e2-current-action">
              {{localize "D6E2.Combat.CurrentAction"}}:
              <strong>{{combat.roundState.currentAction.label}}</strong>
            </p>
          {{else}}
            <p class="d6e2-current-action is-complete">
              <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
              {{localize "D6E2.Combat.DeclarationComplete"}}
            </p>
          {{/if}}
        {{else}}
          <p class="od6v2-empty">{{localize "D6E2.Combat.NoDeclaration"}}</p>
        {{/if}}
        <div class="d6e2-round-actions-controls">
          <button
            type="button"
            data-action="declareCombatActions"
            {{disabled (not combat.canDeclareActions)}}
          >
            <i class="fa-solid fa-list-ol" aria-hidden="true"></i>
            {{localize "D6E2.Combat.Declare"}}
          </button>
          <button
            type="button"
            data-action="completeCombatAction"
            {{disabled (not combat.canCompleteAction)}}
          >
            <i class="fa-solid fa-forward-step" aria-hidden="true"></i>
            {{localize "D6E2.Combat.CompleteNext"}}
          </button>
          <button
            type="button"
            data-action="resetCombatActions"
            {{disabled (not combat.canResetActions)}}
          >
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
            {{localize "D6E2.Combat.ResetDeclaration"}}
          </button>
        </div>
      </section>
    {{else}}
      <aside class="od6v2-advance-banner">
        <i class="fa-solid fa-swords" aria-hidden="true"></i>
        <div>
          <strong>{{localize "D6E2.Combat.NotInCombat"}}</strong>
          <span>{{localize "D6E2.Combat.NotInCombatHelp"}}</span>
        </div>
      </aside>
    {{/if}}
  {{/if}}

  {{#if combat.secondEdition}}
    <div class="d6e2-defense-grid">
      <article>
        <i class="fa-solid fa-person-running" aria-hidden="true"></i>
        <span>{{localize "D6E2.Combat.Dodge"}}</span>
        <strong>{{combat.dodge}}</strong>
        <small>{{localize "D6E2.Combat.PerceptionDefense"}}</small>
      </article>
      <article>
        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        <span>{{localize "D6E2.Combat.Parry"}}</span>
        <strong>{{combat.parry}}</strong>
        <small>{{localize "D6E2.Combat.AgilityDefense"}}</small>
      </article>
      <article class="d6e2-map-guide">
        <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
        <span>{{localize "D6E2.Combat.Actions"}}</span>
        <strong>1 / 2 / 3 / 4</strong>
        <small>0D / −1D / −2D / −3D</small>
      </article>
    </div>
  {{else}}
    <aside class="od6v2-advance-banner">
      <i class="fa-solid fa-shield" aria-hidden="true"></i>
      <div>
        <strong>{{localize "D6E2.Combat.FirstEditionDefenses"}}</strong>
        <span>{{localize "D6E2.Combat.FirstEditionDefensesHelp"}}</span>
      </div>
    </aside>
  {{/if}}

  <section class="od6v2-condition-panel is-{{combat.condition}}">
    <div class="od6v2-condition-heading">
      <div class="od6v2-condition-icon" aria-hidden="true">
        <i class="fa-solid fa-heart-pulse"></i>
      </div>
      <div>
        <p class="od6v2-eyebrow">{{localize "D6E2.ConditionLabel"}}</p>
        <h3>{{localize "D6E2.Combat.ConditionTrack"}}</h3>
      </div>
    </div>
    <div
      class="od6v2-condition-track d6e2-condition-track"
      role="group"
      aria-label="{{localize 'D6E2.Combat.ConditionTrack'}}"
    >
      {{#each combat.conditions as |condition|}}
        <button
          class="od6v2-condition-step d6e2-condition-step is-{{condition.value}}
            {{condition.cssClass}}"
          type="button"
          data-action="setCondition"
          data-condition="{{condition.value}}"
          aria-pressed="{{condition.current}}"
          {{disabled (not @root.editable)}}
        >
          <span class="od6v2-condition-node" aria-hidden="true"></span>
          <strong>{{condition.label}}</strong>
        </button>
      {{/each}}
    </div>
  </section>

  <section class="od6v2-section">
    <h3>{{localize "D6E2.Item.Weapon"}}</h3>
    <div class="od6v2-loadout-grid">
      {{#each combat.weapons as |item|}}
        <article class="od6v2-loadout" data-item-id="{{item.id}}">
          <img src="{{item.img}}" alt="" />
          <button
            class="od6v2-loadout-name"
            type="button"
            data-action="rollCombatItem"
          >
            <span>{{item.name}}</span>
            <small>{{localize "D6E2.Combat.Attack"}}</small>
          </button>
          <button
            class="od6v2-data-point is-roll"
            type="button"
            data-action="rollCombatItemDamage"
          >
            <span>{{localize "D6E2.Item.Damage"}}</span>
            <strong>{{item.damageLabel}}</strong>
          </button>
          <label class="od6v2-toggle">
            <input
              type="checkbox"
              data-action="toggleEquipped"
              {{checked item.equipped}}
              {{disabled (not @root.editable)}}
            />
            <span>{{localize "D6E2.Item.Equipped"}}</span>
          </label>
          <button
            class="od6v2-icon-button"
            type="button"
            data-action="editItem"
            aria-label="{{localize 'D6E2.Edit'}} {{item.name}}"
          >
            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
          </button>
        </article>
      {{else}}
        <p class="od6v2-empty">{{localize "D6E2.Combat.NoWeapons"}}</p>
      {{/each}}
    </div>
  </section>

  <section class="od6v2-section">
    <h3>{{localize "D6E2.Item.Armor"}}</h3>
    <div class="od6v2-loadout-grid">
      {{#each combat.armor as |item|}}
        <article class="od6v2-loadout" data-item-id="{{item.id}}">
          <img src="{{item.img}}" alt="" />
          <button
            class="od6v2-loadout-name"
            type="button"
            data-action="editItem"
          >
            <span>{{item.name}}</span>
            <small>{{localize "D6E2.Item.Protection"}}
              {{item.protectionLabel}}</small>
          </button>
          <label class="od6v2-toggle">
            <input
              type="checkbox"
              data-action="toggleEquipped"
              {{checked item.equipped}}
              {{disabled (not @root.editable)}}
            />
            <span>{{localize "D6E2.Item.Equipped"}}</span>
          </label>
        </article>
      {{else}}
        <p class="od6v2-empty">{{localize "D6E2.Combat.NoArmor"}}</p>
      {{/each}}
    </div>
  </section>
</section>