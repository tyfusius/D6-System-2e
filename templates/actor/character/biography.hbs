<section
  class="tab od6v2-panel {{tab.cssClass}}"
  data-group="primary"
  data-tab="biography"
>
  <div class="od6v2-toolbar">
    <div>
      <p class="od6v2-eyebrow">{{localize "D6E2.IdentityNarrative"}}</p>
      <h2>{{localize "D6E2.CharacterProfile"}}</h2>
      <p class="d6e2-tab-introduction">{{localize
          "D6E2.CharacterProfileHelp"
        }}</p>
    </div>
  </div>

  <div class="d6e2-profile-facts">
    <label><span>{{localize "D6E2.Profile.Gender"}}</span><input
        name="system.profile.gender"
        type="text"
        value="{{actor.system.profile.gender}}"
        {{disabled (not editable)}}
      /></label>
    <label><span>{{localize "D6E2.Profile.Age"}}</span><input
        name="system.profile.age"
        type="text"
        value="{{actor.system.profile.age}}"
        {{disabled (not editable)}}
      /></label>
    <label><span>{{localize "D6E2.Profile.Height"}}</span><input
        name="system.profile.height"
        type="text"
        value="{{actor.system.profile.height}}"
        {{disabled (not editable)}}
      /></label>
    <label><span>{{localize "D6E2.Profile.Weight"}}</span><input
        name="system.profile.weight"
        type="text"
        value="{{actor.system.profile.weight}}"
        {{disabled (not editable)}}
      /></label>
    {{#if companionDetails.allegianceLabel}}
      <label><span>{{companionDetails.allegianceLabel}}</span><input
          name="system.profile.allegiance"
          type="text"
          value="{{companionDetails.allegiance}}"
          {{disabled (not editable)}}
        /></label>
    {{/if}}
  </div>

  <div class="od6v2-biography-grid d6e2-profile-writing-grid">
    <label class="od6v2-writing-panel">
      <span class="d6e2-writing-label"><i
          class="fa-solid fa-face-smile"
          aria-hidden="true"
        ></i>{{localize "D6E2.Profile.Personality"}}</span>
      <textarea
        name="system.profile.personality"
        rows="7"
        {{disabled (not editable)}}
      >{{actor.system.profile.personality}}</textarea>
    </label>
    <label class="od6v2-writing-panel">
      <span class="d6e2-writing-label"><i
          class="fa-solid fa-user"
          aria-hidden="true"
        ></i>{{localize "D6E2.Profile.PhysicalDescription"}}</span>
      <textarea
        name="system.profile.physicalDescription"
        rows="7"
        {{disabled (not editable)}}
      >{{actor.system.profile.physicalDescription}}</textarea>
    </label>
    <section class="od6v2-writing-panel is-wide">
      <span class="d6e2-writing-label"><i
          class="fa-solid fa-book-open"
          aria-hidden="true"
        ></i>{{localize "D6E2.Profile.Background"}}</span>
      {{#if editable}}
        {{! OD6S Next v13 uses Foundry's stock ProseMirror menu contract. }}
        <prose-mirror
          name="system.profile.background"
          button="true"
          editable="true"
          toggled="false"
          value="{{writing.background.value}}"
          data-d6e2-character-writing-editor
        >{{{writing.background.html}}}</prose-mirror>
      {{else}}
        <div class="d6e2-writing-content enriched-content">
          {{{writing.background.html}}}
        </div>
      {{/if}}
    </section>
    <section class="od6v2-writing-panel is-wide is-notes">
      <span class="d6e2-writing-label"><i
          class="fa-solid fa-note-sticky"
          aria-hidden="true"
        ></i>{{localize "D6E2.Profile.CampaignNotes"}}</span>
      {{#if editable}}
        <prose-mirror
          name="system.biography"
          button="true"
          editable="true"
          toggled="false"
          value="{{writing.biography.value}}"
          data-d6e2-character-writing-editor
        >{{{writing.biography.html}}}</prose-mirror>
      {{else}}
        <div class="d6e2-writing-content enriched-content">
          {{{writing.biography.html}}}
        </div>
      {{/if}}
    </section>
  </div>
</section>