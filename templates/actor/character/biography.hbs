<section
  class="tab od6v2-panel {{tab.cssClass}}"
  data-group="primary"
  data-tab="biography"
>
  <div class="od6v2-toolbar">
    <div>
      <p class="od6v2-eyebrow">{{localize "D6E2.IdentityNarrative"}}</p>
      <h2>{{localize "D6E2.Biography"}}</h2>
    </div>
  </div>
  <div class="od6v2-biography-content">
    <div class="od6v2-biography-grid">
      <section class="od6v2-writing-panel is-wide">
        <header class="od6v2-writing-heading">
          <i class="fa-solid fa-book-open" aria-hidden="true"></i>
          <div>
            <h3>{{localize "D6E2.CharacterNotes"}}</h3>
            <p>{{localize "D6E2.CharacterNotesHelp"}}</p>
          </div>
        </header>
        <textarea
          name="system.biography"
          rows="16"
          {{disabled (not editable)}}
        >{{actor.system.biography}}</textarea>
      </section>
    </div>
  </div>
</section>