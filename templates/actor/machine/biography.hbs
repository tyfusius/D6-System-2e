<section
  class="tab od6v2-panel {{tab.cssClass}}"
  data-group="primary"
  data-tab="biography"
>
  <div class="od6v2-toolbar">
    <div>
      <p class="od6v2-eyebrow">{{machineTypeLabel}}</p>
      <h2>{{localize "D6E2.Machine.Notes"}}</h2>
    </div>
  </div>
  <div class="od6v2-biography-content">
    <section class="od6v2-writing-panel is-wide">
      <header class="od6v2-writing-heading">
        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
        <div>
          <h3>{{localize "D6E2.Machine.Notes"}}</h3>
          <p>{{localize "D6E2.Machine.NotesHelp"}}</p>
        </div>
      </header>
      <textarea
        name="system.biography"
        rows="18"
        {{disabled (not editable)}}
      >{{system.biography}}</textarea>
    </section>
  </div>
</section>