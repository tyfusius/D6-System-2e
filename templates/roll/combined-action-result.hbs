<article class="od6chat-roll od6-combined-action-result od6-theme-classic">
  <header>
    <i class="fa-solid fa-people-group" aria-hidden="true"></i>
    <div><span>{{localize "D6E2.CombinedActions.OptionalRule"}}</span><strong
      >{{label}}</strong></div>
  </header>
  <section>
    <p><span>{{localize "D6E2.CombinedActions.Leader"}}</span><strong
      >{{leaderName}}</strong></p>
    <p><span>{{localize "D6E2.CombinedActions.PrimaryWorker"}}</span><strong
      >{{primaryName}}</strong></p>
    <p><span>{{localize "D6E2.CombinedActions.Participants"}}</span><strong
      >{{participantNames}}</strong></p>
  </section>
  <div class="od6-combined-action-command {{commandClass}}">
    <span>{{localize "D6E2.CombinedActions.CommandRoll"}}</span>
    <strong>{{commandTotal}} / {{commandDifficulty}}</strong>
    <small>{{#if commandSucceeded}}{{localize
          "D6E2.Roll.Success"
        }}{{else}}{{localize "D6E2.Roll.Failure"}}{{/if}}
      ·
      {{#if leaderWorks}}{{localize
          "D6E2.CombinedActions.WorkingPenalty"
        }}{{else}}{{localize
          "D6E2.CombinedActions.SupervisingOnly"
        }}{{/if}}</small>
  </div>
  <div class="od6-combined-action-bonus">
    <span>{{localize "D6E2.CombinedActions.FinalBonus"}}</span>
    <strong>+{{bonusLabel}}</strong>
    <small>{{localize "D6E2.CombinedActions.PotentialBonus"}}
      +{{potentialBonusLabel}}</small>
  </div>
  <p class="od6chat-context"><i
      class="fa-solid fa-code-branch"
      aria-hidden="true"
    ></i>{{allocationLabel}}</p>
  <p class="od6chat-context"><i
      class="fa-solid fa-shield-halved"
      aria-hidden="true"
    ></i>{{localize "D6E2.CombinedActions.RestrictionHelp"}}</p>
</article>