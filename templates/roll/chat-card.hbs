<article class="od6chat-roll od6-theme-classic">
  <header>
    <img src="{{actor.img}}" alt="" />
    <div>
      <span>{{actor.name}}</span>
      <strong>{{request.label}}</strong>
    </div>
    <i class="fa-solid fa-cube" aria-hidden="true"></i>
  </header>

  {{#if requestedRoll}}
    <p class="od6chat-requested">
      <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i>
      {{localize "D6E2.RequestRoll.RequestedBy"}}
      <strong>{{requestedRoll.requesterName}}</strong>
      ·
      {{requestedRoll.visibilityLabel}}
    </p>
  {{/if}}

  <div class="od6chat-formula">
    {{result.pool.code.dice}}D{{#if
      result.pool.code.pips
    }}+{{result.pool.code.pips}}{{/if}}
  </div>

  {{#if hasAdvancedSkillContext}}
    <p class="od6chat-context">
      <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
      {{localize "D6E2.Roll.AdvancedContext.Applied"}}
      ·
      {{advancedSkillContext.label}}
      +{{advancedSkillContext.scoreLabel}}
    </p>
  {{/if}}

  {{#if hasActionEconomyContext}}
    <p class="od6chat-context">
      <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
      {{#if actionEconomyContext.hasRound}}
        {{localize "D6E2.Combat.Round"}}
        {{actionEconomyContext.round}}
        ·
      {{/if}}
      {{#if actionEconomyContext.hasActionCount}}
        {{actionEconomyContext.actionCount}}
        {{actionEconomyContext.actionCountLabel}}
        ·
      {{/if}}
      {{actionEconomyContext.penaltyLabel}}
      ·
      {{actionEconomyContext.mapSourceLabel}}
    </p>
  {{/if}}

  {{#if hasDoublingDownContext}}
    <p class="od6chat-context is-doubling-down">
      <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
      {{localize "D6E2.Roll.DoublingDown.Retry"}}
      ·
      {{localize "D6E2.Roll.DoublingDown.OriginalTotal"}}
      {{doublingDownContext.originalTotal}}
      {{#if doublingDownContext.narration}}
        ·
        {{doublingDownContext.narration}}
      {{/if}}
    </p>
  {{/if}}

  {{#if hasMachineCrewContext}}
    <section class="od6chat-combat-audit">
      <span>
        <i class="fa-solid fa-user-astronaut" aria-hidden="true"></i>
        {{localize "D6E2.Machine.Gunner"}}
      </span>
      <strong>
        {{machineCrewContext.crewName}}
        ·
        {{machineCrewContext.machineName}}
      </strong>
      <small>
        {{localize "D6E2.Machine.Gunnery"}}
        {{machineCrewContext.crewSkillScoreLabel}}
        +
        {{localize "D6E2.Machine.AttackBonus"}}
        {{machineCrewContext.weaponAttackBonusLabel}}
        {{#if machineCrewContext.missingCrewCount}}
          ·
          {{localize "D6E2.Machine.CrewShortfall"}}
          −{{machineCrewContext.crewPenaltyLabel}}
        {{/if}}
        ·
        {{localize "D6E2.RulesReference"}}
        p.
        {{machineCrewContext.sourcePage}}
      </small>
    </section>
  {{/if}}

  {{#if hasWeaponAttackContext}}
    <section class="od6chat-combat-audit">
      <span>
        <i class="fa-solid fa-crosshairs" aria-hidden="true"></i>
        {{localize "D6E2.Combat.Target"}}
      </span>
      <strong>{{weaponAttackContext.targetName}}</strong>
      <small>
        {{weaponAttackContext.rangeLabel}}
        {{#if weaponAttackContext.distance}}
          ·
          {{weaponAttackContext.distance}}
          {{localize "D6E2.Combat.Meters"}}
        {{/if}}
        ·
        {{weaponAttackContext.defenseLabel}}
        {{weaponAttackContext.defense}}
      </small>
    </section>
  {{/if}}

  {{#if hasScaleContext}}
    <section class="od6chat-combat-audit">
      <span>
        <i class="fa-solid fa-maximize" aria-hidden="true"></i>
        {{localize "D6E2.Combat.ScaleModifier"}}
      </span>
      <strong>
        {{localize "D6E2.Combat.ScaleRank"}}
        {{scaleContext.sourceRank}}
        →
        {{scaleContext.targetRank}}
      </strong>
      <small>
        {{scaleContext.applicationLabel}}
        · +{{scaleContext.modifierLabel}}
        ·
        {{localize "D6E2.RulesReference"}}
        p. 196
      </small>
    </section>
  {{/if}}

  {{#if hasResistanceContext}}
    <section class="od6chat-combat-audit">
      <span>
        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        {{localize "D6E2.Combat.Resistance"}}
      </span>
      <strong>
        {{resistanceContext.brawnScoreLabel}}
        {{#if resistanceContext.armorScore}}
          +
          {{resistanceContext.armorScoreLabel}}
          {{localize "D6E2.Item.Armor"}}
        {{/if}}
      </strong>
      {{#if resistanceContext.armorContributors.length}}
        <small>
          {{#each resistanceContext.armorContributors as |item|}}
            {{item.label}}
            +{{item.scoreLabel}}{{#unless @last}} · {{/unless}}
          {{/each}}
        </small>
      {{else}}
        <small>{{localize "D6E2.Combat.NoArmorContribution"}}</small>
      {{/if}}
    </section>
  {{/if}}

  <div class="od6chat-dice" aria-label="{{localize 'D6E2.Roll.DiceResults'}}">
    {{#each baseFaces as |face|}}
      <span>{{face}}</span>
    {{/each}}
    {{#each wildFaces as |face|}}
      <span class="is-wild" title="{{localize 'D6E2.Roll.WildDie'}}">
        <i class="fa-solid fa-burst" aria-hidden="true"></i>
        {{face}}
      </span>
    {{/each}}
    {{#if request.resultModifier}}
      <span class="is-modifier">{{request.resultModifier}}</span>
    {{/if}}
  </div>

  <div class="od6chat-total">
    <strong>{{result.total}}</strong>
    <span>{{localize "D6E2.Roll.Total"}}</span>
  </div>

  {{#if hasOpposition}}
    <p class="od6chat-status {{successClass}}">
      {{#if result.success}}
        {{localize "D6E2.Roll.Opposition.Won"}}
      {{else}}
        {{#if (eq opposition.winner "unresolved")}}
          {{localize "D6E2.Roll.Opposition.Unresolved"}}
        {{else}}
          {{localize "D6E2.Roll.Opposition.Lost"}}
        {{/if}}
      {{/if}}
      ·
      {{oppositionName}}
      {{opposition.opponentTotal}}
    </p>
  {{else if hasDifficulty}}
    <p class="od6chat-status {{successClass}}">
      {{#if result.success}}
        {{localize "D6E2.Roll.Success"}}
      {{else}}
        {{localize "D6E2.Roll.Failure"}}
      {{/if}}
      ·
      {{localize "D6E2.Roll.Difficulty"}}
      {{difficulty.difficulty}}
    </p>
  {{else}}
    <p class="od6chat-status">{{localize "D6E2.Roll.Unopposed"}}</p>
  {{/if}}

  {{#unless (eq result.wildOutcome "normal")}}
    <p class="od6chat-status is-explosion">
      <i class="fa-solid fa-burst" aria-hidden="true"></i>
      {{wildOutcomeLabel}}
    </p>
  {{/unless}}
  {{#if heroPointSpent}}
    <p class="od6chat-enhancement is-character-point">
      <i class="fa-solid fa-bolt" aria-hidden="true"></i>
      -{{heroPointSpent}}
      {{localize "D6E2.HeroPoints"}}
      {{#if heroPointReroll}}
        ·
        {{localize "D6E2.Roll.HeroPoint.Rerolled"}}
      {{/if}}
    </p>
  {{/if}}
  {{#if heroPointAward}}
    <p class="od6chat-enhancement is-awarded">
      <i class="fa-solid fa-bolt" aria-hidden="true"></i>
      +{{heroPointAward}}
      {{localize "D6E2.HeroPoints"}}
    </p>
  {{/if}}
  {{#if showRollFollowUps}}
    <div class="od6chat-actions">
      {{#if showHeroPointReroll}}
        <button type="button" data-action="heroPointReroll">
          <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
          {{localize "D6E2.Roll.HeroPoint.Reroll"}}
        </button>
      {{/if}}
      {{#if showDoublingDown}}
        <button type="button" data-action="doubleDown">
          <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
          {{localize "D6E2.Roll.DoublingDown.Action"}}
        </button>
      {{/if}}
    </div>
  {{/if}}
</article>