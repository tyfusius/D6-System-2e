<article class="od6chat-roll od6-theme-classic">
  <header>
    <img src="{{actor.img}}" alt="" />
    <div>
      <span>{{actor.name}}</span>
      <strong>{{request.label}}</strong>
    </div>
    <i class="fa-solid fa-cube" aria-hidden="true"></i>
  </header>

  <div class="od6chat-formula">
    {{result.pool.code.dice}}D{{#if
      result.pool.code.pips
    }}+{{result.pool.code.pips}}{{/if}}
  </div>

  <div class="od6chat-dice" aria-label="{{localize 'D6E2.Roll.DiceResults'}}">
    {{#each baseFaces as |face|}}
      <span>{{face}}</span>
    {{/each}}
    {{#each wildFaces as |face|}}
      <span class="is-wild" title="{{localize 'D6E2.Roll.WildDie'}}">
        <i class="fa-solid fa-burst" aria-hidden="true"></i>
        {{face}}
      </span>
    {{/each}}
    {{#if request.resultModifier}}
      <span class="is-modifier">{{request.resultModifier}}</span>
    {{/if}}
  </div>

  <div class="od6chat-total">
    <strong>{{result.total}}</strong>
    <span>{{localize "D6E2.Roll.Total"}}</span>
  </div>

  {{#if hasOpposition}}
    <p class="od6chat-status {{successClass}}">
      {{#if result.success}}
        {{localize "D6E2.Roll.Opposition.Won"}}
      {{else}}
        {{#if (eq opposition.winner "unresolved")}}
          {{localize "D6E2.Roll.Opposition.Unresolved"}}
        {{else}}
          {{localize "D6E2.Roll.Opposition.Lost"}}
        {{/if}}
      {{/if}}
      ·
      {{oppositionName}}
      {{opposition.opponentTotal}}
    </p>
  {{else if hasDifficulty}}
    <p class="od6chat-status {{successClass}}">
      {{#if result.success}}
        {{localize "D6E2.Roll.Success"}}
      {{else}}
        {{localize "D6E2.Roll.Failure"}}
      {{/if}}
      ·
      {{localize "D6E2.Roll.Difficulty"}}
      {{difficulty.difficulty}}
    </p>
  {{else}}
    <p class="od6chat-status">{{localize "D6E2.Roll.Unopposed"}}</p>
  {{/if}}

  {{#unless (eq result.wildOutcome "normal")}}
    <p class="od6chat-status is-explosion">
      <i class="fa-solid fa-burst" aria-hidden="true"></i>
      {{wildOutcomeLabel}}
    </p>
  {{/unless}}
  {{#if heroPointSpent}}
    <p class="od6chat-enhancement is-character-point">
      <i class="fa-solid fa-bolt" aria-hidden="true"></i>
      -{{heroPointSpent}}
      {{localize "D6E2.HeroPoints"}}
      {{#if heroPointReroll}}
        ·
        {{localize "D6E2.Roll.HeroPoint.Rerolled"}}
      {{/if}}
    </p>
  {{/if}}
  {{#if heroPointAward}}
    <p class="od6chat-enhancement is-awarded">
      <i class="fa-solid fa-bolt" aria-hidden="true"></i>
      +{{heroPointAward}}
      {{localize "D6E2.HeroPoints"}}
    </p>
  {{/if}}
  {{#if showHeroPointReroll}}
    <div class="od6chat-actions">
      <button type="button" data-action="heroPointReroll">
        <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
        {{localize "D6E2.Roll.HeroPoint.Reroll"}}
      </button>
    </div>
  {{/if}}
</article>