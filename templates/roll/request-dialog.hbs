<div class="od6-request-roll-shell">
  <header>
    <img src="{{actor.img}}" alt="" />
    <div>
      <p>{{localize "D6E2.RequestRoll.GmRequest"}}</p>
      <h2>{{label}}</h2>
      <span>{{actor.name}}</span>
    </div>
  </header>

  {{#if showRecipientChoice}}
    <label class="od6-request-roll-recipient">
      <span>{{localize "D6E2.RequestRoll.Player"}}</span>
      <select name="recipientUserId">
        {{#each recipients as |recipient|}}
          <option value="{{recipient.id}}">{{recipient.name}}</option>
        {{/each}}
      </select>
    </label>
  {{else}}
    <input name="recipientUserId" type="hidden" value="{{recipients.[0].id}}" />
    <p class="od6-request-roll-recipient-summary">
      <i class="fa-solid fa-user" aria-hidden="true"></i>
      {{localize "D6E2.RequestRoll.Player"}}
      <strong>{{recipients.[0].name}}</strong>
    </p>
  {{/if}}

  <fieldset class="od6-request-roll-visibility">
    <legend>{{localize "D6E2.RequestRoll.VisibilityPrompt"}}</legend>
    {{#each visibilityOptions as |option|}}
      <label>
        <input
          type="radio"
          name="visibility"
          value="{{option.value}}"
          {{checked option.selected}}
        />
        <span class="od6-request-roll-choice-icon">
          <i class="fa-solid {{option.icon}}" aria-hidden="true"></i>
        </span>
        <span>
          <strong>{{option.label}}</strong>
          <small>{{option.description}}</small>
        </span>
        <i
          class="fa-solid fa-check od6-request-roll-check"
          aria-hidden="true"
        ></i>
      </label>
    {{/each}}
  </fieldset>
</div>