<div
  class="od6roll-shell"
  data-base-score="{{baseScore}}"
  data-die-code-cap="{{dieCodeCap}}"
  data-fixed-pool-penalty-score="{{fixedPoolPenaltyScore}}"
>
  <header class="od6roll-identity">
    <img src="{{actor.img}}" alt="" />
    <div>
      <p>{{actor.name}}</p>
      <h2>{{label}}</h2>
      <span>{{localize "D6E2.Roll.ActionPool"}}</span>
    </div>
  </header>

  {{#if hasRollDescriptionRegion}}
    <p
      class="od6roll-description"
      data-roll-description
      data-base-description="{{rollDescription}}"
    >{{rollDescription}}</p>
  {{/if}}

  <div class="od6roll-preview">
    <div class="od6roll-preview-stat">
      <span>
        {{#if hasAdvancedSkillContexts}}
          {{localize "D6E2.Roll.BasePool"}}
        {{else}}
          {{localize "D6E2.Roll.FinalPool"}}
        {{/if}}
      </span>
      <strong class="od6roll-final-pool">
        <span
          class="od6roll-final-pool-value"
          data-roll-score
        >{{scoreLabel}}</span>
        {{#if showFinalPoolPenalty}}
          {{#if hasFinalPoolPenalty}}
            <small data-final-pool-penalty>({{finalPoolPenaltyLabel}})</small>
          {{else}}
            <small data-final-pool-penalty hidden></small>
          {{/if}}
        {{/if}}
      </strong>
    </div>
    <div class="od6roll-preview-stat">
      <span>{{localize "D6E2.Roll.FinalDifficulty"}}</span>
      <strong data-final-difficulty>{{finalDifficulty}}</strong>
    </div>
  </div>

  {{#if requestedRoll}}
    <section
      class="od6roll-requested"
      aria-label="{{localize 'D6E2.RequestRoll.Title'}}"
    >
      <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i>
      <div>
        <strong>{{localize "D6E2.RequestRoll.GmRequest"}}</strong>
        <span>
          {{localize "D6E2.RequestRoll.RequestedBy"}}
          {{requestedRoll.requesterName}}
        </span>
      </div>
      <em>{{requestedRoll.visibilityLabel}}</em>
    </section>
  {{/if}}

  {{#if targetContext.hasTargets}}
    <section
      class="od6roll-targeting"
      aria-label="{{targetContext.label}}"
      data-selected-target-id="{{targetContext.selectedTarget.id}}"
    >
      <div class="od6roll-target-preview">
        <span class="od6roll-target-portrait">
          <img data-target-image alt="" hidden />
          <i
            data-target-placeholder
            class="fa-solid fa-crosshairs"
            aria-hidden="true"
          ></i>
        </span>
        <span>
          <small>{{targetContext.label}}</small>
          <strong data-target-name>{{localize "D6E2.Combat.NoTarget"}}</strong>
          {{#if targetContext.showRange}}
            <em data-target-range hidden></em>
          {{/if}}
          {{#if targetContext.showDefense}}
            <em data-target-defense>{{localize
                "D6E2.Combat.TargetDefensePending"
              }}</em>
          {{/if}}
          <em data-target-scale hidden></em>
          {{#if targetContext.hasFixedDifficulty}}
            <em>
              {{targetContext.fixedDifficultyLabel}}
              {{targetContext.fixedDifficulty}}
            </em>
          {{/if}}
        </span>
      </div>
      <select
        name="targetId"
        aria-label="{{targetContext.label}}"
        data-base-score="{{targetContext.baseScore}}"
        data-fixed-difficulty="{{targetContext.hasFixedDifficulty}}"
        data-target-purpose="{{targetContext.purpose}}"
      >
        <option
          value=""
          data-name="{{localize 'D6E2.Combat.NoTarget'}}"
          data-image=""
        >{{localize "D6E2.Combat.NoTarget"}}</option>
        {{#each targetContext.targets as |target|}}
          <option
            value="{{target.id}}"
            data-actor-id="{{target.actorId}}"
            data-attack-kind="{{target.attackKind}}"
            data-defense="{{target.defense}}"
            data-defense-kind="{{target.defenseKind}}"
            data-defense-source-page="{{target.defenseSourcePage}}"
            data-defense-strategy="{{target.defenseStrategy}}"
            data-damage-scale-application="{{target.damageScale.application}}"
            data-damage-scale-family="{{target.damageScale.family}}"
            data-damage-scale-modifier="{{target.damageScale.modifierScore}}"
            data-damage-scale-resolved="{{target.damageScale.resolved}}"
            data-damage-scale-source-actor-id="{{target.damageScale.sourceActorId}}"
            data-damage-scale-source-name="{{target.damageScale.sourceName}}"
            data-damage-scale-source-page="{{target.damageScale.sourcePage}}"
            data-damage-scale-source-rank="{{target.damageScale.sourceRank}}"
            data-damage-scale-source-side="{{target.damageScale.sourceSide}}"
            data-damage-scale-source-token-id="{{target.damageScale.sourceTokenId}}"
            data-damage-scale-strategy-id="{{target.damageScale.strategyId}}"
            data-damage-scale-target-actor-id="{{target.damageScale.targetActorId}}"
            data-damage-scale-target-name="{{target.damageScale.targetName}}"
            data-damage-scale-target-rank="{{target.damageScale.targetRank}}"
            data-damage-scale-target-side="{{target.damageScale.targetSide}}"
            data-damage-scale-target-token-id="{{target.damageScale.targetTokenId}}"
            data-distance="{{target.distance}}"
            data-feint-penalty="{{target.feintPenalty}}"
            data-image="{{target.img}}"
            data-hidden="{{target.hidden}}"
            data-name="{{target.name}}"
            data-out-of-range="{{target.outOfRange}}"
            data-range-band="{{target.rangeBand}}"
            data-range-label="{{target.rangeLabel}}"
            data-scale-application="{{target.scale.application}}"
            data-scale-family="{{target.scale.family}}"
            data-scale-modifier="{{target.scale.modifierScore}}"
            data-scale-resolved="{{target.scale.resolved}}"
            data-scale-source-actor-id="{{target.scale.sourceActorId}}"
            data-scale-source-name="{{target.scale.sourceName}}"
            data-scale-source-page="{{target.scale.sourcePage}}"
            data-scale-source-token-id="{{target.scale.sourceTokenId}}"
            data-scale-strategy-id="{{target.scale.strategyId}}"
            data-scale-target-actor-id="{{target.scale.targetActorId}}"
            data-scale-target-name="{{target.scale.targetName}}"
            data-scale-target-token-id="{{target.scale.targetTokenId}}"
            data-srp-psyche="{{target.srp.psyche}}"
            data-srp-ready="{{target.srp.ready}}"
            data-srp-surprised="{{target.srp.surprised}}"
            data-vsm-mobile="{{target.vsm.mobile}}"
            data-vsm-static="{{target.vsm.static}}"
            data-source-scale="{{target.scale.sourceRank}}"
            data-source-scale-side="{{target.scale.sourceSide}}"
            data-target-scale="{{target.scale.targetRank}}"
            data-target-scale-side="{{target.scale.targetSide}}"
            data-weapon-id="{{target.weaponId}}"
          >{{target.optionLabel}}</option>
        {{/each}}
      </select>
      {{#if targetContext.showSrpMode}}
        <label class="od6roll-defense-mode" data-d6mv-srp-control>
          <span>{{localize "D6E2.Roll.D6MV.SrpMode"}}</span>
          <select name="d6mvSrpMode">
            <option value="ready">{{localize
                "D6E2.Roll.D6MV.Srp.Ready"
              }}</option>
            <option value="surprised">{{localize
                "D6E2.Roll.D6MV.Srp.Surprised"
              }}</option>
            <option value="psyche">{{localize
                "D6E2.Roll.D6MV.Srp.Psyche"
              }}</option>
          </select>
          <small>{{localize "D6E2.Roll.D6MV.SrpModeHelp"}}</small>
        </label>
      {{/if}}
      {{#if targetContext.showVsmMode}}
        <label class="od6roll-defense-mode" data-d6mv-vsm-control>
          <span>{{localize "D6E2.Roll.D6MV.VsmMode"}}</span>
          <select name="d6mvVsmMode">
            <option value="static">{{localize
                "D6E2.Roll.D6MV.Vsm.Static"
              }}</option>
            <option value="mobile">{{localize
                "D6E2.Roll.D6MV.Vsm.Mobile"
              }}</option>
          </select>
          <small>{{localize "D6E2.Roll.D6MV.VsmModeHelp"}}</small>
        </label>
      {{/if}}
      {{#if targetContext.showCoverModifier}}
        <label class="od6roll-cover-modifier">
          <span>{{localize "D6E2.Combat.Cover.Modifier"}}</span>
          <input
            type="number"
            name="coverDefenseModifier"
            value="0"
            min="0"
            step="1"
            inputmode="numeric"
          />
          <small>{{localize "D6E2.Combat.Cover.Help"}}</small>
        </label>
      {{/if}}
      {{#if targetContext.showTargetDodging}}
        <label
          class="od6roll-cover-modifier"
          data-target-dodging-control
          hidden
        >
          <span>{{localize "D6E2.Combat.NoDodge.TargetDodging"}}</span>
          <input name="targetDodging" type="checkbox" />
          <small>{{localize "D6E2.Combat.NoDodge.TargetDodgingHelp"}}</small>
        </label>
      {{/if}}
    </section>
  {{/if}}

  {{#if hasActionPenalty}}
    <p class="od6chat-context">
      <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
      {{localize "D6E2.Combat.RoundPenalty"}}
      ·
      {{actionPenaltyLabel}}
    </p>
  {{/if}}

  {{#if hasAutomaticResultModifier}}
    <p class="od6chat-context">
      <i
        class="fa-solid {{automaticResultModifierIcon}}"
        aria-hidden="true"
      ></i>
      {{automaticResultModifierLabel}}
      · +{{automaticResultModifier}}
    </p>
  {{/if}}

  {{#if hasAdvancedSkillContexts}}
    <fieldset class="od6roll-advanced-context">
      <legend>
        <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
        {{localize "D6E2.Roll.AdvancedContext.Label"}}
      </legend>
      <p>{{localize "D6E2.Roll.AdvancedContext.Help"}}</p>
      <label>
        <span>{{localize "D6E2.Roll.AdvancedContext.Task"}}</span>
        <select
          name="advancedSkillItemId"
          data-selected-item-id="{{selectedAdvancedSkillItemId}}"
        >
          <option value="">{{localize
              "D6E2.Roll.AdvancedContext.None"
            }}</option>
          {{#each dialogAdvancedSkillContexts as |advanced|}}
            <option
              value="{{advanced.itemId}}"
              data-description="{{advanced.description}}"
            >{{advanced.optionLabel}}</option>
          {{/each}}
        </select>
      </label>
      <small>{{localize "D6E2.RulesReference"}}: pp. 96–97</small>
    </fieldset>
  {{/if}}

  {{#if showOpenD6CharacterPoints}}
    <div class="od6roll-pool-resources">
      <div class="od6roll-pool-card od6roll-resource od6roll-character-points">
        <span class="od6roll-resource-heading">
          <i class="fa-solid fa-bolt" aria-hidden="true"></i>
          <span>{{characterPointLabel}}</span>
        </span>
        <small>
          {{characterPoints}}
          {{localize "D6E2.Roll.Available"}}
          ·
          {{localize "D6E2.Roll.OpenD6Resource.CharacterPointHelp"}}
          ·
          {{localize "D6E2.Roll.HeroPoint.Maximum"}}:
          {{characterPointLimit}}
        </small>
        <div class="od6roll-resource-stepper">
          <button
            type="button"
            data-character-point-step="-1"
            aria-label="{{localize
              'D6E2.Roll.OpenD6Resource.SpendFewerCharacterPoints'
            }}"
          >−</button>
          <output data-character-point-value aria-live="polite">0</output>
          <button
            type="button"
            data-character-point-step="1"
            aria-label="{{localize
              'D6E2.Roll.OpenD6Resource.SpendMoreCharacterPoints'
            }}"
          >+</button>
        </div>
        <input
          name="characterPointSpend"
          type="hidden"
          min="0"
          max="{{characterPointLimit}}"
          value="0"
        />
      </div>
    </div>
  {{/if}}

  {{#if showOpenD6FatePoint}}
    <div class="od6roll-pool-resources">
      {{#if fatePointActive}}
        <div class="od6roll-pool-card od6roll-resource od6roll-fate">
          <span class="od6roll-resource-heading">
            <i class="fa-solid fa-bolt" aria-hidden="true"></i>
            <span>{{fatePointLabel}}</span>
          </span>
          <small>
            {{localize "D6E2.Roll.OpenD6Resource.FatePointActive"}}
            ·
            <span data-roll-score>{{scoreLabel}}</span>
            →
            <span data-roll-doubled-score>{{doubledScoreLabel}}</span>
          </small>
        </div>
      {{else}}
        <label class="od6roll-pool-card od6roll-resource od6roll-fate">
          <input
            class="od6roll-checkbox-input"
            name="spendFatePoint"
            type="checkbox"
          />
          <span class="od6roll-resource-heading">
            <i class="fa-solid fa-bolt" aria-hidden="true"></i>
            <span>{{fatePointLabel}}</span>
          </span>
          <small>
            {{fatePoints}}
            {{localize "D6E2.Roll.Available"}}
            ·
            {{localize "D6E2.Roll.OpenD6Resource.FatePointHelp"}}
            ·
            <span data-roll-score>{{scoreLabel}}</span>
            →
            <span data-roll-doubled-score>{{doubledScoreLabel}}</span>
          </small>
          <span class="od6roll-checkbox-mark" aria-hidden="true"></span>
        </label>
      {{/if}}
    </div>
  {{/if}}

  {{#if showHeroPointDouble}}
    <div class="od6roll-pool-resources">
      <label class="od6roll-pool-card od6roll-resource od6roll-fate">
        <input
          class="od6roll-checkbox-input"
          name="doubleDieCode"
          type="checkbox"
        />
        <span class="od6roll-resource-heading">
          <i class="fa-solid fa-bolt" aria-hidden="true"></i>
          <span>{{localize "D6E2.HeroPoints"}}</span>
        </span>
        <small>
          {{heroPoints}}
          {{localize "D6E2.Roll.Available"}}
          ·
          {{#if hasAdvancedSkillContexts}}
            {{localize "D6E2.Roll.AdvancedContext.DoubleHelp"}}
          {{else}}
            <span data-roll-score>{{scoreLabel}}</span>
            →
            <span data-roll-doubled-score>{{doubledScoreLabel}}</span>
          {{/if}}
        </small>
        <span class="od6roll-checkbox-mark" aria-hidden="true"></span>
      </label>
    </div>
  {{/if}}

  {{#if showHeroPointDice}}
    <div class="od6roll-pool-resources">
      <div class="od6roll-pool-card od6roll-resource od6roll-character-points">
        <span class="od6roll-resource-heading">
          <i class="fa-solid fa-bolt" aria-hidden="true"></i>
          <span>{{localize "D6E2.HeroPoints"}}</span>
        </span>
        <small>
          {{heroPoints}}
          {{localize "D6E2.Roll.Available"}}
          ·
          {{#if heroPointDiceWild}}
            {{localize "D6E2.Roll.HeroPoint.ClassicHelp"}}
          {{else}}
            {{localize "D6E2.Roll.HeroPoint.BasicHelp"}}
          {{/if}}
          ·
          {{localize "D6E2.Roll.HeroPoint.Maximum"}}:
          {{heroPointLimit}}
        </small>
        <div class="od6roll-resource-stepper">
          <button
            type="button"
            data-hero-point-step="-1"
            aria-label="{{localize 'D6E2.Roll.HeroPoint.SpendFewer'}}"
          >−</button>
          <output data-hero-point-value aria-live="polite">0</output>
          <button
            type="button"
            data-hero-point-step="1"
            aria-label="{{localize 'D6E2.Roll.HeroPoint.SpendMore'}}"
          >+</button>
        </div>
        <input
          name="heroPointSpend"
          type="hidden"
          min="0"
          max="{{heroPointLimit}}"
          value="0"
        />
      </div>
    </div>
  {{/if}}

  {{#if showSuperheroicCapBypass}}
    <div class="od6roll-pool-resources">
      <label class="od6roll-pool-card od6roll-resource od6roll-fate">
        <input
          class="od6roll-checkbox-input"
          name="bypassDieCodeCap"
          type="checkbox"
        />
        <span class="od6roll-resource-heading">
          <i class="fa-solid fa-unlock" aria-hidden="true"></i>
          <span>{{localize "D6E2.Superheroic.BypassCap"}}</span>
        </span>
        <small>{{localize
            "D6E2.Superheroic.BypassCapHelp"
            cap=dieCodeCapDice
          }}</small>
        <span class="od6roll-checkbox-mark" aria-hidden="true"></span>
      </label>
    </div>
  {{/if}}

  {{#if hasDistinctionChoices}}
    <section class="od6roll-section-card od6roll-distinction-choices">
      <header class="od6roll-section-heading">
        <i class="fa-solid fa-route" aria-hidden="true"></i>
        <h3>{{localize "D6E2.Distinction.ContextualChoices"}}</h3>
        <p>{{localize "D6E2.Distinction.ContextualChoicesHelp"}}</p>
      </header>
      <div
        class="od6roll-section-grid"
        role="group"
        aria-label="{{localize 'D6E2.Distinction.ContextualChoices'}}"
      >
        {{#each distinctionChoices as |choice|}}
          <label class="od6roll-pool-card od6roll-distinction-choice">
            <input
              class="od6roll-checkbox-input"
              name="distinctionEffectIds"
              type="checkbox"
              value="{{choice.effectId}}"
              data-score="{{choice.score}}"
            />
            <span class="od6roll-resource-heading">
              <span>{{choice.label}}</span>
              <strong>{{choice.scoreLabel}}</strong>
            </span>
            <small>{{localize "D6E2.Distinction.ContextualChoiceHelp"}}</small>
            <span class="od6roll-checkbox-mark" aria-hidden="true"></span>
          </label>
        {{/each}}
      </div>
    </section>
  {{/if}}

  <div class="od6roll-options od6roll-primary-options">
    {{#if showMapControl}}
      <label class="od6roll-option-card od6roll-map-control">
        <span class="od6roll-control-label">{{localize
            "D6E2.Roll.Map.Label"
          }}</span>
        <span class="od6roll-compact-number od6roll-map-input">
          <input
            name="mapPenaltyDice"
            type="number"
            value="{{mapPenaltyDice}}"
            min="0"
            step="1"
          />
          <b>D</b>
        </span>
        <small>
          {{mapAssistanceLabel}}
          {{#if mapTrackedDice}}
            ·
            {{localize "D6E2.Roll.Map.Tracked"}}: −{{mapTrackedDice}}D
          {{/if}}
        </small>
      </label>
    {{/if}}
    {{#if hasFixedDifficulty}}
      <label class="od6roll-option-card od6roll-fixed-difficulty-card">
        <span class="od6roll-control-label">{{localize
            "D6E2.Roll.Difficulty"
          }}</span>
        <input
          name="difficulty"
          type="number"
          value="{{fixedDifficulty}}"
          data-difficulty-locked="true"
          hidden
        />
        <strong>{{fixedDifficulty}}</strong>
        <small>{{localize "D6E2.Roll.FixedDifficulty"}}</small>
      </label>
    {{else if showDifficultyControls}}
      <div
        class="od6roll-option-card od6roll-option-field od6roll-difficulty-field"
      >
        <label for="d6e2-roll-difficulty">{{localize
            "D6E2.Roll.Difficulty"
          }}</label>
        {{#if hasDifficultySuggestions}}
          <div class="od6roll-difficulty-combobox" data-difficulty-combobox>
            <input
              id="d6e2-roll-difficulty"
              name="difficulty"
              type="number"
              value="{{defaultDifficulty}}"
              data-target-difficulty-input
              data-difficulty-input
              step="1"
              inputmode="numeric"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="d6e2-difficulty-suggestions"
              aria-describedby="d6e2-difficulty-help"
              placeholder="{{localize 'D6E2.Roll.Optional'}}"
            />
            <button
              type="button"
              class="od6roll-difficulty-toggle"
              data-action="toggleDifficultySuggestions"
              aria-label="{{localize 'D6E2.Roll.DifficultySuggestionsToggle'}}"
              aria-expanded="false"
              aria-controls="d6e2-difficulty-suggestions"
            >
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div
              id="d6e2-difficulty-suggestions"
              class="od6roll-difficulty-listbox"
              role="listbox"
              aria-label="{{localize 'D6E2.Roll.DifficultySuggestionsLabel'}}"
              hidden
            >
              {{#each difficultySuggestions as |entry|}}
                <button
                  type="button"
                  id="d6e2-difficulty-suggestion-{{entry.id}}"
                  class="od6roll-difficulty-option"
                  role="option"
                  aria-selected="false"
                  data-difficulty-value="{{entry.value}}"
                >
                  <strong>{{entry.value}}</strong>
                  <span>{{entry.label}}</span>
                </button>
              {{/each}}
            </div>
          </div>
        {{else}}
          <input
            id="d6e2-roll-difficulty"
            name="difficulty"
            type="number"
            value="{{defaultDifficulty}}"
            data-target-difficulty-input
            step="1"
            inputmode="numeric"
            autocomplete="off"
            aria-describedby="d6e2-difficulty-help"
            placeholder="{{localize 'D6E2.Roll.Optional'}}"
          />
        {{/if}}
        <small id="d6e2-difficulty-help">{{localize
            "D6E2.Roll.DifficultySuggestionsHelp"
          }}</small>
      </div>
    {{else if targetContext.hasAuthoritativeTargetDifficulty}}
      <input
        name="difficulty"
        type="number"
        data-target-difficulty-input
        hidden
      />
    {{/if}}
    {{#if showModifierControls}}
      <label class="od6roll-option-card">
        <span class="od6roll-control-label">{{localize
            "D6E2.Roll.ManualDiceAdjustment"
          }}</span>
        <span class="od6roll-compact-number od6roll-dice-adjustment-input">
          <input
            name="manualDiceAdjustment"
            type="number"
            value="{{manualDiceAdjustment}}"
            min="-99"
            max="99"
            step="1"
          />
          <b>D</b>
        </span>
        <small>{{localize "D6E2.Roll.ManualDiceAdjustmentHelp"}}</small>
      </label>
      <label class="od6roll-option-card">
        <span class="od6roll-control-label">{{localize
            "D6E2.Roll.Modifier"
          }}</span>
        <span class="od6roll-compact-number od6roll-result-modifier-input">
          <input name="resultModifier" type="number" value="0" step="1" />
        </span>
      </label>
    {{/if}}
    {{#if rollModeLocked}}
      <label class="od6roll-option-card od6roll-visibility-locked">
        <span class="od6roll-control-label">{{localize
            "D6E2.Roll.ModeLabel"
          }}</span>
        <input
          name="rollMode"
          type="hidden"
          value="{{requestedRoll.rollMode}}"
        />
        <output>
          <i
            class="fa-solid {{requestedRoll.visibilityIcon}}"
            aria-hidden="true"
          ></i>
          {{requestedRoll.visibilityLabel}}
        </output>
      </label>
    {{else}}
      <label class="od6roll-option-card">
        <span class="od6roll-control-label">{{localize
            "D6E2.Roll.ModeLabel"
          }}</span>
        <select name="rollMode">
          {{#if publicRollSelected}}
            <option value="publicroll" selected>
              {{localize "D6E2.Roll.Mode.Public"}}
            </option>
          {{else}}
            <option value="publicroll">
              {{localize "D6E2.Roll.Mode.Public"}}
            </option>
          {{/if}}
          {{#if gmRollSelected}}
            <option value="gmroll" selected>
              {{localize "D6E2.Roll.Mode.Gm"}}
            </option>
          {{else}}
            <option value="gmroll">{{localize "D6E2.Roll.Mode.Gm"}}</option>
          {{/if}}
          {{#if blindRollSelected}}
            <option value="blindroll" selected>
              {{localize "D6E2.Roll.Mode.Blind"}}
            </option>
          {{else}}
            <option value="blindroll">
              {{localize "D6E2.Roll.Mode.Blind"}}
            </option>
          {{/if}}
          {{#if selfRollSelected}}
            <option value="selfroll" selected>
              {{localize "D6E2.Roll.Mode.Self"}}
            </option>
          {{else}}
            <option value="selfroll">
              {{localize "D6E2.Roll.Mode.Self"}}
            </option>
          {{/if}}
        </select>
      </label>
    {{/if}}
  </div>

  {{#if showOppositionControls}}
    <fieldset class="od6roll-opposition">
      <legend>
        <i class="fa-solid fa-people-arrows-left-right" aria-hidden="true"></i>
        {{localize "D6E2.Roll.Opposition.Label"}}
      </legend>
      <p>{{localize "D6E2.Roll.Opposition.Help"}}</p>
      <div class="od6roll-options">
        <label>
          <span>{{localize "D6E2.Roll.Opposition.Name"}}</span>
          <input
            name="oppositionName"
            type="text"
            placeholder="{{localize 'D6E2.Roll.Opposition.DefaultName'}}"
          />
        </label>
        <label>
          <span>{{localize "D6E2.Roll.Opposition.Total"}}</span>
          <input
            name="oppositionTotal"
            type="number"
            step="1"
            placeholder="{{localize 'D6E2.Roll.Optional'}}"
          />
        </label>
        <label>
          <span>{{localize "D6E2.Roll.Opposition.ActorKind"}}</span>
          <select name="actorKind">
            <option value="player-character" selected>
              {{localize "D6E2.Roll.Participant.Player"}}
            </option>
            <option value="non-player-character">
              {{localize "D6E2.Roll.Participant.NonPlayer"}}
            </option>
          </select>
        </label>
        <label>
          <span>{{localize "D6E2.Roll.Opposition.OpponentKind"}}</span>
          <select name="opponentKind">
            <option value="non-player-character" selected>
              {{localize "D6E2.Roll.Participant.NonPlayer"}}
            </option>
            <option value="player-character">
              {{localize "D6E2.Roll.Participant.Player"}}
            </option>
          </select>
        </label>
        <label>
          <span>{{localize "D6E2.Roll.Opposition.WildDie"}}</span>
          <input
            name="oppositionWildDie"
            type="number"
            min="1"
            max="6"
            step="1"
            placeholder="{{localize 'D6E2.Roll.Optional'}}"
          />
        </label>
      </div>
    </fieldset>
  {{/if}}
</div>