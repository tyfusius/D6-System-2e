<article class="od6chat-roll d6e2-magic-point-cast">
  <header class="od6chat-header">
    <img src="{{actor.img}}" alt="" />
    <div>
      <span>{{actor.name}}</span>
      <h3>{{manifestation.name}}</h3>
    </div>
  </header>
  <section class="od6chat-context">
    <strong>{{localize "D6E2.Magic.MagicPointsCasting"}}</strong>
    <span>{{schoolLabel}}</span>
    <span>{{localize "D6E2.Magic.Difficulty"}} {{difficulty}}</span>
    <span>{{localize "D6E2.Magic.Cost"}} {{cost}}</span>
    <span>{{localize "D6E2.Magic.Remaining"}} {{remaining}} / {{maximum}}</span>
    <small>{{localize "D6E2.Magic.MagicPointsReference"}}</small>
    <dl class="od6chat-result-details">
      <div><dt>{{localize "D6E2.Magic.Target.Label"}}</dt><dd
        >{{targetLabel}}</dd></div>
      <div><dt>{{localize "D6E2.Magic.Range.Label"}}</dt><dd
        >{{rangeLabel}}</dd></div>
      <div><dt>{{localize "D6E2.Magic.Duration.Label"}}</dt><dd
        >{{durationLabel}}</dd></div>
      <div><dt>{{localize "D6E2.Magic.CastingTime.Label"}}</dt><dd
        >{{castingTimeLabel}}</dd></div>
      <div><dt>{{localize "D6E2.Magic.Resistance.Label"}}</dt><dd
        >{{resistanceLabel}}</dd></div>
    </dl>
  </section>
  <section class="od6chat-outcome is-success">
    <strong>{{localize "D6E2.Magic.AutomaticSuccess"}}</strong>
    <small>{{localize "D6E2.Magic.ResolveEffect"}}</small>
  </section>
</article>