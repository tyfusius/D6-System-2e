        {
          "name": "Knife",
          "type": "weapon",
          "system": {
            "attackAttributeId": "agility",
            "attackSkillKey": "melee",
            "damage": 3,
            "damageType": "Physical",
            "description": "Damage is Brawn +1D. Add Brawn when resolving damage."
          }
        },
        {
          "name": "Fairy Flight",
          "type": "specialability",
          "system": {
            "description": "Can fly and glide in forested areas; outside them it normally walks."
          }
        },
        {
          "name": "Optional Fairy Magic",
          "type": "specialability",
          "system": {
            "description": "A spellcaster variant uses Magic Points Casting with 10 Magic Points. Enable and assign this option only for a spellcaster."
          }
        }
      ]
